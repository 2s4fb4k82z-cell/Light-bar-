// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  NanoSerial.begin(NANO_BAUD);


  // DISPLAY

  display.begin();

  display.setRotation(1);

  display.fillScreen(COLOR_BLACK);


  // TOUCH

  if (!touch.begin()) {

    Serial.println(
      "GIGA Display touch initialization FAILED"
    );

  }

  else {

    Serial.println(
      "GIGA Display touch initialized"
    );

  }


  // INITIALIZE LIGHTBAR STATE

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    lightbar[i].physical = false;
    lightbar[i].giga = false;
    lightbar[i].effective = false;
    lightbar[i].megaConfirmed = false;
    lightbar[i].startupHold = false;

    lightbar[i].failed = false;

    lightbar[i].failureReason[0] = '\0';

    lightbar[i].nanoAckPending = false;
    lightbar[i].pendingStart = false;

    lightbar[i].nanoRetries = 0;

    lightbar[i].commandSentAt = 0;

    lightbar[i].waitingForConfirmation = false;

  }


  // ENGINE DATA

  engineData.ipr = 0;
  engineData.icp = 0;

  iprGauge.filteredValue = 0;
  iprGauge.displayedValue = 0;

  icpGauge.filteredValue = 0;
  icpGauge.displayedValue = 0;


  // INITIAL SCREEN

  currentScreen = SCREEN_GAUGES;

  drawCurrentScreen();


  // COMMUNICATION

  sendPing();

  requestSync();

}


// ============================================================
// LOOP
// ============================================================

void loop() {

  processNanoSerial();

  updateCommunicationWatchdogs();

  updateTruckDataWatchdog();

  updateCommandRetries();


  // GIGA -> NANO HEARTBEAT

  if (
    millis() - lastPingSent >=
    GIGA_PING_INTERVAL
  ) {

    sendPing();

  }


  // FLASH TIMING

  if (
    millis() - lastFlashTime >=
    FLASH_INTERVAL
  ) {

    lastFlashTime = millis();

    flashState = !flashState;


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      updateLightbarButtons();

    }


    drawAlarmBorder();

  }


  // TOUCH

  processTouch();


  // ENGINE DATA

  updateEngineData();


  // GAUGE UPDATE

  if (
    currentScreen == SCREEN_GAUGES &&

    millis() -
      lastGaugeUpdate >=
      GAUGE_UPDATE_INTERVAL
  ) {

    lastGaugeUpdate = millis();

    updateGaugeScreenDynamic(false);

  }


  // SERIAL MONITOR

  if (
    currentScreen == SCREEN_SERIAL &&

    serialScreenDirty &&

    millis() -
      lastSerialRedraw >=
      SERIAL_REDRAW_INTERVAL
  ) {

    lastSerialRedraw = millis();

    drawSerialScreen();

    serialScreenDirty = false;

  }

}


// ============================================================
// SCREEN CHANGE
// ============================================================

void changeScreen(
  ScreenType newScreen
) {

  if (
    currentScreen == newScreen
  ) {

    return;

  }


  currentScreen = newScreen;


  /*
     Require a complete finger release before another
     Lightbar gesture can begin.
  */

  lightbarGestureTracking = false;
  lightbarGestureTriggered = true;


  if (
    newScreen == SCREEN_GAUGES
  ) {

    iprGauge.lastNeedleValue = -9999;
    icpGauge.lastNeedleValue = -9999;

    iprGauge.lastDigitalValue = -9999;
    icpGauge.lastDigitalValue = -9999;

  }


  drawCurrentScreen();

}


// ============================================================
// DRAW CURRENT SCREEN
// ============================================================

void drawCurrentScreen() {

  display.fillScreen(
    COLOR_BLACK
  );


  if (
    currentScreen == SCREEN_GAUGES
  ) {

    drawGaugeScreenStatic();

    updateGaugeScreenDynamic(true);

  }


  else if (
    currentScreen == SCREEN_LIGHTBAR
  ) {

    drawLightbarScreen();

  }


  else if (
    currentScreen == SCREEN_SERIAL
  ) {

    drawSerialScreen();

  }


  drawAlarmBorder();

}


