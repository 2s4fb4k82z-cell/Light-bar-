// ============================================================
// BEGIN GIGA COMMAND
// ============================================================

void beginGigaCommand(
  int command
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;

  }


  LightbarState &state =
    lightbar[command];


  if (
    state.nanoAckPending ||
    state.waitingForConfirmation
  ) {

    return;

  }


  bool desiredStart =
    !state.giga;


  state.failed = false;

  state.failureReason[0] =
    '\0';


  state.pendingStart =
    desiredStart;


  state.nanoRetries = 0;


  state.nanoAckPending =
    true;


  state.waitingForConfirmation =
    false;


  sendGigaCommand(
    command,
    desiredStart
  );

}


// ============================================================
// SEND START / STOP
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  char buffer[80];


  snprintf(
    buffer,
    sizeof(buffer),
    "%s %s",
    start
      ?
    "START"
      :
    "STOP",
    commandNames[command]
  );


  sendToNano(
    buffer
  );


  lightbar[
    command
  ].commandSentAt = millis();

}


// ============================================================
// COMMAND RETRIES
// ============================================================

void updateCommandRetries() {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &state =
      lightbar[i];


    if (
      !state.nanoAckPending
    ) {

      continue;

    }


    if (
      millis() -
      state.commandSentAt <
      COMMAND_ACK_TIMEOUT
    ) {

      continue;

    }


    if (
      state.nanoRetries <
      MAX_NANO_RETRIES
    ) {

      state.nanoRetries++;


      sendGigaCommand(
        i,
        state.pendingStart
      );


      char diagnostic[100];


      snprintf(
        diagnostic,
        sizeof(diagnostic),
        "RETRY %d %s %s",
        state.nanoRetries,
        state.pendingStart
          ?
        "START"
          :
        "STOP",
        commandNames[i]
      );


      addSerialLog(
        "ERR",
        diagnostic
      );

    }


    else {

      state.nanoAckPending =
        false;


      state.waitingForConfirmation =
        false;


      state.failed =
        true;


      strncpy(
        state.failureReason,
        "NANO_NO_ACK",
        sizeof(
          state.failureReason
        ) - 1
      );


      state.failureReason[
        sizeof(
          state.failureReason
        ) - 1
      ] = '\0';


      char diagnostic[100];


      snprintf(
        diagnostic,
        sizeof(diagnostic),
        "NANO_NO_ACK %s",
        commandNames[i]
      );


      addSerialLog(
        "ERR",
        diagnostic
      );


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        updateLightbarButtons();

      }

    }

  }

}


// ============================================================
// NANO SERIAL RECEIVE
// ============================================================

void processNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;

    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex = 0;

      }

    }


    else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;

      }


      else {

        nanoRxIndex = 0;


        addSerialLog(
          "ERR",
          "NANO RX OVERFLOW"
        );

      }

    }

  }

}


// ============================================================
// PROCESS NANO LINE
// ============================================================

void processNanoLine(
  char *line
) {

  lastNanoReceive =
    millis();


  addSerialLog(
    "N>G",
    line
  );


  if (
    nanoLinkLost
  ) {

    nanoLinkLost =
      false;


    addSerialLog(
      "N>G",
      "NANO LINK RESTORED"
    );

  }


  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    return;

  }


  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    for (
      int i = 0;
      i < NUM_COMMANDS;
      i++
    ) {

      lightbar[i].nanoAckPending =
        false;

      lightbar[i].waitingForConfirmation =
        false;

      lightbar[i].failed =
        false;

    }


    requestSync();

    return;

  }


  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    megaLinkLost = true;

    return;

  }


  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    megaLinkLost = false;

    return;

  }


  if (
    strcmp(
      line,
      "MEGA_REBOOTED"
    ) == 0
  ) {

    megaLinkLost = true;

    return;

  }


  if (
    strcmp(
      line,
      "MEGA_FAILSAFE"
    ) == 0
  ) {

    megaLinkLost = true;

    return;

  }


  if (
    strcmp(
      line,
      "MEGA_RECOVERED"
    ) == 0
  ) {

    megaLinkLost = false;

    return;

  }


  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    parseState(line);

    return;

  }


  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    parseAck(line);

    return;

  }


  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    parseConfirmed(line);

    return;

  }


  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    parseFailed(line);

    return;

  }

}


// ============================================================
// PARSE STATE
// ============================================================

void parseState(
  char *line
) {

  char commandName[32];

  int p = 0;
  int g = 0;
  int e = 0;
  int m = 0;
  int h = 0;


  int result =
    sscanf(
      line,
      "STATE %31s P=%d G=%d E=%d M=%d H=%d",
      commandName,
      &p,
      &g,
      &e,
      &m,
      &h
    );


  if (
    result != 6
  ) {

    return;

  }


  int command =
    findCommand(
      commandName
    );


  if (
    command < 0
  ) {

    return;

  }


  lightbar[
    command
  ].physical = p != 0;


  lightbar[
    command
  ].giga = g != 0;


  lightbar[
    command
  ].effective = e != 0;


  lightbar[
    command
  ].megaConfirmed = m != 0;


  lightbar[
    command
  ].startupHold = h != 0;


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    updateLightbarButtons();

  }

}


// ============================================================
// PARSE ACK
// ============================================================

void parseAck(
  char *line
) {

  char action[16];
  char commandName[32];


  if (
    sscanf(
      line,
      "ACK %15s %31s",
      action,
      commandName
    ) != 2
  ) {

    return;

  }


  int command =
    findCommand(
      commandName
    );


  if (
    command < 0
  ) {

    return;

  }


  bool start =
    strcasecmp(
      action,
      "START"
    ) == 0;


  LightbarState &state =
    lightbar[command];


  if (
    state.nanoAckPending &&
    state.pendingStart ==
      start
  ) {

    state.nanoAckPending =
      false;


    state.waitingForConfirmation =
      true;

  }

}


// ============================================================
// PARSE CONFIRMED
// ============================================================

void parseConfirmed(
  char *line
) {

  char action[16];
  char commandName[32];


  if (
    sscanf(
      line,
      "CONFIRMED %15s %31s",
      action,
      commandName
    ) != 2
  ) {

    return;

  }


  int command =
    findCommand(
      commandName
    );


  if (
    command < 0
  ) {

    return;

  }


  bool start =
    strcasecmp(
      action,
      "START"
    ) == 0;


  LightbarState &state =
    lightbar[command];


  state.nanoAckPending =
    false;


  state.waitingForConfirmation =
    false;


  state.failed =
    false;


  state.failureReason[0] =
    '\0';


  state.giga =
    start;


  state.megaConfirmed =
    start;


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    updateLightbarButtons();

  }

}


// ============================================================
// PARSE FAILED
// ============================================================

void parseFailed(
  char *line
) {

  char action[16];
  char commandName[32];
  char reason[32];


  if (
    sscanf(
      line,
      "FAILED %15s %31s %31s",
      action,
      commandName,
      reason
    ) < 3
  ) {

    return;

  }


  int command =
    findCommand(
      commandName
    );


  if (
    command < 0
  ) {

    return;

  }


  LightbarState &state =
    lightbar[command];


  state.nanoAckPending =
    false;


  state.waitingForConfirmation =
    false;


  state.failed =
    true;


  strncpy(
    state.failureReason,
    reason,
    sizeof(
      state.failureReason
    ) - 1
  );


  state.failureReason[
    sizeof(
      state.failureReason
    ) - 1
  ] = '\0';


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    updateLightbarButtons();

  }

}


// ============================================================
// FIND COMMAND
// ============================================================

int findCommand(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;

    }

  }


  return -1;

}


// ============================================================
// COMMUNICATION WATCHDOG
// ============================================================

void updateCommunicationWatchdogs() {

  if (
    lastNanoReceive > 0 &&

    millis() -
      lastNanoReceive >
      NANO_TIMEOUT
  ) {

    if (
      !nanoLinkLost
    ) {

      nanoLinkLost =
        true;


      addSerialLog(
        "ERR",
        "NANO LINK LOST"
      );


      for (
        int i = 0;
        i < NUM_COMMANDS;
        i++
      ) {

        if (
          lightbar[i].nanoAckPending ||
          lightbar[i].waitingForConfirmation
        ) {

          lightbar[i].nanoAckPending =
            false;


          lightbar[i].waitingForConfirmation =
            false;


          lightbar[i].failed =
            true;


          strncpy(
            lightbar[i].failureReason,
            "NANO_LINK_LOST",
            sizeof(
              lightbar[i].failureReason
            ) - 1
          );


          lightbar[i].failureReason[
            sizeof(
              lightbar[i].failureReason
            ) - 1
          ] = '\0';

        }

      }

    }

  }

}


// ============================================================
// TRUCK DATA WATCHDOG
// ============================================================

void updateTruckDataWatchdog() {

  if (
    simulateEngineData
  ) {

    truckDataTimedOut =
      true;

    return;

  }


  if (
    lastTruckDataReceived == 0
  ) {

    truckDataTimedOut =
      true;

    return;

  }


  if (
    millis() -
      lastTruckDataReceived >
      TRUCK_DATA_TIMEOUT
  ) {

    truckDataTimedOut =
      true;

  }

}


// ============================================================
// SERIAL LOG
// ============================================================

void addSerialLog(
  const char *direction,
  const char *message
) {

  SerialLogEntry &entry =
    serialLog[
      serialLogHead
    ];


  entry.timestamp =
    millis();


  strncpy(
    entry.direction,
    direction,
    sizeof(
      entry.direction
    ) - 1
  );


  entry.direction[
    sizeof(
      entry.direction
    ) - 1
  ] = '\0';


  strncpy(
    entry.message,
    message,
    sizeof(
      entry.message
    ) - 1
  );


  entry.message[
    sizeof(
      entry.message
    ) - 1
  ] = '\0';


  serialLogHead =
    (
      serialLogHead +
      1
    )
    %
    SERIAL_LOG_SIZE;


  if (
    serialLogCount <
    SERIAL_LOG_SIZE
  ) {

    serialLogCount++;

  }


  serialScreenDirty =
    true;

}


// ============================================================
// SIMULATED ENGINE DATA
// ============================================================

void updateEngineData() {

  if (
    !simulateEngineData
  ) {

    return;

  }


  float t =
    millis() /
    1000.0;


  engineData.ipr =
    35.0 +
    sin(
      t * 0.7
    ) *
    15.0 +
    sin(
      t * 2.3
    ) *
    2.0;


  engineData.icp =
    1800.0 +
    sin(
      t * 0.45
    ) *
    850.0 +
    sin(
      t * 1.8
    ) *
    100.0;


  if (
    engineData.ipr < 0
  ) {

    engineData.ipr = 0;

  }


  if (
    engineData.ipr > 100
  ) {

    engineData.ipr = 100;

  }


  if (
    engineData.icp < 0
  ) {

    engineData.icp = 0;

  }


  if (
    engineData.icp > 4000
  ) {

    engineData.icp = 4000;

  }

}


// ============================================================
// TOUCH MAPPING
//
// IMPORTANT:
//
// This remains isolated because the physical Display Shield
// may require adjustment after testing.
// ============================================================

void mapTouchPoint(
  const GDTpoint_t &raw,
  int &x,
  int &y
) {

  x = raw.y;

  y = 479 - raw.x;

}


// ============================================================
// GESTURE START ZONE
// ============================================================

bool pointInGestureZone(
  int x,
  int y
) {

  return (
    x >= GESTURE_ZONE_X_MIN &&
    x <= GESTURE_ZONE_X_MAX &&
    y >= GESTURE_ZONE_Y_MIN &&
    y <= GESTURE_ZONE_Y_MAX
  );

}


// ============================================================
// PROCESS TOUCH
// ============================================================

void processTouch() {

  GDTpoint_t points[5];


  uint8_t contacts =
    touch.getTouchPoints(
      points
    );


  bool touchActive =
    contacts > 0;


  // ==========================================================
  // NO FINGERS
  //
  // Fully reset the gesture detector.
  // ==========================================================

  if (
    contacts == 0
  ) {

    lightbarGestureTracking =
      false;


    lightbarGestureTriggered =
      false;


    previousTouchActive =
      false;


    return;

  }


  // ==========================================================
  // HIDDEN LIGHTBAR GESTURE
  //
  // ONLY AVAILABLE FROM GAUGE SCREEN.
  // ==========================================================

  if (
    currentScreen == SCREEN_GAUGES &&
    contacts >= 2
  ) {

    int x1;
    int y1;

    int x2;
    int y2;


    mapTouchPoint(
      points[0],
      x1,
      y1
    );


    mapTouchPoint(
      points[1],
      x2,
      y2
    );


    // --------------------------------------------------------
    // START TRACKING
    //
    // Both fingers simply need to start somewhere in the
    // broad gauge region.
    // --------------------------------------------------------

    if (
      !lightbarGestureTracking &&
      !lightbarGestureTriggered
    ) {

      bool finger1Valid =
        pointInGestureZone(
          x1,
          y1
        );


      bool finger2Valid =
        pointInGestureZone(
          x2,
          y2
        );


      if (
        finger1Valid &&
        finger2Valid
      ) {

        lightbarGestureTracking =
          true;


        lightbarStartY1 =
          y1;


        lightbarStartY2 =
          y2;

      }

    }


    // --------------------------------------------------------
    // TRACK DOWNWARD MOVEMENT
    // --------------------------------------------------------

    else if (
      lightbarGestureTracking &&
      !lightbarGestureTriggered
    ) {

      int down1 =
        y1 -
        lightbarStartY1;


      int down2 =
        y2 -
        lightbarStartY2;


      float averageDown =
        (
          down1 +
          down2
        )
        /
        2.0;


      /*
         Average downward movement is the main requirement.

         Also require that neither finger has moved strongly
         upward. One finger may move much less than the other.
      */

      bool fingerDirectionsOkay =
        (
          down1 > -20 &&
          down2 > -20
        );


      if (
        averageDown >=
          LIGHTBAR_GESTURE_MIN_DOWN &&

        fingerDirectionsOkay
      ) {

        lightbarGestureTriggered =
          true;


        lightbarGestureTracking =
          false;


        changeScreen(
          SCREEN_LIGHTBAR
        );


        previousTouchActive =
          true;


        return;

      }

    }


    /*
       While two fingers are down on the Gauge screen,
       don't process them as normal button touches.
    */

    previousTouchActive =
      true;

    return;

  }


  // ==========================================================
  // SINGLE-FINGER BUTTON TOUCH
  // ==========================================================

  if (
    contacts == 1 &&

    !previousTouchActive &&

    millis() -
      lastTouchAction >
      TOUCH_DEBOUNCE
  ) {

    int x;
    int y;


    mapTouchPoint(
      points[0],
      x,
      y
    );


    // ========================================================
    // LIGHTBAR BUTTONS
    // ========================================================

    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      for (
        int i = 0;
        i <
          NUM_LIGHTBAR_BUTTONS;
        i++
      ) {

        TouchButton &button =
          lightbarButtons[i];


        if (
          pointInRect(
            x,
            y,
            button.x,
            button.y,
            button.w,
            button.h
          )
        ) {

          lastTouchAction =
            millis();


          // CLOSE

          if (
            button.isClose
          ) {

            changeScreen(
              SCREEN_GAUGES
            );

          }


          // MONITOR

          else if (
            button.isMonitor
          ) {

            serialScreenDirty =
              true;


            changeScreen(
              SCREEN_SERIAL
            );

          }


          // NORMAL COMMAND

          else {

            beginGigaCommand(
              button.command
            );

          }


          break;

        }

      }

    }


    // ========================================================
    // SERIAL CLOSE X
    // ========================================================

    else if (
      currentScreen ==
      SCREEN_SERIAL
    ) {

      if (
        pointInRect(
          x,
          y,
          SERIAL_CLOSE_X,
          SERIAL_CLOSE_Y,
          SERIAL_CLOSE_W,
          SERIAL_CLOSE_H
        )
      ) {

        lastTouchAction =
          millis();


        changeScreen(
          SCREEN_GAUGES
        );

      }

    }

  }


  previousTouchActive =
    touchActive;

}


// ============================================================
// POINT IN RECTANGLE
// ============================================================

bool pointInRect(
  int px,
  int py,
  int x,
  int y,
  int w,
  int h
) {

  return (
    px >= x &&
    px < x + w &&
    py >= y &&
    py < y + h
  );

}
