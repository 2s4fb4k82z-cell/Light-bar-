// ============================================================
// VALUE -> GAUGE ANGLE
// ============================================================

float valueToAngle(
  float value,
  float minValue,
  float maxValue
) {

  float normalized =
    (
      value -
      minValue
    ) /
    (
      maxValue -
      minValue
    );


  if (
    normalized < 0
  ) {

    normalized = 0;

  }


  if (
    normalized > 1
  ) {

    normalized = 1;

  }


  return
    135.0 +
    (
      normalized *
      270.0
    );

}


