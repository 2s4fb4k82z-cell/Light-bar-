// ============================================================
// DRAW STATIC GAUGE
// ============================================================

void drawGaugeStatic(
  Gauge &gauge,
  int majorStep
) {

  // OUTER RINGS

  display.drawCircle(
    gauge.cx,
    gauge.cy,
    gauge.radius,
    COLOR_OBS_GREEN
  );


  display.drawCircle(
    gauge.cx,
    gauge.cy,
    gauge.radius - 1,
    COLOR_OBS_GREEN
  );


  display.drawCircle(
    gauge.cx,
    gauge.cy,
    gauge.radius - 8,
    COLOR_OBS_GREEN
  );


  // ==========================================================
  // TICKS / SCALE NUMBERS
  // ==========================================================

  int numberOfTicks =
    (int)(
      (
        gauge.maxValue -
        gauge.minValue
      ) /
      majorStep
    );


  for (
    int i = 0;
    i <= numberOfTicks;
    i++
  ) {

    float value =
      gauge.minValue +
      (
        i *
        majorStep
      );


    float angle =
      valueToAngle(
        value,
        gauge.minValue,
        gauge.maxValue
      );


    float radians =
      angle *
      DEG_TO_RAD;


    int x1 =
      gauge.cx +
      cos(radians) *
      (
        gauge.radius -
        18
      );


    int y1 =
      gauge.cy +
      sin(radians) *
      (
        gauge.radius -
        18
      );


    int x2 =
      gauge.cx +
      cos(radians) *
      (
        gauge.radius -
        5
      );


    int y2 =
      gauge.cy +
      sin(radians) *
      (
        gauge.radius -
        5
      );


    display.drawLine(
      x1,
      y1,
      x2,
      y2,
      COLOR_OBS_GREEN
    );


    // SCALE NUMBER

    int labelRadius =
      gauge.radius -
      38;


    int tx =
      gauge.cx +
      cos(radians) *
      labelRadius;


    int ty =
      gauge.cy +
      sin(radians) *
      labelRadius;


    char numberBuffer[12];


    snprintf(
      numberBuffer,
      sizeof(numberBuffer),
      "%d",
      (int)value
    );


    int16_t xBounds;
    int16_t yBounds;

    uint16_t textW;
    uint16_t textH;


    display.setTextSize(1);


    display.getTextBounds(
      numberBuffer,
      0,
      0,
      &xBounds,
      &yBounds,
      &textW,
      &textH
    );


    display.setTextColor(
      COLOR_OBS_GREEN
    );


    display.setCursor(
      tx - textW / 2,
      ty - textH / 2
    );


    display.print(
      numberBuffer
    );

  }


  // ==========================================================
  // UNIT INSIDE GAUGE
  // ==========================================================

  display.setTextSize(2);

  display.setTextColor(
    COLOR_OBS_GREEN
  );


  int16_t xBounds;
  int16_t yBounds;

  uint16_t textW;
  uint16_t textH;


  display.getTextBounds(
    gauge.unit,
    0,
    0,
    &xBounds,
    &yBounds,
    &textW,
    &textH
  );


  display.setCursor(
    gauge.cx - textW / 2,
    gauge.cy + 72
  );


  display.print(
    gauge.unit
  );


  // CENTER HUB

  display.fillCircle(
    gauge.cx,
    gauge.cy,
    8,
    COLOR_OBS_GREEN
  );

}


