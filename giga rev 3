// ============================================================
// UPDATE ONE GAUGE
// ============================================================

void updateGaugeDynamic(
  Gauge &gauge,
  float rawValue,
  float needleDeadband,
  bool force
) {

  // CLAMP

  if (
    rawValue < gauge.minValue
  ) {

    rawValue =
      gauge.minValue;

  }


  if (
    rawValue > gauge.maxValue
  ) {

    rawValue =
      gauge.maxValue;

  }


  // SMOOTH

  gauge.filteredValue +=
    (
      rawValue -
      gauge.filteredValue
    ) *
    GAUGE_SMOOTHING;


  bool needleChanged = false;


  if (
    force ||

    gauge.lastNeedleValue < -1000 ||

    fabs(
      gauge.filteredValue -
      gauge.displayedValue
    ) >= needleDeadband
  ) {

    gauge.displayedValue =
      gauge.filteredValue;

    needleChanged = true;

  }


  if (
    needleChanged
  ) {

    // ERASE OLD NEEDLE

    if (
      gauge.lastNeedleValue > -1000
    ) {

      drawNeedle(
        gauge,
        gauge.lastNeedleValue,
        COLOR_BLACK
      );

    }


    // CLEAN HUB

    display.fillCircle(
      gauge.cx,
      gauge.cy,
      10,
      COLOR_BLACK
    );


    // DRAW RED NEEDLE

    drawNeedle(
      gauge,
      gauge.displayedValue,
      COLOR_RED
    );


    // RESTORE GREEN HUB

    display.fillCircle(
      gauge.cx,
      gauge.cy,
      8,
      COLOR_OBS_GREEN
    );


    gauge.lastNeedleValue =
      gauge.displayedValue;

  }


  // DIGITAL VALUE

  int digitalValue =
    (int)
    round(
      rawValue
    );


  if (
    force ||

    digitalValue !=
      gauge.lastDigitalValue
  ) {

    drawDigitalValue(
      gauge,
      digitalValue
    );


    gauge.lastDigitalValue =
      digitalValue;

  }

}


// ============================================================
// DRAW NEEDLE
// ============================================================

void drawNeedle(
  Gauge &gauge,
  float value,
  uint16_t color
) {

  float angle =
    valueToAngle(
      value,
      gauge.minValue,
      gauge.maxValue
    );


  float radians =
    angle *
    DEG_TO_RAD;


  int needleLength =
    gauge.radius -
    48;


  int x =
    gauge.cx +
    cos(radians) *
    needleLength;


  int y =
    gauge.cy +
    sin(radians) *
    needleLength;


  display.drawLine(
    gauge.cx,
    gauge.cy,
    x,
    y,
    color
  );


  display.drawLine(
    gauge.cx + 1,
    gauge.cy,
    x + 1,
    y,
    color
  );


  display.drawLine(
    gauge.cx,
    gauge.cy + 1,
    x,
    y + 1,
    color
  );

}


// ============================================================
// DIGITAL VALUE
// ============================================================

void drawDigitalValue(
