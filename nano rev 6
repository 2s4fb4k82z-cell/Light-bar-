/*
  ============================================================
  CODE 3 MX7000 - NANO ESP32 CENTRAL CONTROLLER
  ============================================================

  Arduino Nano ESP32

  PHYSICAL INPUTS - ACTIVE LOW
  --------------------------------
  D2  OUTERS
  D3  INTERMEDIATES
  D4  INNERS
  D5  TRAFFICBREAKERS
  D6  LEDS
  D7  TLEFT
  D8  TRIGHT
  D9  TOUT
  A0  LEFTSIGNAL
  A1  RIGHTSIGNAL


  NANO <-> MEGA
  --------------------------------
  Nano D10 TX -> Mega D19 RX1
  Nano D11 RX <- Mega D18 TX1
  38400 baud

  IMPORTANT:
  Mega TX is 5V.
  Nano RX is 3.3V.
  Use level shifting / resistor divider.


  NANO <-> GIGA
  --------------------------------
  Nano D13 TX -> GIGA D0 RX
  Nano D12 RX <- GIGA D1 TX
  38400 baud


  ============================================================
  PHYSICAL OVERRIDE
  ============================================================

  GIGA:
      OVERRIDE OUTERS ON

  Nano:
      ACK OVERRIDE OUTERS ON
      CONFIRMED OVERRIDE OUTERS ON

  State:
      STATE OUTERS P=1 G=0 E=0 M=0 H=0 O=1

  O = physical override

  Override suppresses ONLY physical source.

  Physical switch OFF automatically clears override.


  ============================================================
  STALE ACK / RACE PROTECTION
  ============================================================

  Mega ACK means:

      "Mega just reached this state."

  It DOES NOT automatically mean:

      "The newest GIGA request succeeded."


  Example:

      Nano -> Mega:
          START OUTERS

      GIGA changes request:
          STOP OUTERS

      Mega replies late:
          ACK START OUTERS

  Nano records:

      Mega OUTERS = ON

  But current desired state is OFF.

  Therefore Nano immediately schedules:

      STOP OUTERS

  and DOES NOT send:

      CONFIRMED START OUTERS

  to GIGA.

  Only a Mega state matching the CURRENT desired/GIGA request
  can produce the corresponding GIGA confirmation.
  ============================================================
*/


#include <Arduino.h>
#include <string.h>
#include <strings.h>


// ============================================================
// SERIAL SPEEDS
// ============================================================

const unsigned long USB_BAUD  = 115200;
const unsigned long MEGA_BAUD = 38400;
const unsigned long GIGA_BAUD = 38400;


// ============================================================
// UARTS
// ============================================================

HardwareSerial MegaSerial(1);
HardwareSerial GigaSerial(2);


// ============================================================
// UART PINS
// ============================================================

const int MEGA_RX_PIN = D11;
const int MEGA_TX_PIN = D10;

const int GIGA_RX_PIN = D12;
const int GIGA_TX_PIN = D13;


// ============================================================
// COMMAND DEFINITIONS
// ============================================================

enum CommandIndex {

  CMD_OUTERS = 0,
  CMD_INTERMEDIATES,
  CMD_INNERS,
  CMD_TRAFFICBREAKERS,
  CMD_LEDS,

  CMD_TLEFT,
  CMD_TRIGHT,
  CMD_TOUT,

  CMD_LEFTSIGNAL,
  CMD_RIGHTSIGNAL,

  NUM_COMMANDS
};


const char *commandNames[NUM_COMMANDS] = {

  "OUTERS",
  "INTERMEDIATES",
  "INNERS",
  "TRAFFICBREAKERS",
  "LEDS",

  "TLEFT",
  "TRIGHT",
  "TOUT",

  "LEFTSIGNAL",
  "RIGHTSIGNAL"
};


// ============================================================
// PHYSICAL INPUT PINS
// ============================================================

const int physicalPins[NUM_COMMANDS] = {

  D2,
  D3,
  D4,
  D5,
  D6,

  D7,
  D8,
  D9,

  A0,
  A1
};


// ============================================================
// DEBOUNCE
// ============================================================

const unsigned long DEBOUNCE_TIME = 50;

bool rawPhysicalState[NUM_COMMANDS];

bool physicalRequest[NUM_COMMANDS];

unsigned long physicalChangedAt[NUM_COMMANDS];


// ============================================================
// SOURCE STATES
// ============================================================

bool gigaRequest[NUM_COMMANDS];

bool physicalOverride[NUM_COMMANDS];

bool effectiveState[NUM_COMMANDS];

bool megaConfirmedState[NUM_COMMANDS];


// ============================================================
// STARTUP HOLD
// ============================================================

const unsigned long STARTUP_HOLD_TIME = 120000UL;

bool startupHeld[NUM_COMMANDS];

unsigned long startupHoldStartedAt = 0;

unsigned long lastHoldReport[NUM_COMMANDS];


// ============================================================
// TRAFFIC ADVISOR ACTIVATION ORDER
// ============================================================

unsigned long activationCounter = 0;

unsigned long physicalTAOrder[NUM_COMMANDS];

unsigned long gigaTAOrder[NUM_COMMANDS];

int desiredTAMode   = -1;
int confirmedTAMode = -1;


// ============================================================
// MEGA PENDING COMMAND
// ============================================================

const unsigned long MEGA_COMMAND_TIMEOUT = 1500;

const byte MAX_MEGA_RETRIES = 2;


struct MegaPendingCommand {

  bool active;

  bool targetState;

  byte retries;

  unsigned long sentAt;

  bool partOfResync;
};


MegaPendingCommand megaPending[NUM_COMMANDS];


// ============================================================
// MEGA HEARTBEAT
// ============================================================

const unsigned long MEGA_PING_INTERVAL = 5000;
const unsigned long MEGA_PONG_TIMEOUT  = 15000;

unsigned long lastMegaPing = 0;
unsigned long lastMegaPong = 0;

bool megaLinkLost = true;

bool megaHeartbeatEstablished = false;


// ============================================================
// GIGA HEARTBEAT
// ============================================================

const unsigned long GIGA_TIMEOUT = 60000;

unsigned long lastGigaHeartbeat = 0;

bool gigaConnected = false;

bool bootNoticeSentToGiga = false;


// ============================================================
// MEGA RESYNC
// ============================================================

bool megaResyncActive = false;

int megaResyncIndex = 0;


// ============================================================
// RECEIVE BUFFERS
// ============================================================

char megaRxBuffer[128];
byte megaRxIndex = 0;

char gigaRxBuffer[160];
byte gigaRxIndex = 0;


// ============================================================
// PROTOTYPES
// ============================================================

int commandIndexFromName(const char *name);

bool isTACommand(int command);

bool physicalSourceAllowed(int command);

void readPhysicalInputs();

void handlePhysicalTransition(
  int command,
  bool active
);

void setPhysicalOverride(
  int command,
  bool enabled
);

void updateStartupHolds();

void updateEffectiveStates();

int determineTAWinner();

void reconcileMegaOutputs();

void reconcileAfterMegaAck(
  int command
);

void requestMegaState(
  int command,
  bool state,
  bool partOfResync
);

void transmitMegaCommand(
  int command,
  bool state
);

void retryMegaCommands();

void handleMegaSerial();

void processMegaLine(
  char *line
);

void handleGigaSerial();

void processGigaLine(
  char *line
);

void sendGigaState(
  int command
);

void sendAllGigaStates();

void sendGigaLinkState();

void sendGigaConfirmation(
  int command,
  bool state
);

void sendGigaFailure(
  int command,
  bool state,
  const char *reason
);

void clearAllGigaRequests();

void sendMegaHeartbeat();

void updateMegaWatchdog();

void updateGigaWatchdog();

void markMegaRestored();

void markMegaLost();

void startMegaResync();

void continueMegaResync();

void cancelMegaPending();

void logToGiga(
  const char *message
);


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    USB_BAUD
  );


  MegaSerial.begin(
    MEGA_BAUD,
    SERIAL_8N1,
    MEGA_RX_PIN,
    MEGA_TX_PIN
  );


  GigaSerial.begin(
    GIGA_BAUD,
    SERIAL_8N1,
    GIGA_RX_PIN,
    GIGA_TX_PIN
  );


  startupHoldStartedAt =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    pinMode(
      physicalPins[i],
      INPUT_PULLUP
    );


    bool active =
      digitalRead(
        physicalPins[i]
      ) == LOW;


    rawPhysicalState[i] =
      active;


    physicalRequest[i] =
      active;


    physicalChangedAt[i] =
      millis();


    gigaRequest[i] =
      false;


    physicalOverride[i] =
      false;


    effectiveState[i] =
      false;


    megaConfirmedState[i] =
      false;


    startupHeld[i] =
      active;


    lastHoldReport[i] =
      0;


    physicalTAOrder[i] =
      0;


    gigaTAOrder[i] =
      0;


    megaPending[i].active =
      false;


    megaPending[i].targetState =
      false;


    megaPending[i].retries =
      0;


    megaPending[i].sentAt =
      0;


    megaPending[i].partOfResync =
      false;
  }


  // ----------------------------------------------------------
  // Remember initial TA physical activation order.
  // ----------------------------------------------------------

  for (
    int i = CMD_TLEFT;
    i <= CMD_TOUT;
    i++
  ) {

    if (
      physicalRequest[i]
    ) {

      physicalTAOrder[i] =
        ++activationCounter;
    }
  }


  // ----------------------------------------------------------
  // Initial Mega heartbeat.
  // ----------------------------------------------------------

  MegaSerial.println(
    "PING"
  );


  lastMegaPing =
    millis();


  Serial.println(
    "Nano controller booted."
  );
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  readPhysicalInputs();

  handleMegaSerial();

  handleGigaSerial();

  updateStartupHolds();

  updateEffectiveStates();

  reconcileMegaOutputs();

  retryMegaCommands();

  sendMegaHeartbeat();

  updateMegaWatchdog();

  updateGigaWatchdog();

  continueMegaResync();
}


// ============================================================
// COMMAND LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// IS TA COMMAND
// ============================================================

bool isTACommand(
  int command
) {

  return (
    command == CMD_TLEFT ||
    command == CMD_TRIGHT ||
    command == CMD_TOUT
  );
}


// ============================================================
// PHYSICAL SOURCE ALLOWED
// ============================================================

bool physicalSourceAllowed(
  int command
) {

  if (
    !physicalRequest[command]
  ) {

    return false;
  }


  if (
    physicalOverride[command]
  ) {

    return false;
  }


  if (
    startupHeld[command]
  ) {

    return false;
  }


  return true;
}


// ============================================================
// READ PHYSICAL INPUTS
// ============================================================

void readPhysicalInputs() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    bool raw =
      digitalRead(
        physicalPins[i]
      ) == LOW;


    if (
      raw !=
      rawPhysicalState[i]
    ) {

      rawPhysicalState[i] =
        raw;


      physicalChangedAt[i] =
        now;
    }


    if (
      raw ==
      physicalRequest[i]
    ) {

      continue;
    }


    if (
      now -
      physicalChangedAt[i] <
      DEBOUNCE_TIME
    ) {

      continue;
    }


    physicalRequest[i] =
      raw;


    handlePhysicalTransition(
      i,
      raw
    );
  }
}


// ============================================================
// PHYSICAL TRANSITION
// ============================================================

void handlePhysicalTransition(
  int command,
  bool active
) {

  // ==========================================================
  // PHYSICAL ON
  // ==========================================================

  if (
    active
  ) {

    // Any deliberate post-boot activation bypasses the
    // original boot hold.

    startupHeld[command] =
      false;


    // OFF automatically clears override, so a fresh physical
    // activation always begins un-overridden.

    physicalOverride[command] =
      false;


    if (
      isTACommand(
        command
      )
    ) {

      physicalTAOrder[command] =
        ++activationCounter;
    }
  }


  // ==========================================================
  // PHYSICAL OFF
  // ==========================================================

  else {

    startupHeld[command] =
      false;


    // Critical override behavior:
    // physical OFF clears override.

    physicalOverride[command] =
      false;


    if (
      isTACommand(
        command
      )
    ) {

      physicalTAOrder[command] =
        0;
    }
  }


  updateEffectiveStates();

  reconcileMegaOutputs();

  sendGigaState(
    command
  );
}


// ============================================================
// SET PHYSICAL OVERRIDE
// ============================================================

void setPhysicalOverride(
  int command,
  bool enabled
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  if (
    enabled &&
    !physicalRequest[command]
  ) {

    physicalOverride[command] =
      false;


    return;
  }


  physicalOverride[command] =
    enabled;


  updateEffectiveStates();

  reconcileMegaOutputs();

  sendGigaState(
    command
  );
}


// ============================================================
// STARTUP HOLD
// ============================================================

void updateStartupHolds() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      !startupHeld[i]
    ) {

      continue;
    }


    // --------------------------------------------------------
    // Physical OFF cancels hold and override.
    // --------------------------------------------------------

    if (
      !physicalRequest[i]
    ) {

      startupHeld[i] =
        false;


      physicalOverride[i] =
        false;


      updateEffectiveStates();

      reconcileMegaOutputs();

      sendGigaState(
        i
      );


      continue;
    }


    unsigned long elapsed =
      now -
      startupHoldStartedAt;


    // --------------------------------------------------------
    // HOLD EXPIRED
    // --------------------------------------------------------

    if (
      elapsed >=
      STARTUP_HOLD_TIME
    ) {

      startupHeld[i] =
        false;


      updateEffectiveStates();

      reconcileMegaOutputs();

      sendGigaState(
        i
      );


      continue;
    }


    // --------------------------------------------------------
    // HOLD REPORT
    // --------------------------------------------------------

    if (
      gigaConnected &&
      (
        lastHoldReport[i] == 0 ||
        now -
        lastHoldReport[i] >=
        10000UL
      )
    ) {

      lastHoldReport[i] =
        now;


      unsigned long remaining =
        (
          STARTUP_HOLD_TIME -
          elapsed
        ) /
        1000UL;


      char message[80];


      snprintf(
        message,
        sizeof(message),
        "HOLD %s %lu",
        commandNames[i],
        remaining
      );


      GigaSerial.println(
        message
      );
    }
  }
}


// ============================================================
// DETERMINE TA WINNER
// ============================================================

int determineTAWinner() {

  int winner =
    -1;


  unsigned long newestOrder =
    0;


  for (
    int i = CMD_TLEFT;
    i <= CMD_TOUT;
    i++
  ) {

    // --------------------------------------------------------
    // PHYSICAL TA SOURCE
    // --------------------------------------------------------

    if (
      physicalSourceAllowed(
        i
      )
    ) {

      if (
        physicalTAOrder[i] >
        newestOrder
      ) {

        newestOrder =
          physicalTAOrder[i];


        winner =
          i;
      }
    }


    // --------------------------------------------------------
    // GIGA TA SOURCE
    // --------------------------------------------------------

    if (
      gigaRequest[i]
    ) {

      if (
        gigaTAOrder[i] >
        newestOrder
      ) {

        newestOrder =
          gigaTAOrder[i];


        winner =
          i;
      }
    }
  }


  return winner;
}


// ============================================================
// UPDATE EFFECTIVE STATE
// ============================================================

void updateEffectiveStates() {

  desiredTAMode =
    determineTAWinner();


  // ==========================================================
  // NON-TA
  // ==========================================================

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      isTACommand(
        i
      )
    ) {

      continue;
    }


    bool physicalAllowed =
      physicalSourceAllowed(
        i
      );


    effectiveState[i] =
      physicalAllowed ||
      gigaRequest[i];
  }


  // ==========================================================
  // TA
  // ==========================================================

  effectiveState[
    CMD_TLEFT
  ] =
    desiredTAMode ==
    CMD_TLEFT;


  effectiveState[
    CMD_TRIGHT
  ] =
    desiredTAMode ==
    CMD_TRIGHT;


  effectiveState[
    CMD_TOUT
  ] =
    desiredTAMode ==
    CMD_TOUT;
}


// ============================================================
// RECONCILE MEGA OUTPUTS
// ============================================================

void reconcileMegaOutputs() {

  if (
    megaLinkLost ||
    !megaHeartbeatEstablished
  ) {

    return;
  }


  if (
    megaResyncActive
  ) {

    return;
  }


  // ==========================================================
  // TRAFFIC ADVISOR
  // ==========================================================

  if (
    desiredTAMode !=
    confirmedTAMode
  ) {

    // --------------------------------------------------------
    // Stop old confirmed TA first.
    // --------------------------------------------------------

    if (
      confirmedTAMode >=
      CMD_TLEFT &&
      confirmedTAMode <=
      CMD_TOUT
    ) {

      if (
        !megaPending[
          confirmedTAMode
        ].active
      ) {

        requestMegaState(
          confirmedTAMode,
          false,
          false
        );
      }


      return;
    }


    // --------------------------------------------------------
    // Start desired TA.
    // --------------------------------------------------------

    if (
      desiredTAMode >=
      CMD_TLEFT &&
      desiredTAMode <=
      CMD_TOUT
    ) {

      if (
        !megaPending[
          desiredTAMode
        ].active
      ) {

        requestMegaState(
          desiredTAMode,
          true,
          false
        );
      }


      return;
    }
  }


  // ==========================================================
  // NON-TA
  // ==========================================================

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      isTACommand(
        i
      )
    ) {

      continue;
    }


    if (
      megaPending[i].active
    ) {

      continue;
    }


    if (
      effectiveState[i] !=
      megaConfirmedState[i]
    ) {

      requestMegaState(
        i,
        effectiveState[i],
        false
      );


      return;
    }
  }
}


// ============================================================
// RECONCILE IMMEDIATELY AFTER MEGA ACK
//
// THIS IS THE MAIN RACE-CONDITION FIX.
// ============================================================

void reconcileAfterMegaAck(
  int command
) {

  updateEffectiveStates();


  // ==========================================================
  // TA
  // ==========================================================

  if (
    isTACommand(
      command
    )
  ) {

    // --------------------------------------------------------
    // The ACK may have made a TA mode active that is no longer
    // the desired winner.
    //
    // reconcileMegaOutputs() will first STOP the stale mode,
    // then START the current winner.
    // --------------------------------------------------------

    if (
      confirmedTAMode !=
      desiredTAMode
    ) {

      reconcileMegaOutputs();
    }


    return;
  }


  // ==========================================================
  // NORMAL OUTPUT
  // ==========================================================

  if (
    megaConfirmedState[command] !=
    effectiveState[command]
  ) {

    // --------------------------------------------------------
    // Mega reached stale state.
    //
    // Do not wait for the normal loop.
    // Immediately request correction.
    // --------------------------------------------------------

    if (
      !megaPending[command].active
    ) {

      requestMegaState(
        command,
        effectiveState[command],
        false
      );
    }
  }
}


// ============================================================
// REQUEST MEGA STATE
// ============================================================

void requestMegaState(
  int command,
  bool state,
  bool partOfResync
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  megaPending[command].active =
    true;


  megaPending[command].targetState =
    state;


  megaPending[command].retries =
    0;


  megaPending[command].sentAt =
    millis();


  megaPending[command].partOfResync =
    partOfResync;


  transmitMegaCommand(
    command,
    state
  );
}


// ============================================================
// TRANSMIT MEGA COMMAND
// ============================================================

void transmitMegaCommand(
  int command,
  bool state
) {

  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    state ?
      "START" :
      "STOP",
    commandNames[command]
  );


  MegaSerial.println(
    message
  );


  if (
    gigaConnected
  ) {

    char diag[96];


    snprintf(
      diag,
      sizeof(diag),
      "DIAG N>M %s",
      message
    );


    GigaSerial.println(
      diag
    );
  }


  Serial.print(
    "N>M "
  );


  Serial.println(
    message
  );
}


// ============================================================
// RETRY MEGA COMMANDS
// ============================================================

void retryMegaCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    MegaPendingCommand &pending =
      megaPending[i];


    if (
      !pending.active
    ) {

      continue;
    }


    // --------------------------------------------------------
    // IMPORTANT:
    //
    // If desired state changed while command was pending,
    // cancel obsolete transaction immediately.
    //
    // This prevents retrying START after desired became STOP
    // or retrying STOP after desired became START.
    // --------------------------------------------------------

    if (
      !pending.partOfResync
    ) {

      bool currentDesired;


      if (
        isTACommand(
          i
        )
      ) {

        currentDesired =
          desiredTAMode ==
          i;

      } else {

        currentDesired =
          effectiveState[i];
      }


      if (
        pending.targetState !=
        currentDesired
      ) {

        pending.active =
          false;


        pending.partOfResync =
          false;


        // Immediately reconcile newest desired state.

        reconcileMegaOutputs();


        continue;
      }
    }


    if (
      now -
      pending.sentAt <
      MEGA_COMMAND_TIMEOUT
    ) {

      continue;
    }


    // ========================================================
    // RETRY
    // ========================================================

    if (
      pending.retries <
      MAX_MEGA_RETRIES
    ) {

      pending.retries++;


      pending.sentAt =
        now;


      transmitMegaCommand(
        i,
        pending.targetState
      );


      continue;
    }


    // ========================================================
    // FAILED
    // ========================================================

    bool target =
      pending.targetState;


    bool wasResync =
      pending.partOfResync;


    pending.active =
      false;


    pending.partOfResync =
      false;


    if (
      !wasResync
    ) {

      // ------------------------------------------------------
      // Only report failure if this target is STILL desired.
      // ------------------------------------------------------

      bool stillDesired;


      if (
        isTACommand(
          i
        )
      ) {

        stillDesired =
          (
            desiredTAMode ==
            i
          ) ==
          target;

      } else {

        stillDesired =
          effectiveState[i] ==
          target;
      }


      if (
        stillDesired
      ) {

        sendGigaFailure(
          i,
          target,
          "MEGA_NO_ACK"
        );
      }
    }


    if (
      wasResync
    ) {

      megaResyncActive =
        false;
    }
  }
}


// ============================================================
// MEGA SERIAL
// ============================================================

void handleMegaSerial() {

  while (
    MegaSerial.available()
  ) {

    char c =
      MegaSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        megaRxIndex > 0
      ) {

        megaRxBuffer[
          megaRxIndex
        ] = '\0';


        processMegaLine(
          megaRxBuffer
        );


        megaRxIndex =
          0;
      }

    } else {

      if (
        megaRxIndex <
        sizeof(
          megaRxBuffer
        ) - 1
      ) {

        megaRxBuffer[
          megaRxIndex++
        ] = c;

      } else {

        megaRxIndex =
          0;


        logToGiga(
          "MEGA_RX_OVERFLOW"
        );
      }
    }
  }
}


// ============================================================
// PROCESS MEGA LINE
// ============================================================

void processMegaLine(
  char *line
) {

  Serial.print(
    "M>N "
  );


  Serial.println(
    line
  );


  // ----------------------------------------------------------
  // Forward Mega diagnostics to GIGA.
  // ----------------------------------------------------------

  if (
    gigaConnected
  ) {

    char diag[160];


    snprintf(
      diag,
      sizeof(diag),
      "DIAG M>N %s",
      line
    );


    GigaSerial.println(
      diag
    );
  }


  // ==========================================================
  // PONG
  // ==========================================================

  if (
    strcmp(
      line,
      "PONG"
    ) == 0
  ) {

    lastMegaPong =
      millis();


    megaHeartbeatEstablished =
      true;


    if (
      megaLinkLost
    ) {

      markMegaRestored();
    }


    return;
  }


  // ==========================================================
  // MEGA BOOT
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_BOOT"
    ) == 0
  ) {

    megaHeartbeatEstablished =
      false;


    megaLinkLost =
      true;


    lastMegaPong =
      0;


    confirmedTAMode =
      -1;


    for (
      int i = 0;
      i < NUM_COMMANDS;
      i++
    ) {

      megaConfirmedState[i] =
        false;


      megaPending[i].active =
        false;


      megaPending[i].partOfResync =
        false;
    }


    if (
      gigaConnected
    ) {

      GigaSerial.println(
        "MEGA_LINK_LOST"
      );
    }


    return;
  }


  // ==========================================================
  // MEGA FAILSAFE
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_FAILSAFE"
    ) == 0
  ) {

    markMegaLost();


    return;
  }


  // ==========================================================
  // MEGA RECOVERED
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_RECOVERED"
    ) == 0
  ) {

    lastMegaPong =
      millis();


    megaHeartbeatEstablished =
      true;


    markMegaRestored();


    return;
  }


  // ==========================================================
  // ACK
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];

    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) != 2
    ) {

      return;
    }


    int command =
      commandIndexFromName(
        commandName
      );


    if (
      command < 0
    ) {

      return;
    }


    bool ackState =
      strcasecmp(
        action,
        "START"
      ) == 0;


    MegaPendingCommand &pending =
      megaPending[command];


    // ========================================================
    // ACK DOES NOT MATCH CURRENT PENDING TRANSACTION
    //
    // Treat it as a stale ACK.
    //
    // IMPORTANT:
    // We do NOT let an unrelated ACK complete the newer
    // transaction.
    // ========================================================

    if (
      !pending.active ||
      pending.targetState !=
      ackState
    ) {

      // ------------------------------------------------------
      // We still learned something:
      // Mega says this output just reached ackState.
      // ------------------------------------------------------

      if (
        isTACommand(
          command
        )
      ) {

        if (
          ackState
        ) {

          confirmedTAMode =
            command;


          megaConfirmedState[
            CMD_TLEFT
          ] =
            command ==
            CMD_TLEFT;


          megaConfirmedState[
            CMD_TRIGHT
          ] =
            command ==
            CMD_TRIGHT;


          megaConfirmedState[
            CMD_TOUT
          ] =
            command ==
            CMD_TOUT;

        } else {

          megaConfirmedState[
            command
          ] =
            false;


          if (
            confirmedTAMode ==
            command
          ) {

            confirmedTAMode =
              -1;
          }
        }

      } else {

        megaConfirmedState[
          command
        ] =
          ackState;
      }


      // ------------------------------------------------------
      // DO NOT SEND GIGA CONFIRMED.
      //
      // Instead immediately compare this stale Mega state
      // against the newest desired state.
      // ------------------------------------------------------

      reconcileAfterMegaAck(
        command
      );


      sendGigaState(
        command
      );


      return;
    }


    // ========================================================
    // ACK MATCHES CURRENT PENDING TRANSACTION
    // ========================================================

    bool wasResync =
      pending.partOfResync;


    pending.active =
      false;


    pending.partOfResync =
      false;


    // --------------------------------------------------------
    // Record what Mega actually confirmed.
    // --------------------------------------------------------

    if (
      isTACommand(
        command
      )
    ) {

      if (
        ackState
      ) {

        confirmedTAMode =
          command;


        megaConfirmedState[
          CMD_TLEFT
        ] =
          command ==
          CMD_TLEFT;


        megaConfirmedState[
          CMD_TRIGHT
        ] =
          command ==
          CMD_TRIGHT;


        megaConfirmedState[
          CMD_TOUT
        ] =
          command ==
          CMD_TOUT;

      } else {

        megaConfirmedState[
          command
        ] =
          false;


        if (
          confirmedTAMode ==
          command
        ) {

          confirmedTAMode =
            -1;
        }
      }

    } else {

      megaConfirmedState[
        command
      ] =
        ackState;
    }


    // --------------------------------------------------------
    // Recalculate CURRENT desired state now.
    //
    // This is important because GIGA or physical state may
    // have changed after command was originally sent.
    // --------------------------------------------------------

    updateEffectiveStates();


    bool currentDesired;


    if (
      isTACommand(
        command
      )
    ) {

      currentDesired =
        desiredTAMode ==
        command;

    } else {

      currentDesired =
        effectiveState[
          command
        ];
    }


    // ========================================================
    // ONLY CURRENT ACK MAY CONFIRM GIGA
    // ========================================================

    if (
      !wasResync &&
      ackState ==
      currentDesired
    ) {

      // ------------------------------------------------------
      // START confirmation:
      //
      // GIGA must CURRENTLY be requesting START.
      // ------------------------------------------------------

      if (
        ackState &&
        gigaRequest[command]
      ) {

        sendGigaConfirmation(
          command,
          true
        );
      }


      // ------------------------------------------------------
      // STOP confirmation:
      //
      // GIGA must CURRENTLY be requesting STOP.
      // ------------------------------------------------------

      else if (
        !ackState &&
        !gigaRequest[command]
      ) {

        sendGigaConfirmation(
          command,
          false
        );
      }
    }


    // --------------------------------------------------------
    // Send authoritative state.
    // --------------------------------------------------------

    sendGigaState(
      command
    );


    // ========================================================
    // RESYNC
    // ========================================================

    if (
      wasResync
    ) {

      megaResyncIndex++;


      return;
    }


    // ========================================================
    // IMMEDIATELY CORRECT STALE RESULT
    //
    // If desired state changed while Mega was processing the
    // command, this sends the opposite command immediately.
    // ========================================================

    reconcileAfterMegaAck(
      command
    );


    return;
  }
}


// ============================================================
// GIGA SERIAL
// ============================================================

void handleGigaSerial() {

  while (
    GigaSerial.available()
  ) {

    char c =
      GigaSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        gigaRxIndex > 0
      ) {

        gigaRxBuffer[
          gigaRxIndex
        ] = '\0';


        processGigaLine(
          gigaRxBuffer
        );


        gigaRxIndex =
          0;
      }

    } else {

      if (
        gigaRxIndex <
        sizeof(
          gigaRxBuffer
        ) - 1
      ) {

        gigaRxBuffer[
          gigaRxIndex++
        ] = c;

      } else {

        gigaRxIndex =
          0;


        Serial.println(
          "GIGA RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS GIGA LINE
// ============================================================

void processGigaLine(
  char *line
) {

  Serial.print(
    "G>N "
  );


  Serial.println(
    line
  );


  // ==========================================================
  // HEARTBEAT
  // ==========================================================

  if (
    strcmp(
      line,
      "GIGA_PING"
    ) == 0
  ) {

    bool wasDisconnected =
      !gigaConnected;


    gigaConnected =
      true;


    lastGigaHeartbeat =
      millis();


    GigaSerial.println(
      "GIGA_PONG"
    );


    if (
      !bootNoticeSentToGiga
    ) {

      GigaSerial.println(
        "NANO_BOOT"
      );


      bootNoticeSentToGiga =
        true;
    }


    if (
      wasDisconnected
    ) {

      sendAllGigaStates();

      sendGigaLinkState();
    }


    return;
  }


  // ----------------------------------------------------------
  // Ignore command traffic until heartbeat established.
  // ----------------------------------------------------------

  if (
    !gigaConnected
  ) {

    return;
  }


  // ==========================================================
  // SYNC
  // ==========================================================

  if (
    strcmp(
      line,
      "SYNC_REQUEST"
    ) == 0
  ) {

    sendAllGigaStates();

    sendGigaLinkState();

    return;
  }


  // ==========================================================
  // OVERRIDE
  // ==========================================================

  if (
    strncmp(
      line,
      "OVERRIDE ",
      9
    ) == 0
  ) {

    char commandName[32];

    char stateText[8];


    if (
      sscanf(
        line,
        "OVERRIDE %31s %7s",
        commandName,
        stateText
      ) != 2
    ) {

      return;
    }


    int command =
      commandIndexFromName(
        commandName
      );


    if (
      command < 0
    ) {

      return;
    }


    bool enable =
      strcasecmp(
        stateText,
        "ON"
      ) == 0;


    char ack[80];


    snprintf(
      ack,
      sizeof(ack),
      "ACK OVERRIDE %s %s",
      commandNames[command],
      enable ?
        "ON" :
        "OFF"
    );


    GigaSerial.println(
      ack
    );


    // --------------------------------------------------------
    // Cannot override a physical source that isn't ON.
    // --------------------------------------------------------

    if (
      enable &&
      !physicalRequest[command]
    ) {

      physicalOverride[command] =
        false;


      sendGigaState(
        command
      );


      return;
    }


    setPhysicalOverride(
      command,
      enable
    );


    char confirmed[96];


    snprintf(
      confirmed,
      sizeof(confirmed),
      "CONFIRMED OVERRIDE %s %s",
      commandNames[command],
      enable ?
        "ON" :
        "OFF"
    );


    GigaSerial.println(
      confirmed
    );


    sendGigaState(
      command
    );


    return;
  }


  // ==========================================================
  // START
  // ==========================================================

  if (
    strncmp(
      line,
      "START ",
      6
    ) == 0
  ) {

    const char *commandName =
      line + 6;


    int command =
      commandIndexFromName(
        commandName
      );


    if (
      command < 0
    ) {

      return;
    }


    char ack[64];


    snprintf(
      ack,
      sizeof(ack),
      "ACK START %s",
      commandNames[command]
    );


    GigaSerial.println(
      ack
    );


    bool wasActive =
      gigaRequest[command];


    gigaRequest[command] =
      true;


    if (
      isTACommand(
        command
      ) &&
      !wasActive
    ) {

      gigaTAOrder[command] =
        ++activationCounter;
    }


    updateEffectiveStates();


    // --------------------------------------------------------
    // If output is ALREADY in correct state, no Mega command
    // is necessary.
    // --------------------------------------------------------

    bool alreadyCorrect;


    if (
      isTACommand(
        command
      )
    ) {

      alreadyCorrect =
        confirmedTAMode ==
        command;

    } else {

      alreadyCorrect =
        megaConfirmedState[
          command
        ];
    }


    if (
      alreadyCorrect
    ) {

      sendGigaConfirmation(
        command,
        true
      );

    } else if (
      megaLinkLost
    ) {

      sendGigaFailure(
        command,
        true,
        "MEGA_LINK_LOST"
      );

    } else {

      // ------------------------------------------------------
      // IMPORTANT:
      //
      // If an opposite command is currently pending, cancel it
      // now. Do not wait for retry logic.
      // ------------------------------------------------------

      if (
        megaPending[
          command
        ].active &&
        megaPending[
          command
        ].targetState == false &&
        !megaPending[
          command
        ].partOfResync
      ) {

        megaPending[
          command
        ].active =
          false;
      }


      reconcileMegaOutputs();
    }


    sendGigaState(
      command
    );


    return;
  }


  // ==========================================================
  // STOP
  // ==========================================================

  if (
    strncmp(
      line,
      "STOP ",
      5
    ) == 0
  ) {

    const char *commandName =
      line + 5;


    int command =
      commandIndexFromName(
        commandName
      );


    if (
      command < 0
    ) {

      return;
    }


    char ack[64];


    snprintf(
      ack,
      sizeof(ack),
      "ACK STOP %s",
      commandNames[command]
    );


    GigaSerial.println(
      ack
    );


    gigaRequest[command] =
      false;


    if (
      isTACommand(
        command
      )
    ) {

      gigaTAOrder[command] =
        0;
    }


    updateEffectiveStates();


    // --------------------------------------------------------
    // Cancel obsolete pending START immediately.
    // --------------------------------------------------------

    if (
      megaPending[
        command
      ].active &&
      megaPending[
        command
      ].targetState == true &&
      !megaPending[
        command
      ].partOfResync
    ) {

      megaPending[
        command
      ].active =
          false;
    }


    // --------------------------------------------------------
    // If another source still wants output active, GIGA's STOP
    // request itself is satisfied without turning physical
    // source off.
    // --------------------------------------------------------

    if (
      effectiveState[
        command
      ]
    ) {

      sendGigaConfirmation(
        command,
        false
      );

    } else {

      bool alreadyOff;


      if (
        isTACommand(
          command
        )
      ) {

        alreadyOff =
          confirmedTAMode !=
          command;

      } else {

        alreadyOff =
          !megaConfirmedState[
            command
          ];
      }


      if (
        alreadyOff
      ) {

        sendGigaConfirmation(
          command,
          false
        );

      } else if (
        megaLinkLost
      ) {

        sendGigaFailure(
          command,
          false,
          "MEGA_LINK_LOST"
        );

      } else {

        reconcileMegaOutputs();
      }
    }


    sendGigaState(
      command
    );


    return;
  }
}


// ============================================================
// SEND STATE
// ============================================================

void sendGigaState(
  int command
) {

  if (
    !gigaConnected
  ) {

    return;
  }


  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  char message[128];


  snprintf(
    message,
    sizeof(message),

    "STATE %s P=%d G=%d E=%d M=%d H=%d O=%d",

    commandNames[command],

    physicalRequest[command] ?
      1 :
      0,

    gigaRequest[command] ?
      1 :
      0,

    effectiveState[command] ?
      1 :
      0,

    megaConfirmedState[command] ?
      1 :
      0,

    startupHeld[command] ?
      1 :
      0,

    physicalOverride[command] ?
      1 :
      0
  );


  GigaSerial.println(
    message
  );
}


// ============================================================
// SEND FULL STATE
// ============================================================

void sendAllGigaStates() {

  if (
    !gigaConnected
  ) {

    return;
  }


  GigaSerial.println(
    "SYNC_BEGIN"
  );


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    sendGigaState(
      i
    );
  }


  GigaSerial.println(
    "SYNC_END"
  );
}


// ============================================================
// SEND LINK STATE
// ============================================================

void sendGigaLinkState() {

  if (
    !gigaConnected
  ) {

    return;
  }


  if (
    megaLinkLost
  ) {

    GigaSerial.println(
      "MEGA_LINK_LOST"
    );

  } else {

    GigaSerial.println(
      "MEGA_LINK_RESTORED"
    );
  }
}


// ============================================================
// SEND CONFIRMATION
// ============================================================

void sendGigaConfirmation(
  int command,
  bool state
) {

  if (
    !gigaConnected
  ) {

    return;
  }


  char message[80];


  snprintf(
    message,
    sizeof(message),
    "CONFIRMED %s %s",
    state ?
      "START" :
      "STOP",
    commandNames[command]
  );


  GigaSerial.println(
    message
  );
}


// ============================================================
// SEND FAILURE
// ============================================================

void sendGigaFailure(
  int command,
  bool state,
  const char *reason
) {

  if (
    !gigaConnected
  ) {

    return;
  }


  char message[120];


  snprintf(
    message,
    sizeof(message),
    "FAILED %s %s %s",
    state ?
      "START" :
      "STOP",
    commandNames[command],
    reason
  );


  GigaSerial.println(
    message
  );
}


// ============================================================
// CLEAR GIGA REQUESTS
// ============================================================

void clearAllGigaRequests() {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    gigaRequest[i] =
      false;


    gigaTAOrder[i] =
      0;
  }


  updateEffectiveStates();
}


// ============================================================
// MEGA HEARTBEAT
// ============================================================

void sendMegaHeartbeat() {

  unsigned long now =
    millis();


  if (
    now -
    lastMegaPing <
    MEGA_PING_INTERVAL
  ) {

    return;
  }


  lastMegaPing =
    now;


  MegaSerial.println(
    "PING"
  );


  if (
    gigaConnected
  ) {

    GigaSerial.println(
      "DIAG N>M PING"
    );
  }
}


// ============================================================
// MEGA WATCHDOG
// ============================================================

void updateMegaWatchdog() {

  if (
    !megaHeartbeatEstablished
  ) {

    return;
  }


  if (
    millis() -
    lastMegaPong >
    MEGA_PONG_TIMEOUT
  ) {

    if (
      !megaLinkLost
    ) {

      markMegaLost();
    }
  }
}


// ============================================================
// MEGA LOST
// ============================================================

void markMegaLost() {

  megaLinkLost =
    true;


  megaHeartbeatEstablished =
    false;


  megaResyncActive =
    false;


  confirmedTAMode =
    -1;


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    megaConfirmedState[i] =
      false;


    if (
      megaPending[i].active &&
      !megaPending[i].partOfResync
    ) {

      // ------------------------------------------------------
      // Only fail current transaction if target still matches
      // current desired state.
      // ------------------------------------------------------

      bool currentDesired;


      if (
        isTACommand(
          i
        )
      ) {

        currentDesired =
          desiredTAMode ==
          i;

      } else {

        currentDesired =
          effectiveState[i];
      }


      if (
        megaPending[i].targetState ==
        currentDesired
      ) {

        sendGigaFailure(
          i,
          megaPending[i].targetState,
          "MEGA_LINK_LOST"
        );
      }
    }


    megaPending[i].active =
      false;


    megaPending[i].partOfResync =
      false;
  }


  if (
    gigaConnected
  ) {

    GigaSerial.println(
      "MEGA_LINK_LOST"
    );


    sendAllGigaStates();
  }
}


// ============================================================
// MEGA RESTORED
// ============================================================

void markMegaRestored() {

  bool wasLost =
    megaLinkLost;


  megaLinkLost =
    false;


  megaHeartbeatEstablished =
    true;


  lastMegaPong =
    millis();


  if (
    wasLost &&
    gigaConnected
  ) {

    GigaSerial.println(
      "MEGA_LINK_RESTORED"
    );
  }


  if (
    wasLost
  ) {

    startMegaResync();
  }
}


// ============================================================
// START MEGA RESYNC
// ============================================================

void startMegaResync() {

  cancelMegaPending();


  megaResyncActive =
    true;


  megaResyncIndex =
    0;


  confirmedTAMode =
    -1;


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    megaConfirmedState[i] =
      false;
  }
}


// ============================================================
// CONTINUE MEGA RESYNC
// ============================================================

void continueMegaResync() {

  if (
    !megaResyncActive
  ) {

    return;
  }


  if (
    megaLinkLost
  ) {

    megaResyncActive =
      false;


    return;
  }


  // ----------------------------------------------------------
  // Wait for current resync command.
  // ----------------------------------------------------------

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      megaPending[i].active &&
      megaPending[i].partOfResync
    ) {

      return;
    }
  }


  // ----------------------------------------------------------
  // COMPLETE
  // ----------------------------------------------------------

  if (
    megaResyncIndex >=
    NUM_COMMANDS
  ) {

    megaResyncActive =
      false;


    if (
      gigaConnected
    ) {

      sendAllGigaStates();
    }


    // --------------------------------------------------------
    // Desired state may have changed during resync.
    // Immediately reconcile after resync completes.
    // --------------------------------------------------------

    updateEffectiveStates();

    reconcileMegaOutputs();


    return;
  }


  int command =
    megaResyncIndex;


  bool target;


  if (
    isTACommand(
      command
    )
  ) {

    target =
      desiredTAMode ==
      command;

  } else {

    target =
      effectiveState[
        command
      ];
  }


  requestMegaState(
    command,
    target,
    true
  );
}


// ============================================================
// CANCEL PENDING MEGA COMMANDS
// ============================================================

void cancelMegaPending() {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    megaPending[i].active =
      false;


    megaPending[i].partOfResync =
      false;


    megaPending[i].retries =
      0;
  }
}


// ============================================================
// GIGA WATCHDOG
// ============================================================

void updateGigaWatchdog() {

  if (
    !gigaConnected
  ) {

    return;
  }


  if (
    millis() -
    lastGigaHeartbeat <=
    GIGA_TIMEOUT
  ) {

    return;
  }


  gigaConnected =
    false;


  // ----------------------------------------------------------
  // Clear only GIGA requests.
  //
  // Physical switches remain.
  //
  // Physical overrides remain latched while their physical
  // switches remain ON.
  // ----------------------------------------------------------

  clearAllGigaRequests();


  // ----------------------------------------------------------
  // Cancel pending non-resync transactions whose target no
  // longer matches the new physical-only desired state.
  // ----------------------------------------------------------

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      !megaPending[i].active ||
      megaPending[i].partOfResync
    ) {

      continue;
    }


    bool currentDesired;


    if (
      isTACommand(
        i
      )
    ) {

      currentDesired =
        desiredTAMode ==
        i;

    } else {

      currentDesired =
        effectiveState[i];
    }


    if (
      megaPending[i].targetState !=
      currentDesired
    ) {

      megaPending[i].active =
        false;
    }
  }


  reconcileMegaOutputs();


  Serial.println(
    "GIGA heartbeat timeout"
  );
}


// ============================================================
// LOG TO GIGA
// ============================================================

void logToGiga(
  const char *message
) {

  if (
    !gigaConnected
  ) {

    return;
  }


  GigaSerial.print(
    "DIAG "
  );


  GigaSerial.println(
    message
  );
}
