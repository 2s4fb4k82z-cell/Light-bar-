  );

}


// ============================================================
// GIGA COMMAND ACKNOWLEDGEMENT
// ============================================================
//
// Examples:
//
// ACK START OUTERS
// ACK STOP OUTERS
//
// ============================================================

void sendGigaAck(
  const char* action,
  byte command
) {

  if (
    !gigaConnected
  ) {

    return;

  }


  GigaSerial.print(
    "ACK "
  );


  GigaSerial.print(
    action
  );


  GigaSerial.print(
    " "
  );


  GigaSerial.println(
    inputNames[command]
  );


  Serial.print(
    "NANO -> GIGA: ACK "
  );


  Serial.print(
    action
  );


  Serial.print(
    " "
  );


  Serial.println(
    inputNames[command]
  );

}


// ============================================================
// SEND COMMAND STATE TO GIGA
// ============================================================
//
// FORMAT:
//
// STATE OUTERS P=1 G=0 E=1
//
// P = Physical request
// G = GIGA request
// E = Effective state actually commanded toward Mega
//
// For TA:
//
// E = whether that specific TA mode is currently selected.
//
// ============================================================

void sendStateToGiga(
  byte command
) {

  if (
    !gigaConnected
  ) {

    return;

  }


  bool effectiveState;


  // ----------------------------------------------------------
  // TRAFFIC ADVISOR
  // ----------------------------------------------------------

  if (
    isTrafficAdvisorCommand(command)
  ) {

    effectiveState =

      (
        currentMegaTAMode
        ==
        command
      );

  }


  // ----------------------------------------------------------
  // NORMAL COMMAND
  // ----------------------------------------------------------

  else {

    effectiveState =

      megaState[command];

  }


  // ----------------------------------------------------------
  // TRANSMIT STATE
  // ----------------------------------------------------------

  GigaSerial.print(
    "STATE "
  );


  GigaSerial.print(
    inputNames[command]
  );


  GigaSerial.print(
    " P="
  );


  GigaSerial.print(

    physicalRequest[command]
    ?
    1
    :
    0

  );


  GigaSerial.print(
    " G="
  );


  GigaSerial.print(

    gigaRequest[command]
    ?
    1
    :
    0

  );


  GigaSerial.print(
    " E="
  );


  GigaSerial.println(

    effectiveState
    ?
    1
    :
    0

  );


  // ----------------------------------------------------------
  // USB DEBUG
  // ----------------------------------------------------------

  Serial.print(
    "NANO -> GIGA: STATE "
  );


  Serial.print(
    inputNames[command]
  );


  Serial.print(
    " P="
  );


  Serial.print(

    physicalRequest[command]
    ?
    1
    :
    0

  );


  Serial.print(
    " G="
  );


  Serial.print(

    gigaRequest[command]
    ?
    1
    :
    0

  );


  Serial.print(
    " E="
  );


  Serial.println(

    effectiveState
    ?
    1
    :
    0

  );

}


// ============================================================
// SEND ALL TA STATES
// ============================================================

void sendAllTrafficAdvisorStates() {

  if (
    !gigaConnected
  ) {

    return;

  }


  sendStateToGiga(
    CMD_TLEFT
  );


  sendStateToGiga(
    CMD_TRIGHT
  );


  sendStateToGiga(
    CMD_TOUT
  );

}


// ============================================================
// FULL GIGA STATE SYNCHRONIZATION
// ============================================================
//
// Example:
//
// SYNC_BEGIN
// STATE OUTERS P=0 G=1 E=1
// ...
// STATE RIGHTSIGNAL P=0 G=0 E=0
// SYNC_END
//
// ============================================================

void sendAllStatesToGiga() {

  if (
    !gigaConnected
  ) {

    return;

  }


  GigaSerial.println(
    "SYNC_BEGIN"
  );


  Serial.println(
    "NANO -> GIGA: SYNC_BEGIN"
  );


  for (
    byte i = 0;
    i < NUM_INPUTS;
    i++
  ) {

    sendStateToGiga(
      i
    );

  }


  GigaSerial.println(
    "SYNC_END"
  );


  Serial.println(
    "NANO -> GIGA: SYNC_END"
  );

}


// ============================================================
// GIGA WATCHDOG
// ============================================================

void updateGigaWatchdog() {

  if (
    !gigaConnected
  ) {

    return;

  }


  if (

    millis() - lastGigaHeartbeat

    >=

    GIGA_TIMEOUT

  ) {

    gigaConnected =
      false;


    Serial.println();

    Serial.println(
      "================================="
    );

    Serial.println(
      " WARNING: GIGA HEARTBEAT LOST"
    );

    Serial.println(
      " Clearing ALL GIGA requests"
    );

    Serial.println(
      " Physical controls remain active"
    );

    Serial.println(
      "================================="
    );

    Serial.println();


    clearGigaControlledOutputs();

  }

}


// ============================================================
// CLEAR ALL GIGA REQUESTS
// ============================================================
//
// Includes:
//
// OUTERS
// INTERMEDIATES
// INNERS
// TRAFFICBREAKERS
// LEDS
// TLEFT
// TRIGHT
// TOUT
// LEFTSIGNAL
// RIGHTSIGNAL
//
// Physical requests are NEVER changed.
//
// ============================================================

void clearGigaControlledOutputs() {

  bool taChanged =
    false;


  for (

    byte command = 0;

    command < NUM_INPUTS;

    command++

  ) {

    if (
      !gigaRequest[command]
    ) {

      continue;

    }


    Serial.print(
      "WATCHDOG clearing GIGA request: "
    );


    Serial.println(
      inputNames[command]
    );


    // --------------------------------------------------------
    // REMOVE ONLY GIGA REQUEST
    // --------------------------------------------------------

    gigaRequest[command] =
      false;


    // --------------------------------------------------------
    // TRAFFIC ADVISOR
    // --------------------------------------------------------

    if (
      isTrafficAdvisorCommand(command)
    ) {

      gigaTAOrder[command] =
        0;


      taChanged =
        true;

    }


    // --------------------------------------------------------
    // NORMAL FUNCTION
    // --------------------------------------------------------

    else {

      updateMergedOutput(
        command
      );

    }

  }


  // ----------------------------------------------------------
  // RECALCULATE TA AFTER ALL GIGA TA REQUESTS REMOVED
  // ----------------------------------------------------------

  if (
    taChanged
  ) {

    updateTrafficAdvisorState();

  }


  // ----------------------------------------------------------
  // DO NOT SEND STATE HERE.
  //
  // gigaConnected is false, so the GIGA is gone.
  //
  // When communication returns, GIGA_PING causes a complete
  // state synchronization automatically.
  // ----------------------------------------------------------

}


// ============================================================
// FIND COMMAND INDEX
// ============================================================

int findCommandIndex(
  String command
) {

  for (
    byte i = 0;
    i < NUM_INPUTS;
    i++
  ) {

    if (

      command.equalsIgnoreCase(
        inputNames[i]
      )

    ) {

      return i;

    }

  }


  return -1;

}


// ============================================================
// TRAFFIC ADVISOR COMMAND CHECK
// ============================================================

bool isTrafficAdvisorCommand(
  byte command
) {

  return (

    command == CMD_TLEFT

    ||

    command == CMD_TRIGHT

    ||

    command == CMD_TOUT

  );

}