  if (
    millis() - lastFlashTime
    <
    FLASH_INTERVAL
  ) {

    return;

  }


  lastFlashTime =
    millis();


  flashState =
    !flashState;


  if (
    currentScreen
    ==
    SCREEN_LIGHTBAR
  ) {

    for (
      byte i = 0;
      i < NUM_COMMANDS;
      i++
    ) {

      if (
        lightbar[i].startupHold
        ||
        lightbar[i].failed
      ) {

