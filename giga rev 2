// ============================================================================
// BUTTON COLOR
// ============================================================================
//
// PRIORITY:
//
// 1. Physical + startup hold -> flashing BLUE
// 2. Physical active         -> solid BLUE
// 3. GIGA command failure    -> flashing PURPLE
// 4. GIGA + Mega confirmed   -> solid GREEN
// 5. Otherwise               -> DARK
//
// ============================================================================

uint16_t getButtonColor(
  byte command
) {

  LightbarState& s =
    lightbar[command];


  // ------------------------------------------------------------------------
  // STARTUP HOLD
  // ------------------------------------------------------------------------

  if (
    s.physical
    &&
    s.startupHold
  ) {

    return (
      flashState
      ?
      COLOR_BLUE
      :
      COLOR_DARK
    );

  }


  // ------------------------------------------------------------------------
  // PHYSICAL SOURCE
  // ------------------------------------------------------------------------

  if (
    s.physical
  ) {

    return COLOR_BLUE;

  }


  // ------------------------------------------------------------------------
  // FAILED GIGA COMMAND
  // ------------------------------------------------------------------------

  if (
    s.failed
  ) {

    return (
      flashState
      ?
      COLOR_PURPLE
      :
      COLOR_DARK
    );

  }


  // ------------------------------------------------------------------------
  // GIGA REQUEST CONFIRMED BY MEGA
  // ------------------------------------------------------------------------

  if (
    s.giga
    &&
    s.megaConfirmed
  ) {

    return COLOR_GREEN;

  }


  // ------------------------------------------------------------------------
  // OFF / WAITING
  // ------------------------------------------------------------------------

  return COLOR_DARK;

}


