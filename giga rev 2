// ============================================================================
// DRAW GAUGE
// ============================================================================

void drawGauge(
  int centerX,
  int centerY,
  int radius,
  float displayedValue,
  float actualValue,
  float minimum,
  float maximum,
  float majorStep,
  const char* title,
  const char* unit,
  bool decimalValue
) {

  const float START_ANGLE =
    135.0f;


  const float SWEEP =
    270.0f;


  // ------------------------------------------------------------------------
  // TITLE
  // ------------------------------------------------------------------------

  drawCenteredText(
    title,
    centerX,
    33,
    COLOR_WHITE,
    2
  );


  // ------------------------------------------------------------------------
  // ARC
  // ------------------------------------------------------------------------

  for (
    int degree = 0;
    degree < 270;
    degree += 3
  ) {

    float a1 =

      (
        START_ANGLE
        +
        degree
      )
      *
      DEG_TO_RAD;


    float a2 =

      (
        START_ANGLE
        +
        degree
        +
        3
      )
      *
      DEG_TO_RAD;


    int x1 =

      centerX
      +
      cosf(
        a1
      )
      *
      radius;


    int y1 =

      centerY
      +
      sinf(
        a1
      )
      *
      radius;


    int x2 =

      centerX
      +
      cosf(
        a2
      )
      *
      radius;


    int y2 =

      centerY
      +
      sinf(
        a2
      )
      *
      radius;


    display.drawLine(
      x1,
      y1,
      x2,
      y2,
      COLOR_GRAY
    );

  }


  // ------------------------------------------------------------------------
  // MAJOR TICKS
  // ------------------------------------------------------------------------

  for (
    float value = minimum;
    value <= maximum + 0.01f;
    value += majorStep
  ) {

    float ratio =

      (
        value
        -
        minimum
      )
      /
      (
        maximum
        -
        minimum
      );


    float angle =

      (
        START_ANGLE
        +
        ratio
        *
        SWEEP
      )
      *
      DEG_TO_RAD;


    int outerX =

      centerX
      +
      cosf(
        angle
      )
      *
      radius;


    int outerY =

      centerY
      +
      sinf(
        angle
      )
      *
      radius;


    int innerX =

      centerX
      +
      cosf(
        angle
      )
      *
      (
        radius - 18
      );


    int innerY =

      centerY
      +
      sinf(
        angle
      )
      *
      (
        radius - 18
      );


    display.drawLine(
      outerX,
      outerY,
      innerX,
      innerY,
      COLOR_WHITE
    );


    int labelX =

      centerX
      +
      cosf(
        angle
      )
      *
      (
        radius - 38
      );


    int labelY =

      centerY
      +
      sinf(
        angle
      )
      *
      (
        radius - 38
      );


    char label[12];


    snprintf(
      label,
      sizeof(label),
      "%.0f",
      value
    );


    drawCenteredText(
      label,
      labelX,
      labelY,
      COLOR_LIGHT_GRAY,
      1
    );

  }


  // ------------------------------------------------------------------------
  // NEEDLE
  // ------------------------------------------------------------------------

  float clamped =
    displayedValue;


  if (
    clamped < minimum
  ) {

    clamped =
      minimum;

  }


  if (
    clamped > maximum
  ) {

    clamped =
      maximum;

  }


  float ratio =

    (
      clamped
      -
      minimum
    )
    /
    (
      maximum
      -
      minimum
    );


  float needleAngle =

    (
      START_ANGLE
      +
      ratio
      *
      SWEEP
    )
    *
    DEG_TO_RAD;


  int needleX =

    centerX
    +
    cosf(
      needleAngle
    )
    *
    (
      radius - 45
    );


  int needleY =

    centerY
    +
    sinf(
      needleAngle
    )
    *
    (
      radius - 45
    );


  display.drawLine(
    centerX,
    centerY,
    needleX,
    needleY,
    COLOR_RED
  );


  display.fillCircle(
    centerX,
    centerY,
    7,
    COLOR_WHITE
  );


  // ------------------------------------------------------------------------
  // DIGITAL VALUE
  // ------------------------------------------------------------------------

  char valueString[30];


  if (
    decimalValue
  ) {

    snprintf(
      valueString,
      sizeof(valueString),
      "%.1f %s",
      actualValue,
      unit
    );

  }

  else {

    snprintf(
      valueString,
      sizeof(valueString),
      "%.0f %s",
      actualValue,
      unit
    );

  }


  drawCenteredText(
    valueString,
    centerX,
    421,
    COLOR_WHITE,
    3
  );

}


// ============================================================================
// CENTERED TEXT
// ============================================================================

void drawCenteredText(
  const char* text,
  int centerX,
  int centerY,
  uint16_t color,
  uint8_t size
) {

  int16_t x1;

  int16_t y1;

  uint16_t w;

  uint16_t h;


  display.setTextSize(
    size
  );


  display.getTextBounds(
    text,
    0,
    0,
    &x1,
    &y1,
    &w,
    &h
  );


  display.setTextColor(
    color
  );


  display.setCursor(
    centerX - w / 2,
    centerY - h / 2
  );


  display.print(
    text
  );

}