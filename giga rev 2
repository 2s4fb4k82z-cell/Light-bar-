// ============================================================================

void handleLightbarTap(
  int x,
  int y
) {

  int command =
    findTouchedButton(
      x,
      y
    );


  if (
    command < 0
  ) {

    return;

  }


  bool start =
    !lightbar[command].giga;


  beginGigaCommand(
    command,
    start
  );

}


// ============================================================================
// FIND BUTTON
// ============================================================================

int findTouchedButton(
  int x,
  int y
) {

  for (
    byte i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      x >= buttons[i].x
      &&
      x < buttons[i].x + buttons[i].w
      &&
      y >= buttons[i].y
      &&
      y < buttons[i].y + buttons[i].h
    ) {

      return i;

    }

  }


  return -1;

}


