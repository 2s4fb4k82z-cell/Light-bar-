// ============================================================================
// SERIAL LOG
// ============================================================================

void addSerialLog(
  const char* direction,
  const char* message
) {

  SerialLogEntry& entry =
    serialLog[serialLogHead];


  entry.timestamp =
    millis();


  strncpy(
    entry.direction,
    direction,
    sizeof(entry.direction) - 1
  );


  entry.direction[
    sizeof(entry.direction) - 1
  ] =
    '\0';


  strncpy(
    entry.message,
    message,
    SERIAL_MESSAGE_LENGTH - 1
  );


  entry.message[
    SERIAL_MESSAGE_LENGTH - 1
  ] =
    '\0';


  serialLogHead++;


  if (
    serialLogHead >= SERIAL_LOG_SIZE
  ) {

    serialLogHead =
      0;

  }


  if (
    serialLogCount < SERIAL_LOG_SIZE
  ) {

    serialLogCount++;

  }

}


// ============================================================================
// TOUCH UPDATE
// ============================================================================

void updateTouch() {

  int contacts =
    touch.getTouchPoints(
      touchPoints
    );


  int x = 0;

  int y = 0;


  if (
    contacts > 0
  ) {

    mapTouchPoint(
      touchPoints[0],
      x,
      y
    );

  }


  processSingleTouch(
    contacts,
    x,
    y
  );


  processGestures(
    contacts
  );

}


// ============================================================================
// TOUCH MAPPING
// ============================================================================
//
// Current mapping:
//
// X = raw Y
// Y = 479 - raw X
//
// If hardware orientation differs, change only this function.
//
// ============================================================================

void mapTouchPoint(
  const GDTpoint_t& raw,
  int& x,
  int& y
) {

  x =
    raw.y;


  y =
    479 - raw.x;


  if (
    x < 0
  ) {

    x = 0;

  }


  if (
    x > 799
  ) {

    x = 799;

  }


  if (
    y < 0
  ) {

    y = 0;

  }


  if (
    y > 479
  ) {

    y = 479;

  }

}


// ============================================================================
// SINGLE TOUCH
// ============================================================================

void processSingleTouch(
  int contacts,
  int x,
  int y
) {

  if (
    contacts >= 2
  ) {

    tapCandidate =
      false;

    return;

  }


  if (
    contacts == 1
  ) {

    if (
      !tapActive
    ) {

      tapActive =
        true;


      tapCandidate =
        true;


      tapStartX =
        x;


      tapStartY =
        y;


      tapStartTime =
        millis();

    }

    else {

      if (
        abs(
          x - tapStartX
        )
        >
        25
        ||
        abs(
          y - tapStartY
        )
        >
        25
      ) {

        tapCandidate =
          false;

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // RELEASE
  // ------------------------------------------------------------------------

  if (
    contacts == 0
    &&
    tapActive
  ) {

    tapActive =
      false;


    if (
      tapCandidate
      &&
      millis() - tapStartTime
      <
      800UL
      &&
      currentScreen
      ==
      SCREEN_LIGHTBAR
    ) {

      handleLightbarTap(
        tapStartX,
        tapStartY
      );

    }


    tapCandidate =
      false;

  }

}


// ============================================================================
// TWO-FINGER GESTURES
// ============================================================================

void processGestures(
  int contacts
) {

  if (
    millis() - lastGestureTime
    <
    GESTURE_COOLDOWN
  ) {

    return;

  }


  // ------------------------------------------------------------------------
  // GESTURE START
  // ------------------------------------------------------------------------

  if (
    contacts >= 2
    &&
    !gestureActive
  ) {

    int x1;
    int y1;

    int x2;
    int y2;


    mapTouchPoint(
      touchPoints[0],
      x1,
      y1
    );


    mapTouchPoint(
      touchPoints[1],
      x2,
      y2
    );


    gestureActive =
      true;


    pageGestureCandidate =
      false;


    serialGestureCandidate =
      false;


    // ----------------------------------------------------------------------
    // SERIAL MONITOR GESTURE
    // ----------------------------------------------------------------------

    int topY =
      y1 < y2 ? y1 : y2;


    int bottomY =
      y1 > y2 ? y1 : y2;


    int topX =
      y1 < y2 ? x1 : x2;


    int bottomX =
      y1 > y2 ? x1 : x2;


    if (
      topY <= 144
      &&
      bottomY >= 336
    ) {

      serialGestureCandidate =
        true;


      serialTopStartX =
        topX;


      serialBottomStartX =
        bottomX;

    }


    // ----------------------------------------------------------------------
    // GAUGE/LIGHTBAR GESTURE
    // ----------------------------------------------------------------------

    if (
      currentScreen
      !=
      SCREEN_SERIAL
    ) {

      int leftX =
        x1 < x2 ? x1 : x2;


      int rightX =
        x1 > x2 ? x1 : x2;


      int leftY =
        x1 < x2 ? y1 : y2;


      int rightY =
        x1 > x2 ? y1 : y2;


      if (
        leftX <= 240
        &&
        rightX >= 560
      ) {

        pageGestureCandidate =
          true;


        pageLeftStartY =
          leftY;


        pageRightStartY =
          rightY;

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // TRACK ACTIVE GESTURE
  // ------------------------------------------------------------------------

  if (
    contacts >= 2
    &&
    gestureActive
  ) {

    int x1;
    int y1;

    int x2;
    int y2;


    mapTouchPoint(
      touchPoints[0],
      x1,
      y1
    );


    mapTouchPoint(
      touchPoints[1],
      x2,
      y2
    );


    // ----------------------------------------------------------------------
    // SERIAL LEFT SWIPE
    // ----------------------------------------------------------------------

    if (
      serialGestureCandidate
    ) {

      int topX =
        y1 < y2 ? x1 : x2;


      int bottomX =
        y1 > y2 ? x1 : x2;


      if (
        serialTopStartX - topX
        >=
        GESTURE_DISTANCE
        &&
        serialBottomStartX - bottomX
        >=
        GESTURE_DISTANCE
      ) {

        serialGestureCandidate =
          false;


        pageGestureCandidate =
          false;


        gestureActive =
          false;


        lastGestureTime =
          millis();


        if (
          currentScreen
          ==
          SCREEN_SERIAL
        ) {

          closeSerialMonitor();

        }

        else {

          openSerialMonitor();

        }


        return;

      }

    }


    // ----------------------------------------------------------------------
    // PAGE DOWN SWIPE
    // ----------------------------------------------------------------------

    if (
      pageGestureCandidate
      &&
      currentScreen
      !=
      SCREEN_SERIAL
    ) {

      int leftY =
        x1 < x2 ? y1 : y2;


      int rightY =
        x1 > x2 ? y1 : y2;


      if (
        leftY - pageLeftStartY
        >=
        GESTURE_DISTANCE
        &&
        rightY - pageRightStartY
        >=
        GESTURE_DISTANCE
      ) {

        pageGestureCandidate =
          false;


        serialGestureCandidate =
          false;


        gestureActive =
          false;


        lastGestureTime =
          millis();


        switchNormalScreen();


        return;

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // RELEASE
  // ------------------------------------------------------------------------

  if (
    contacts < 2
    &&
    gestureActive
  ) {

    gestureActive =
      false;


    pageGestureCandidate =
      false;


    serialGestureCandidate =
      false;

  }

}


// ============================================================================
