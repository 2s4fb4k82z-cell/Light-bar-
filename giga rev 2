// ============================================================================
// SETUP
// ============================================================================

void setup() {

  Serial.begin(
    115200
  );


  delay(
    500
  );


  Serial.println();

  Serial.println(
    "=========================================="
  );

  Serial.println(
    " GIGA MX7000 / GAUGE CONTROLLER"
  );

  Serial.println(
    "=========================================="
  );


  // ------------------------------------------------------------------------
  // DISPLAY
  // ------------------------------------------------------------------------

  display.begin();

  display.setRotation(
    1
  );

  display.fillScreen(
    COLOR_BLACK
  );


  // ------------------------------------------------------------------------
  // TOUCH
  // ------------------------------------------------------------------------

  touch.begin();


  // ------------------------------------------------------------------------
  // NANO UART
  // ------------------------------------------------------------------------

  Serial1.begin(
    NANO_BAUD
  );


  // ------------------------------------------------------------------------
  // STATE
  // ------------------------------------------------------------------------

  for (
    byte i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    lightbar[i].physical =
      false;

    lightbar[i].giga =
      false;

    lightbar[i].effective =
      false;

    lightbar[i].megaConfirmed =
      false;

    lightbar[i].startupHold =
      false;


    lightbar[i].failed =
      false;

    lightbar[i].failureReason[0] =
      '\0';


    lightbar[i].nanoAckPending =
      false;

    lightbar[i].pendingStart =
      false;

    lightbar[i].nanoRetries =
      0;

    lightbar[i].commandSentAt =
      0;

    lightbar[i].waitingForConfirmation =
      false;

  }


  initializeButtons();


  // ------------------------------------------------------------------------
  // ENGINE DATA
  // ------------------------------------------------------------------------

  engineData.iprDutyCycle =
    0;

  engineData.icpPressure =
    0;

  engineData.dataValid =
    true;

  engineData.lastUpdate =
    millis();


  drawCurrentScreen();


  // Initial heartbeat.

  sendHeartbeat();

  lastHeartbeatSent =
    millis();

}


// ============================================================================
// LOOP
// ============================================================================

void loop() {

  checkNanoSerial();


  // ------------------------------------------------------------------------
  // HEARTBEAT
  // ------------------------------------------------------------------------

  if (
    millis() - lastHeartbeatSent
    >=
    HEARTBEAT_INTERVAL
  ) {

    sendHeartbeat();

    lastHeartbeatSent =
      millis();

  }


  updateNanoWatchdog();

  serviceGigaCommandRetries();

  updateFlash();

  updateTouch();

  updateEngineSimulation();


  // ------------------------------------------------------------------------
  // GAUGE SCREEN
  // ------------------------------------------------------------------------

  if (
    currentScreen
    ==
    SCREEN_GAUGES
    &&
    millis() - lastGaugeRedraw
    >=
    GAUGE_REDRAW_INTERVAL
  ) {

    lastGaugeRedraw =
      millis();

    drawGaugeScreen();

  }


  // ------------------------------------------------------------------------
  // SERIAL SCREEN
  // ------------------------------------------------------------------------

  if (
    currentScreen
    ==
    SCREEN_SERIAL
    &&
    millis() - lastSerialRedraw
    >=
    SERIAL_REDRAW_INTERVAL
  ) {

    lastSerialRedraw =
      millis();

    drawSerialMonitor();

  }

}


// ============================================================================
// BUTTON POSITIONS
// ============================================================================

void initializeButtons() {

  for (
    byte i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    int column =
      i % BUTTON_COLUMNS;

    int row =
      i / BUTTON_COLUMNS;


    buttons[i].x =

      BUTTON_START_X
      +
      column
      *
      (
        BUTTON_WIDTH
        +
        BUTTON_X_GAP
      );


    buttons[i].y =

      BUTTON_START_Y
      +
      row
      *
      (
        BUTTON_HEIGHT
        +
        BUTTON_Y_GAP
      );


    buttons[i].w =
      BUTTON_WIDTH;

    buttons[i].h =
      BUTTON_HEIGHT;

  }

}


// ============================================================================
// NANO SERIAL
// ============================================================================

void checkNanoSerial() {

  while (
    Serial1.available() > 0
  ) {

    char c =
      Serial1.read();


    if (
      c == '\r'
    ) {

      continue;

    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[nanoRxIndex] =
          '\0';


        lastNanoReceive =
          millis();


        nanoLinkLost =
          false;


        Serial.print(
          "NANO -> GIGA: "
        );

        Serial.println(
          nanoRxBuffer
        );


        addSerialLog(
          "N>G",
          nanoRxBuffer
        );


        processNanoMessage(
          nanoRxBuffer
        );

      }


      nanoRxIndex =
        0;


      continue;

    }


    if (
      nanoRxIndex
      <
      NANO_RX_BUFFER_SIZE - 1
    ) {

      nanoRxBuffer[nanoRxIndex++] =
        c;

    }

    else {

      nanoRxIndex =
        0;


      addSerialLog(
        "ERR",
        "NANO RX BUFFER OVERFLOW"
      );

    }

  }

}


// ============================================================================
// PROCESS NANO MESSAGE
// ============================================================================

void processNanoMessage(
  const char* message
) {

  // ------------------------------------------------------------------------
  // HEARTBEAT
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "GIGA_PONG"
    )
    ==
    0
  ) {

    nanoLinkLost =
      false;

    return;

  }


  // ------------------------------------------------------------------------
  // NANO BOOT
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "NANO_BOOT"
    )
    ==
    0
  ) {

    for (
      byte i = 0;
      i < NUM_COMMANDS;
      i++
    ) {

      lightbar[i].nanoAckPending =
        false;

      lightbar[i].waitingForConfirmation =
        false;


      clearCommandFailure(
        i
      );

    }


    requestFullSync();


    return;

  }


  // ------------------------------------------------------------------------
  // MEGA LINK LOST
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "MEGA_LINK_LOST"
    )
    ==
    0
  ) {

    megaLinkLost =
      true;


    drawCurrentScreen();

    return;

  }


  // ------------------------------------------------------------------------
  // MEGA LINK RESTORED
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "MEGA_LINK_RESTORED"
    )
    ==
    0
  ) {

    megaLinkLost =
      false;


    drawCurrentScreen();

    return;

  }


  // ------------------------------------------------------------------------
  // MEGA REBOOT
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "MEGA_REBOOTED"
    )
    ==
    0
  ) {

    megaLinkLost =
      true;


    drawCurrentScreen();

    return;

  }


  // ------------------------------------------------------------------------
  // MEGA FAILSAFE
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "MEGA_FAILSAFE"
    )
    ==
    0
  ) {

    megaLinkLost =
      true;


    drawCurrentScreen();

    return;

  }


  // ------------------------------------------------------------------------
  // MEGA RECOVERED
  // ------------------------------------------------------------------------

  if (
    strcmp(
      message,
      "MEGA_RECOVERED"
    )
    ==
    0
  ) {

    // Nano handles actual resynchronization.

    return;

  }


  // ------------------------------------------------------------------------
  // STATE
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "STATE ",
      6
    )
    ==
    0
  ) {

    parseStateMessage(
      message
    );

    return;

  }


  // ------------------------------------------------------------------------
  // NANO ACK
  //
  // ACK START OUTERS
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "ACK ",
      4
    )
    ==
    0
  ) {

    char action[10];

    char commandName[30];


    if (
      sscanf(
        message,
        "ACK %9s %29s",
        action,
        commandName
      )
      ==
      2
    ) {

      int command =
        findCommandIndex(
          commandName
        );


      if (
        command >= 0
      ) {

        bool start =
          strcmp(
            action,
            "START"
          )
          ==
          0;


        if (
          lightbar[command].nanoAckPending
          &&
          lightbar[command].pendingStart
          ==
          start
        ) {

          lightbar[command].nanoAckPending =
            false;


          lightbar[command].waitingForConfirmation =
            true;

        }

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // FINAL CONFIRMATION
  //
  // CONFIRMED START OUTERS
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "CONFIRMED ",
      10
    )
    ==
    0
  ) {

    char action[10];

    char commandName[30];


    if (
      sscanf(
        message,
        "CONFIRMED %9s %29s",
        action,
        commandName
      )
      ==
      2
    ) {

      int command =
        findCommandIndex(
          commandName
        );


      if (
        command >= 0
      ) {

        lightbar[command].nanoAckPending =
          false;


        lightbar[command].waitingForConfirmation =
          false;


        clearCommandFailure(
          command
        );


        if (
          currentScreen
          ==
          SCREEN_LIGHTBAR
        ) {

          drawLightbarButton(
            command
          );


          drawCommunicationBorder();

        }

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // FAILED
  //
  // FAILED START OUTERS MEGA_NO_ACK
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "FAILED ",
      7
    )
    ==
    0
  ) {

    char action[10];

    char commandName[30];

    char reason[40];


    if (
      sscanf(
        message,
        "FAILED %9s %29s %39s",
        action,
        commandName,
        reason
      )
      ==
      3
    ) {

      int command =
        findCommandIndex(
          commandName
        );


      if (
        command >= 0
      ) {

        markCommandFailed(
          command,
          reason
        );


        if (
          strcmp(
            reason,
            "MEGA_LINK_LOST"
          )
          ==
          0
        ) {

          megaLinkLost =
            true;

        }

      }

    }


    return;

  }


  // ------------------------------------------------------------------------
  // HOLD
  //
  // HOLD OUTERS 87
  //
  // Logged to serial monitor only.
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "HOLD ",
      5
    )
    ==
    0
  ) {

    return;

  }


  // ------------------------------------------------------------------------
  // DIAGNOSTICS
  //
  // Already logged by checkNanoSerial().
  // ------------------------------------------------------------------------

  if (
    strncmp(
      message,
      "DIAG ",
      5
    )
    ==
    0
  ) {

    return;

  }

}


// ============================================================================
// PARSE STATE
// ============================================================================

void parseStateMessage(
  const char* message
) {

  char commandName[30];

  int p;
  int g;
  int e;
  int m;
  int h;


  int parsed =
    sscanf(
      message,
      "STATE %29s P=%d G=%d E=%d M=%d H=%d",
      commandName,
      &p,
      &g,
      &e,
      &m,
      &h
    );


  if (
    parsed != 6
  ) {

    return;

  }


  int command =
    findCommandIndex(
      commandName
    );


  if (
    command < 0
  ) {

    return;

  }


  lightbar[command].physical =
    p != 0;

  lightbar[command].giga =
    g != 0;

  lightbar[command].effective =
    e != 0;

  lightbar[command].megaConfirmed =
    m != 0;

  lightbar[command].startupHold =
    h != 0;


  // ------------------------------------------------------------------------
  // Remove an old failure once the GIGA source has changed to the
  // opposite state from the failed request.
  // ------------------------------------------------------------------------

  if (
    lightbar[command].failed
  ) {

    bool failedRequestState =
      lightbar[command].pendingStart;


    if (
      failedRequestState
      !=
      lightbar[command].giga
    ) {

      clearCommandFailure(
        command
      );

    }

  }


  if (
    currentScreen
    ==
    SCREEN_LIGHTBAR
  ) {

    drawLightbarButton(
      command
    );


    drawCommunicationBorder();

  }

}


// ============================================================================
// HEARTBEAT
// ============================================================================

void sendHeartbeat() {

  Serial1.println(
    "GIGA_PING"
  );


  addSerialLog(
    "G>N",
    "GIGA_PING"
  );

}


// ============================================================================
// NANO WATCHDOG
// ============================================================================

void updateNanoWatchdog() {

  if (
    millis() - lastNanoReceive
    <
    NANO_LINK_TIMEOUT
  ) {

    return;

  }


  if (
    !nanoLinkLost
  ) {

    nanoLinkLost =
      true;


    addSerialLog(
      "ERR",
      "NANO_LINK_LOST"
    );


    // --------------------------------------------------------
    // Commands waiting for Nano ACK get NANO_NO_ACK.
    // --------------------------------------------------------

    for (
      byte i = 0;
      i < NUM_COMMANDS;
      i++
    ) {

      if (
        lightbar[i].nanoAckPending
      ) {

        markCommandFailed(
          i,
          "NANO_NO_ACK"
        );

      }

    }


    drawCurrentScreen();

  }

}


// ============================================================================
// BEGIN GIGA COMMAND
// ============================================================================

void beginGigaCommand(
  byte command,
  bool start
) {

  if (
    lightbar[command].nanoAckPending
    ||
    lightbar[command].waitingForConfirmation
  ) {

    return;

  }


  clearCommandFailure(
    command
  );


  lightbar[command].pendingStart =
    start;


  lightbar[command].nanoAckPending =
    true;


  lightbar[command].waitingForConfirmation =
    false;


  lightbar[command].nanoRetries =
    0;


  lightbar[command].commandSentAt =
    millis();


  sendCommandToNano(
    command,
    start,
    false
  );


  if (
    currentScreen
    ==
    SCREEN_LIGHTBAR
  ) {

    drawLightbarButton(
      command
    );


    drawCommunicationBorder();

  }

}


// ============================================================================
// SEND GIGA COMMAND
// ============================================================================

void sendCommandToNano(
  byte command,
  bool start,
  bool retry
) {

  const char* action =

    start
    ?
    "START"
    :
    "STOP";


  Serial1.print(
    action
  );


  Serial1.print(
    " "
  );


  Serial1.println(
    commandNames[command]
  );


  char logMessage[100];


  if (
    retry
  ) {

    snprintf(
      logMessage,
      sizeof(logMessage),
      "RETRY %u %s %s",
      lightbar[command].nanoRetries,
      action,
      commandNames[command]
    );

  }

  else {

    snprintf(
      logMessage,
      sizeof(logMessage),
      "%s %s",
      action,
      commandNames[command]
    );

  }


  addSerialLog(
    "G>N",
    logMessage
  );

}


// ============================================================================
// GIGA COMMAND RETRIES
// ============================================================================

void serviceGigaCommandRetries() {

  unsigned long now =
    millis();


  for (
    byte i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      !lightbar[i].nanoAckPending
    ) {

      continue;

    }


    if (
      now - lightbar[i].commandSentAt
      <
      NANO_ACK_TIMEOUT
    ) {

      continue;

    }


    // ----------------------------------------------------------------------
    // RETRY
    // ----------------------------------------------------------------------

    if (
      lightbar[i].nanoRetries
      <
      NANO_MAX_RETRIES
    ) {

      lightbar[i].nanoRetries++;


      lightbar[i].commandSentAt =
        now;


      sendCommandToNano(
        i,
        lightbar[i].pendingStart,
        true
      );


      continue;

    }


    // ----------------------------------------------------------------------
    // NO NANO ACK
    // ----------------------------------------------------------------------

    markCommandFailed(
      i,
      "NANO_NO_ACK"
    );

  }

}


// ============================================================================
// COMMAND FAILURE
// ============================================================================

void markCommandFailed(
  byte command,
  const char* reason
) {

  lightbar[command].failed =
    true;


  lightbar[command].nanoAckPending =
    false;


  lightbar[command].waitingForConfirmation =
    false;


  strncpy(
    lightbar[command].failureReason,
    reason,
    sizeof(
      lightbar[command].failureReason
    )
    -
    1
  );


  lightbar[command].failureReason[
    sizeof(
      lightbar[command].failureReason
    )
    -
    1
  ] =
    '\0';


  char logMessage[100];


  snprintf(
    logMessage,
    sizeof(logMessage),
    "COMMAND_FAILURE %s %s",
    commandNames[command],
    reason
  );


  addSerialLog(
    "ERR",
    logMessage
  );


  if (
    currentScreen
    ==
    SCREEN_LIGHTBAR
  ) {

    drawLightbarButton(
      command
    );


    drawCommunicationBorder();

  }

}


