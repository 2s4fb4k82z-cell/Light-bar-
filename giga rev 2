// ============================================================================
// SERIAL MONITOR
// ============================================================================

void drawSerialMonitor() {

  display.fillScreen(
    COLOR_BLACK
  );


  drawCenteredText(
    "COMMUNICATION MONITOR",
    400,
    18,
    COLOR_WHITE,
    2
  );


  int visibleLines =
    23;


  int count =
    serialLogCount;


  if (
    count > visibleLines
  ) {

    count =
      visibleLines;

  }


  int firstLogical =
    serialLogCount - count;


  int y =
    43;


  display.setTextSize(
    1
  );


  for (
    int line = 0;
    line < count;
    line++
  ) {

    int logicalIndex =
      firstLogical + line;


    int physicalIndex =

      (
        serialLogHead
        -
        serialLogCount
        +
        logicalIndex
        +
        SERIAL_LOG_SIZE
      )
      %
      SERIAL_LOG_SIZE;


    SerialLogEntry& entry =
      serialLog[physicalIndex];


    // ----------------------------------------------------------------------
    // TIME
    // ----------------------------------------------------------------------

    char timestamp[16];


    snprintf(
      timestamp,
      sizeof(timestamp),
      "%08lu",
      entry.timestamp
    );


    display.setCursor(
      8,
      y
    );


    display.setTextColor(
      COLOR_GRAY
    );


    display.print(
      timestamp
    );


    // ----------------------------------------------------------------------
    // DIRECTION
    // ----------------------------------------------------------------------

    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strcmp(
        entry.direction,
        "G>N"
      )
      ==
      0
    ) {

      directionColor =
        COLOR_GREEN;

    }

    else if (
      strcmp(
        entry.direction,
        "N>G"
      )
      ==
      0
    ) {

      directionColor =
        COLOR_BLUE;

    }

    else if (
      strcmp(
        entry.direction,
        "ERR"
      )
      ==
      0
    ) {

      directionColor =
        COLOR_RED;

    }


    display.setCursor(
      76,
      y
    );


    display.setTextColor(
      directionColor
    );


    display.print(
      entry.direction
    );


    // ----------------------------------------------------------------------
    // MESSAGE
    // ----------------------------------------------------------------------

    display.setCursor(
      112,
      y
    );


    display.setTextColor(
      COLOR_WHITE
    );


    display.print(
      entry.message
    );


    y +=
      18;

  }


  drawCommunicationBorder();

}


