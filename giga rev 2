// ============================================================================
// ENGINE SIMULATION
// ============================================================================
//
// Placeholder until J1850 PWM hardware is installed.
//
// ============================================================================

void updateEngineSimulation() {

  if (
    millis() - lastEngineSimulation
    <
    ENGINE_UPDATE_INTERVAL
  ) {

    return;

  }


  lastEngineSimulation =
    millis();


  float seconds =
    millis()
    /
    1000.0f;


  engineData.iprDutyCycle =

    30.0f
    +
    sinf(
      seconds * 0.55f
    )
    *
    10.0f;


  engineData.icpPressure =

    850.0f
    +
    sinf(
      seconds * 0.40f
    )
    *
    400.0f;


  if (
    engineData.iprDutyCycle < 0
  ) {

    engineData.iprDutyCycle =
      0;

  }


  if (
    engineData.iprDutyCycle > 100
  ) {

    engineData.iprDutyCycle =
      100;

  }


  if (
    engineData.icpPressure < 0
  ) {

    engineData.icpPressure =
      0;

  }


  if (
    engineData.icpPressure > 4000
  ) {

    engineData.icpPressure =
      4000;

  }


  engineData.dataValid =
    true;


  engineData.lastUpdate =
    millis();


  // Smoothing

  displayedIPR +=

    (
      engineData.iprDutyCycle
      -
      displayedIPR
    )
    *
    0.15f;


  displayedICP +=

    (
      engineData.icpPressure
      -
      displayedICP
    )
    *
    0.15f;

}


