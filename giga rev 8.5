  display.setCursor(
    ICP_CENTER_X -
    width / 2,
    GAUGE_CENTER_Y + 40
  );


  display.print(text);
}


// ============================================================
// TOUCH
// ============================================================

void handleTouch() {

  uint8_t contacts =
    touch.getTouchPoints(
      touchPoints
    );


  // ==========================================================
  // GAUGE
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    handleSecretGesture(
      contacts,
      touchPoints
    );


    return;
  }


  // ==========================================================
  // LIGHTBAR ENTRY SAFETY
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_LIGHTBAR &&
    !lightbarEntryTouchReleased
  ) {

    updateLightbarEntryRelease(
      contacts
    );


    return;
  }


  // ==========================================================
  // LIGHTBAR
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    if (
      !lightbarTouchEnabled()
    ) {

      return;
    }


    // ========================================================
    // NO TOUCH
    //
    // IMPORTANT:
    // DO NOT immediately execute button.
    // ========================================================

    if (
      contacts == 0
    ) {

      if (
        lightbarPressActive
      ) {

        processLightbarRelease();
      }


      return;
    }


    // ========================================================
    // TOUCH RETURNED
    //
    // If we were timing a possible release and touch came back
    // before 100ms, it was only a touchscreen dropout.
    // ========================================================

    if (
      lightbarReleasePending
    ) {

      lightbarReleasePending =
        false;


      lightbarReleaseStartedAt =
        0;
    }


    int x;
    int y;


    mapTouchPoint(
      touchPoints[0],
      x,
      y
    );


    // ========================================================
    // BEGIN NEW PRESS
    // ========================================================

    if (
      !lightbarPressActive
    ) {

      handleLightbarPress(
        x,
        y
      );


      return;
    }


    // ========================================================
    // CONTINUE EXISTING PRESS
    // ========================================================

    updateLightbarPress(
      contacts,
      x,
      y
    );


    return;
  }


  // ==========================================================
  // SERIAL SCREEN
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_SERIAL
  ) {

    if (
      contacts == 0
    ) {

      buttonTouchActive =
        false;


      return;
    }


    if (
      buttonTouchActive
    ) {

      return;
    }


    buttonTouchActive =
      true;


    int x;
    int y;


    mapTouchPoint(
      touchPoints[0],
      x,
      y
    );


    handleSerialTouch(
      x,
      y
    );
  }
}


// ============================================================
// START LIGHTBAR PRESS
// ============================================================

void handleLightbarPress(
  int x,
  int y
) {

  int column = -1;
  int row = -1;


  for (
    int c = 0;
    c < 5;
    c++
  ) {

    int bx =
      BUTTON_START_X +
      c *
      (
        BUTTON_W +
        BUTTON_GAP_X
      );


    if (
      x >= bx &&
      x <
      bx + BUTTON_W
    ) {

      column = c;

      break;
    }
  }


  for (
    int r = 0;
    r < 2;
    r++
  ) {

    int by =
      BUTTON_START_Y +
      r *
      (
        BUTTON_H +
        BUTTON_GAP_Y
      );


    if (
      y >= by &&
      y <
      by + BUTTON_H
    ) {

      row = r;

      break;
    }
  }


  if (
    column < 0 ||
    row < 0
  ) {

    return;
  }


  // ==========================================================
  // RECORD PRESS
  //
  // NO COMMAND IS SENT HERE.
  // ==========================================================

  lightbarPressActive =
    true;


  lightbarPressedColumn =
    column;


  lightbarPressedRow =
    row;


  lightbarPressedCommand =
    getLightbarCommandAt(
      column,
      row
    );


  lightbarPressStartedAt =
    millis();


  lightbarLongPressDetected =
    false;


  lightbarReleasePending =
    false;


  lightbarReleaseStartedAt =
    0;
}


// ============================================================
// CONTINUE LIGHTBAR PRESS
// ============================================================

void updateLightbarPress(
  uint8_t contacts,
  int x,
  int y
) {

  if (
    !lightbarPressActive
  ) {

    return;
  }


  // ----------------------------------------------------------
  // Finger moved completely outside original button.
  //
  // Cancel the press.
  // ----------------------------------------------------------

  if (
    !pointInsideLightbarButton(
      x,
      y,
      lightbarPressedColumn,
      lightbarPressedRow
    )
  ) {

    cancelLightbarPress();

    return;
  }


  if (
    lightbarPressedCommand < 0
  ) {

    return;
  }


  // ----------------------------------------------------------
  // Already classified as long press.
  // Just wait for release.
  // ----------------------------------------------------------

  if (
    lightbarLongPressDetected
  ) {

    return;
  }


  if (
    millis() -
    lightbarPressStartedAt <
    OVERRIDE_HOLD_TIME
  ) {

    return;
  }


  LightbarState &s =
    lightbar[
      lightbarPressedCommand
    ];


  // ==========================================================
  // LONG PRESS CLASSIFICATION
  //
  // IMPORTANT:
  // WE DO NOT EXECUTE OVERRIDE HERE.
  //
  // We merely remember that this became a long press.
  // ==========================================================

  if (
    s.physical
  ) {

    lightbarLongPressDetected =
      true;
  }
}


// ============================================================
// PROCESS POSSIBLE RELEASE
// ============================================================

void processLightbarRelease() {

  if (
    !lightbarPressActive
  ) {

    return;
  }


  unsigned long now =
    millis();


  // ==========================================================
  // FIRST ZERO-CONTACT SAMPLE
  //
  // Start release timer.
  // ==========================================================

  if (
    !lightbarReleasePending
  ) {

    lightbarReleasePending =
      true;


    lightbarReleaseStartedAt =
      now;


    return;
  }


  // ==========================================================
  // NOT ZERO LONG ENOUGH YET
  // ==========================================================

  if (
    now -
    lightbarReleaseStartedAt <
    BUTTON_RELEASE_CONFIRM_TIME
  ) {

    return;
  }


  // ==========================================================
  // REAL RELEASE CONFIRMED
  //
  // This is the ONLY place the press is committed.
  // ==========================================================

  finishLightbarPress();
}


// ============================================================
// FINISH LIGHTBAR PRESS
// ============================================================

void finishLightbarPress() {

  if (
    !lightbarPressActive
  ) {

    return;
  }


  // ----------------------------------------------------------
  // Copy everything BEFORE resetting press state.
  // ----------------------------------------------------------

  int column =
    lightbarPressedColumn;


  int row =
    lightbarPressedRow;


  int command =
    lightbarPressedCommand;


  bool wasLongPress =
    lightbarLongPressDetected;


  // ----------------------------------------------------------
  // Clear press FIRST.
  //
  // This guarantees this physical touch can only commit once.
  // ----------------------------------------------------------

  cancelLightbarPress();


  // ==========================================================
  // LONG PRESS
  // ==========================================================

  if (
    wasLongPress
  ) {

    if (
      command >= 0
    ) {

      executeLightbarLongPress(
        command
      );
    }


    return;
  }


  // ==========================================================
  // SHORT PRESS ON PHYSICAL-ACTIVE BUTTON
  //
  // Physical buttons require long hold to override.
  // ==========================================================

  if (
    command >= 0 &&
    lightbar[
      command
    ].physical
  ) {

    return;
  }


  // ==========================================================
  // NORMAL SHORT TAP
  // ==========================================================

  executeLightbarShortPress(
    column,
    row,
    command
  );
}


// ============================================================
// CANCEL PRESS
// ============================================================

void cancelLightbarPress() {

  lightbarPressActive =
    false;


  lightbarPressedColumn =
    -1;


  lightbarPressedRow =
    -1;


  lightbarPressedCommand =
    -1;


  lightbarPressStartedAt =
    0;


  lightbarLongPressDetected =
    false;


  lightbarReleasePending =
    false;


  lightbarReleaseStartedAt =
    0;
}


// ============================================================
// EXECUTE SHORT PRESS
// ============================================================

void executeLightbarShortPress(
  int column,
  int row,
  int command
) {

  // ==========================================================
  // TOP ROW
  // ==========================================================

  if (
    row == 0
  ) {

    if (
      command >= 0
    ) {

      sendGigaCommand(
        command,
        !lightbar[
          command
        ].giga
      );
    }


    return;
  }


  // ==========================================================
  // BOTTOM ROW
  // ==========================================================

  switch (
    column
  ) {

    // CLOSE
    case 0:

      drawGaugeScreen();

      break;


    // TA LEFT
    case 1:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // TA OUT
    case 2:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // TA RIGHT
    case 3:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // MONITOR
    case 4:

      drawSerialScreen();

      break;
  }
}


// ============================================================
// EXECUTE LONG PRESS
// ============================================================

void executeLightbarLongPress(
  int command
) {

  if (
    command < 0 ||
    command >=
    NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  if (
    !s.physical
  ) {

    return;
  }


  sendPhysicalOverride(
    command,
    !s.overrideActive
  );
}


// ============================================================
// BUTTON -> COMMAND
// ============================================================

int getLightbarCommandAt(
  int column,
  int row
) {

  if (
    row == 0
  ) {

    switch (
      column
    ) {

      case 0:
        return CMD_TRAFFICBREAKERS;

      case 1:
        return CMD_INNERS;

      case 2:
        return CMD_INTERMEDIATES;

      case 3:
        return CMD_OUTERS;

      case 4:
        return CMD_LEDS;
    }
  }


  if (
    row == 1
  ) {

    switch (
      column
    ) {

      case 1:
        return CMD_TLEFT;

      case 2:
        return CMD_TOUT;

      case 3:
        return CMD_TRIGHT;
    }
  }


  return -1;
}


// ============================================================
// POINT INSIDE BUTTON
// ============================================================

bool pointInsideLightbarButton(
  int x,
  int y,
  int column,
  int row
) {

  if (
    column < 0 ||
    column >= 5 ||
    row < 0 ||
    row >= 2
  ) {

    return false;
  }


  int bx =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int by =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  return (
    x >= bx &&
    x <
    bx + BUTTON_W &&
    y >= by &&
    y <
    by + BUTTON_H
  );
}


// ============================================================
// SEND OVERRIDE
// ============================================================

void sendPhysicalOverride(
  int command,
  bool enable
) {

  if (
    command < 0 ||
    command >=
    NUM_COMMANDS
  ) {

    return;
  }


  char message[80];


  snprintf(
    message,
    sizeof(message),
    "OVERRIDE %s %s",
    commandNames[command],
    enable ?
      "ON" :
      "OFF"
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );


  // Nano STATE remains authoritative.
}


// ============================================================
// SECRET GESTURE
// ============================================================

void handleSecretGesture(
  uint8_t contacts,
  GDTpoint_t *points
) {

  unsigned long now =
    millis();


  if (
    contacts >= 2
  ) {

    float averageRawX =
      (
        (float)points[0].x +
        (float)points[1].x
      ) /
      2.0;


    int separation =
      abs(
        (int)points[0].y -
        (int)points[1].y
      );


    secretLastValidTouch =
      now;


    if (
      secretGestureLocked
    ) {

      return;
    }


    if (
      !secretGestureTracking
    ) {

      if (
        averageRawX >=
        SECRET_START_RAW_X_MIN &&

        averageRawX <=
        SECRET_START_RAW_X_MAX &&

        separation >=
        SECRET_MIN_FINGER_SEPARATION
      ) {

        secretGestureTracking =
          true;


        secretGestureTriggered =
          false;


        secretStartRawX =
          averageRawX;


        secretLowestRawX =
          averageRawX;
      }


      return;
    }


    if (
      averageRawX <
      secretLowestRawX
    ) {

      secretLowestRawX =
        averageRawX;
    }


    float downwardTravel =
      secretStartRawX -
      secretLowestRawX;


    if (
      !secretGestureTriggered &&
      downwardTravel >=
      SECRET_SWIPE_DISTANCE
    ) {

      secretGestureTriggered =
        true;


      secretGestureLocked =
        true;


      drawLightbarScreen();


      return;
    }


    return;
  }


  if (
    secretGestureTracking ||
    secretGestureLocked
  ) {

    if (
      now -
      secretLastValidTouch >
      TOUCH_RELEASE_GRACE
    ) {

      resetSecretGesture();
    }
  }
}


void resetSecretGesture() {

  secretGestureTracking =
    false;


  secretGestureTriggered =
    false;


  secretGestureLocked =
    false;


  secretStartRawX =
    0;


  secretLowestRawX =
    0;


  secretLastValidTouch =
    0;
}


// ============================================================
// LIGHTBAR ENTRY RELEASE
// ============================================================

void updateLightbarEntryRelease(
  uint8_t contacts
) {

  unsigned long now =
    millis();


  if (
    contacts > 0
  ) {

    lightbarNoTouchSince =
      0;


    return;
  }


  if (
    lightbarNoTouchSince == 0
  ) {

    lightbarNoTouchSince =
      now;


    return;
  }


  if (
    now -
    lightbarNoTouchSince >=
    LIGHTBAR_RELEASE_TIME
  ) {

    lightbarEntryTouchReleased =
      true;


    lightbarNoTouchSince =
      0;


    buttonTouchActive =
      false;


    cancelLightbarPress();
  }
}


bool lightbarTouchEnabled() {

  if (
    !lightbarEntryTouchReleased
  ) {

    return false;
  }


  if (
    millis() -
    lightbarScreenOpenedAt <
    LIGHTBAR_TOUCH_LOCKOUT
  ) {

    return false;
  }


  return true;
}


// ============================================================
// TOUCH MAPPING
// ============================================================

void mapTouchPoint(
  const GDTpoint_t &raw,
  int &x,
  int &y
) {

  x =
    raw.y;


  y =
    479 -
    raw.x;
}


// ============================================================
// LIGHTBAR SCREEN
// ============================================================

void drawLightbarScreen() {

  currentScreen =
    SCREEN_LIGHTBAR;


  lightbarScreenOpenedAt =
    millis();


  lightbarEntryTouchReleased =
    false;


  lightbarNoTouchSince =
    0;


  buttonTouchActive =
    true;


  cancelLightbarPress();


  display.fillScreen(
    COLOR_BLACK
  );


  display.setTextColor(
    COLOR_OBS_GREEN,
    COLOR_BLACK
  );


  display.setTextSize(3);


  display.setCursor(
    20,
    22
  );


  display.print(
    "CODE 3 MX7000"
  );


  refreshLightbarButtons();


  previousAlarmBorderScreen =
    SCREEN_GAUGES;


  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


// ============================================================
// REFRESH BUTTONS
// ============================================================

void refreshLightbarButtons() {

  drawLightbarButton(
    0,
    0,
    "TRAFFIC\nBREAKER",
    getButtonColor(
      CMD_TRAFFICBREAKERS
    )
  );


  drawLightbarButton(
    1,
    0,
    "INNERS",
    getButtonColor(
      CMD_INNERS
    )
  );


  drawLightbarButton(
    2,
    0,
    "INTERMED.",
    getButtonColor(
      CMD_INTERMEDIATES
    )
  );


  drawLightbarButton(
    3,
    0,
    "OUTERS",
    getButtonColor(
      CMD_OUTERS
    )
  );


  drawLightbarButton(
    4,
    0,
    "LEDS",
    getButtonColor(
      CMD_LEDS
    )
  );


  drawLightbarButton(
    0,
    1,
    "CLOSE",
    COLOR_BUTTON_IDLE
  );


  drawLightbarButton(
    1,
    1,
    "TA LEFT",
    getButtonColor(
      CMD_TLEFT
    )
  );


  drawLightbarButton(
    2,
    1,
    "TA OUT",
    getButtonColor(
      CMD_TOUT
    )
  );


  drawLightbarButton(
    3,
    1,
    "TA RIGHT",
    getButtonColor(
      CMD_TRIGHT
    )
  );


  drawLightbarButton(
    4,
    1,
    "MONITOR",
    COLOR_BUTTON_IDLE
  );
}


// ============================================================
// DRAW BUTTON
// ============================================================

void drawLightbarButton(
  int column,
  int row,
  const char *label,
  uint16_t color
) {

  int x =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int y =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  display.fillRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    color
  );


  display.drawRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    color
  );


  if (
    strcmp(
      label,
      "TRAFFIC\nBREAKER"
    ) == 0
  ) {

    display.setTextSize(2);


    display.setCursor(
      x + 22,
      y + 50
    );


    display.print("TRAFFIC");


    display.setCursor(
      x + 22,
      y + 78
    );


    display.print("BREAKER");


    return;
  }


  display.setTextSize(2);


  int textWidth =
    strlen(label) *
    12;


  int tx =
    x +
    (
      BUTTON_W -
      textWidth
    ) /
    2;


  int ty =
    y +
    BUTTON_H /
    2 -
    8;


  display.setCursor(
    tx,
    ty
  );


  display.print(label);
}


// ============================================================
// BUTTON COLOR
// ============================================================

uint16_t getButtonColor(
  int command
) {

  LightbarState &s =
    lightbar[command];


  if (
    s.physical &&
    s.overrideActive
  ) {

    return COLOR_RED;
  }


  if (
    s.physical &&
    s.startupHold
  ) {

    return flashState ?
      COLOR_BLUE :
      COLOR_BLACK;
  }


  if (
    s.physical
  ) {

    return COLOR_BLUE;
  }


  if (
    s.waitingForConfirmation
  ) {

    return flashState ?
      COLOR_PURPLE :
      COLOR_BLACK;
  }


  if (
    s.failed
  ) {

    return COLOR_PURPLE;
  }


  if (
    s.giga &&
    s.megaConfirmed
  ) {

    return COLOR_OBS_GREEN;
  }


  return COLOR_BLACK;
}


// ============================================================
// SEND START / STOP
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  if (
    command < 0 ||
    command >=
    NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  unsigned long now =
    millis();


  s.pendingStart =
    start;


  s.nanoAckPending =
    true;


  s.waitingForConfirmation =
    true;


  s.commandStartedAt =
    now;


  s.commandSentAt =
    now;


  s.failed =
    false;


  s.failureReason[0] =
    '\0';


  // Local requested state.
  // Nano STATE remains authoritative.

  s.giga =
    start;


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    refreshLightbarButtons();
  }


  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    start ?
      "START" :
      "STOP",
    commandNames[command]
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );
}


// ============================================================
// RETRIES
// ============================================================

void retryPendingCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &s =
      lightbar[i];


    if (
      !s.waitingForConfirmation
    ) {

      continue;
    }


    if (
      now -
      s.commandStartedAt >=
      COMMAND_TOTAL_TIMEOUT
    ) {

      s.waitingForConfirmation =
        false;


      s.nanoAckPending =
        false;


      s.failed =
        true;


      strncpy(
        s.failureReason,
        "CONFIRM_TIMEOUT",
        sizeof(
          s.failureReason
        ) - 1
      );


      s.failureReason[
        sizeof(
          s.failureReason
        ) - 1
      ] = '\0';


      char errorMessage[80];


      snprintf(
        errorMessage,
        sizeof(errorMessage),
        "%s %s CONFIRM_TIMEOUT",
        s.pendingStart ?
          "START" :
          "STOP",
        commandNames[i]
      );


      addSerialMessage(
        "ERR",
        errorMessage
      );


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }


      continue;
    }


    if (
      now -
      s.commandSentAt <
      COMMAND_RETRY_INTERVAL
    ) {

      continue;
    }


    s.commandSentAt =
      now;


    s.nanoAckPending =
      true;


    char message[64];


    snprintf(
      message,
      sizeof(message),
      "%s %s",
      s.pendingStart ?
        "START" :
        "STOP",
      commandNames[i]
    );


    NanoSerial.println(
      message
    );


    addSerialMessage(
      "G>N",
      message
    );
  }
}


// ============================================================
// HEARTBEAT
// ============================================================

void sendHeartbeat() {

  unsigned long now =
    millis();


  if (
    now -
    lastHeartbeatSent <
    HEARTBEAT_INTERVAL
  ) {

    return;
  }


  lastHeartbeatSent =
    now;


  NanoSerial.println(
    "GIGA_PING"
  );


  addSerialMessage(
    "G>N",
    "GIGA_PING"
  );
}


void requestSync() {

  NanoSerial.println(
    "SYNC_REQUEST"
  );


  addSerialMessage(
    "G>N",
    "SYNC_REQUEST"
  );
}


// ============================================================
// NANO SERIAL
// ============================================================

void handleNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        addSerialMessage(
          "N>G",
          nanoRxBuffer
        );


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex =
          0;
      }

    } else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;

      } else {

        nanoRxIndex =
          0;


        addSerialMessage(
          "ERR",
          "Nano RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(
  char *line
) {

  bool nanoWasLost =
    isNanoLinkLost();


  lastNanoResponse =
    millis();


  // ==========================================================
  // PONG
  // ==========================================================

  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    if (
      nanoWasLost
    ) {

      requestSync();
    }


    updateAlarmBorder();

    return;
  }


  // ==========================================================
  // NANO BOOT
  // ==========================================================

  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    lastMegaResponse =
      0;


    requestSync();

    updateAlarmBorder();

    return;
  }


  // ==========================================================
  // MEGA PONG
  // ==========================================================

  if (
    strcmp(
      line,
      "DIAG M>N PONG"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    updateAlarmBorder();

    return;
  }


  // ==========================================================
  // MEGA LINK LOST
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    lastMegaResponse =
      0;


    updateAlarmBorder();

    return;
  }


  // ==========================================================
  // MEGA RESTORED
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    updateAlarmBorder();

    return;
  }


  // ==========================================================
  // OVERRIDE ACK
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK OVERRIDE ",
      13
    ) == 0
  ) {

    return;
  }


  // ==========================================================
  // NORMAL ACK
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];

    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        LightbarState &s =
          lightbar[index];


        bool ackStart =
          strcasecmp(
            action,
            "START"
          ) == 0;


        if (
          s.waitingForConfirmation &&
          ackStart ==
          s.pendingStart
        ) {

          s.nanoAckPending =
            false;
        }
      }
    }


    return;
  }


  // ==========================================================
  // OVERRIDE CONFIRMED
  // ==========================================================

  if (
    strncmp(
      line,
      "CONFIRMED OVERRIDE ",
      19
    ) == 0
  ) {

    char commandName[32];

    char stateText[8];


    if (
      sscanf(
        line,
        "CONFIRMED OVERRIDE %31s %7s",
        commandName,
        stateText
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool enabled =
          strcasecmp(
            stateText,
            "ON"
          ) == 0;


        lightbar[
          index
        ].overrideActive =
          enabled &&
          lightbar[
            index
          ].physical;


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // NORMAL CONFIRMED
  //
  // STALE CONFIRMATION PROTECTION
  // ==========================================================

  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    char action[12];

    char commandName[32];


    if (
      sscanf(
        line,
        "CONFIRMED %11s %31s",
        action,
        commandName
      ) != 2
    ) {

      return;
    }


    int index =
      commandIndexFromName(
        commandName
      );


    if (
      index < 0
    ) {

      return;
    }


    LightbarState &s =
      lightbar[index];


    bool confirmedStart =
      strcasecmp(
        action,
        "START"
      ) == 0;


    // --------------------------------------------------------
    // No current transaction:
    // old confirmation cannot alter GIGA state.
    // --------------------------------------------------------

    if (
      !s.waitingForConfirmation
    ) {

      char staleMessage[96];


      snprintf(
        staleMessage,
        sizeof(staleMessage),
        "STALE CONFIRM %s %s",
        confirmedStart ?
          "START" :
          "STOP",
        commandNames[index]
      );


      addSerialMessage(
        "ERR",
        staleMessage
      );


      return;
    }


    // --------------------------------------------------------
    // Opposite confirmation:
    // ignore it and continue waiting.
    // --------------------------------------------------------

    if (
      confirmedStart !=
      s.pendingStart
    ) {

      char staleMessage[96];


      snprintf(
        staleMessage,
        sizeof(staleMessage),
        "STALE CONFIRM %s %s",
        confirmedStart ?
          "START" :
          "STOP",
        commandNames[index]
      );


      addSerialMessage(
        "ERR",
        staleMessage
      );


      return;
    }


    // --------------------------------------------------------
    // Correct confirmation.
    // --------------------------------------------------------

    s.megaConfirmed =
      confirmedStart;


    s.giga =
      confirmedStart;


    s.waitingForConfirmation =
      false;


    s.nanoAckPending =
      false;


    s.failed =
      false;


    s.failureReason[0] =
      '\0';


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      refreshLightbarButtons();
    }


    return;
  }


  // ==========================================================
  // FAILED
  //
  // Does NOT end 30-second retry cycle.
  // ==========================================================

  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    char action[12];

    char commandName[32];

    char reason[32];


    reason[0] =
      '\0';


    int fields =
      sscanf(
        line,
        "FAILED %11s %31s %31s",
        action,
        commandName,
        reason
      );


    if (
      fields >= 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        LightbarState &s =
          lightbar[index];


        bool failedStart =
          strcasecmp(
            action,
            "START"
          ) == 0;


        if (
          s.waitingForConfirmation &&
          failedStart ==
          s.pendingStart
        ) {

          s.nanoAckPending =
            false;


          if (
            fields >= 3
          ) {

            strncpy(
              s.failureReason,
              reason,
              sizeof(
                s.failureReason
              ) - 1
            );


            s.failureReason[
              sizeof(
                s.failureReason
              ) - 1
            ] = '\0';
          }
        }
      }
    }


    return;
  }


  // ==========================================================
  // STATE
  //
  // STATE updates truth but DOES NOT finish pending command.
  // ==========================================================

  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    char commandName[32];

    int p = 0;
    int g = 0;
    int e = 0;
    int m = 0;
    int h = 0;
    int o = 0;


    int fields =
      sscanf(
        line,
        "STATE %31s P=%d G=%d E=%d M=%d H=%d O=%d",
        commandName,
        &p,
        &g,
        &e,
        &m,
        &h,
        &o
      );


    if (
      fields < 6
    ) {

      return;
    }


    int index =
      commandIndexFromName(
        commandName
      );


    if (
      index < 0
    ) {

      return;
    }


    LightbarState &s =
      lightbar[index];


    s.physical =
      p != 0;


    s.giga =
      g != 0;


    s.effective =
      e != 0;


    s.megaConfirmed =
      m != 0;


    s.startupHold =
      h != 0;


    if (
      fields >= 7
    ) {

      s.overrideActive =
        (
          o != 0 &&
          p != 0
        );

    } else if (
      p == 0
    ) {

      s.overrideActive =
        false;
    }


    if (
      !s.physical
    ) {

      s.overrideActive =
        false;
    }


    // IMPORTANT:
    //
    // waitingForConfirmation is NOT changed here.


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      refreshLightbarButtons();
    }


    return;
  }


  // ==========================================================
  // SYNC / DIAG / HOLD
  // ==========================================================

  if (
    strcmp(
      line,
      "SYNC_BEGIN"
    ) == 0 ||
    strcmp(
      line,
      "SYNC_END"
    ) == 0
  ) {

    return;
  }


  if (
    strncmp(
      line,
      "DIAG ",
      5
    ) == 0 ||
    strncmp(
      line,
      "HOLD ",
      5
    ) == 0
  ) {

    return;
  }
}


// ============================================================
// COMMAND LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// SERIAL HISTORY
// ============================================================

void addSerialMessage(
  const char *prefix,
  const char *message
) {

  int index =
    serialHistoryHead;


  snprintf(
    serialHistory[index],
    sizeof(
      serialHistory[index]
    ),
    "%s %s",
    prefix,
    message
  );


  serialHistoryTime[index] =
    millis();


  serialHistoryHead =
    (
      serialHistoryHead +
      1
    ) %
    SERIAL_HISTORY_SIZE;


  if (
    serialHistoryCount <
    SERIAL_HISTORY_SIZE
  ) {

    serialHistoryCount++;
  }


  Serial.print(prefix);
  Serial.print(" ");
  Serial.println(message);
}


// ============================================================
// SERIAL SCREEN
// ============================================================

void drawSerialScreen() {

  currentScreen =
    SCREEN_SERIAL;


  buttonTouchActive =
    true;


  cancelLightbarPress();


  display.fillScreen(
    COLOR_BLACK
  );


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setTextSize(2);


  display.setCursor(
    16,
    15
  );


  display.print(
    "SERIAL MONITOR"
  );


  drawSerialLinkStatus();


  display.drawRect(
    748,
    8,
    42,
    34,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setTextSize(3);


  display.setCursor(
    760,
    12
  );


  display.print("X");


  refreshSerialScreen();


  previousAlarmBorderScreen =
    SCREEN_LIGHTBAR;


  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


// ============================================================
// LINK STATUS
// ============================================================

void drawSerialLinkStatus() {

  bool nanoLost =
    isNanoLinkLost();


  bool megaLost =
    isMegaLinkLost();


  display.fillRect(
    300,
    8,
    430,
    38,
    COLOR_BLACK
  );


  display.setTextSize(2);


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setCursor(
    310,
    15
  );


  display.print("NANO:");


  if (
    nanoLost
  ) {

    display.setTextColor(
      COLOR_RED,
      COLOR_BLACK
    );


    display.print("LOST");

  } else {

    display.setTextColor(
      COLOR_OBS_GREEN,
      COLOR_BLACK
    );


    display.print("OK");
  }


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setCursor(
    500,
    15
  );


  display.print("MEGA:");


  if (
    megaLost
  ) {

    display.setTextColor(
      COLOR_RED,
      COLOR_BLACK
    );


    display.print("LOST");

  } else {

    display.setTextColor(
      COLOR_OBS_GREEN,
      COLOR_BLACK
    );


    display.print("OK");
  }
}


// ============================================================
// REFRESH SERIAL SCREEN
// ============================================================

void refreshSerialScreen() {

  display.fillRect(
    8,
    52,
    784,
    418,
    COLOR_BLACK
  );


  int visible =
    serialHistoryCount;


  if (
    visible > 23
  ) {

    visible = 23;
  }


  int first =
    serialHistoryHead -
    visible;


  while (
    first < 0
  ) {

    first +=
      SERIAL_HISTORY_SIZE;
  }


  int y = 56;


  display.setTextSize(1);


  for (
    int i = 0;
    i < visible;
    i++
  ) {

    int index =
      (
        first +
        i
      ) %
      SERIAL_HISTORY_SIZE;


    unsigned long seconds =
      serialHistoryTime[
        index
      ] /
      1000;


    display.setTextColor(
      COLOR_GRAY,
      COLOR_BLACK
    );


    display.setCursor(
      12,
      y
    );


    char timeText[16];


    snprintf(
      timeText,
      sizeof(timeText),
      "%6lu",
      seconds
    );


    display.print(timeText);


    const char *message =
      serialHistory[index];


    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strncmp(
        message,
        "G>N",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_OBS_GREEN;
    }


    else if (
      strncmp(
        message,
        "N>G",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_BLUE;
    }


    else if (
      strncmp(
        message,
        "ERR",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_RED;
    }


    display.setTextColor(
      directionColor,
      COLOR_BLACK
    );


    display.setCursor(
      62,
      y
    );


    display.print(message);


    y += 17;
  }


  drawSerialLinkStatus();
}


// ============================================================
// SERIAL TOUCH
// ============================================================

void handleSerialTouch(
  int x,
  int y
) {

  if (
    x >= 735 &&
    y <= 55
  ) {

    drawLightbarScreen();
  }
}


// ============================================================
// ALARM BORDER
// ============================================================

void updateAlarmBorder() {

  bool alarm =
    false;


  // ----------------------------------------------------------
  // Gauge:
  // simulation or truck-data timeout ONLY.
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    alarm =
      simulateEngineData ||
      truckDataTimedOut;
  }


  // ----------------------------------------------------------
  // Lightbar / Monitor:
  // Nano or Mega communication loss ONLY.
  // ----------------------------------------------------------

  else if (
    currentScreen ==
    SCREEN_LIGHTBAR ||
    currentScreen ==
    SCREEN_SERIAL
  ) {

    alarm =
      isNanoLinkLost() ||
      isMegaLinkLost();
  }


  bool borderVisible =
    alarm &&
    flashState;


  bool screenChanged =
    previousAlarmBorderScreen !=
    currentScreen;


  if (
    !screenChanged &&
    borderVisible ==
    previousAlarmBorderVisible
  ) {

    return;
  }


  previousAlarmBorderScreen =
    currentScreen;


  previousAlarmBorderVisible =
    borderVisible;


  uint16_t borderColor =
    borderVisible ?
      COLOR_RED :
      COLOR_BLACK;


  display.drawRect(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    borderColor
  );


  display.drawRect(
    1,
    1,
    SCREEN_W - 2,
    SCREEN_H - 2,
    borderColor
  );


  display.drawRect(
    2,
    2,
    SCREEN_W - 4,
    SCREEN_H - 4,
    borderColor
  );
}
