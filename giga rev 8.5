  resetSecretGesture();

  cancelLightbarPress();


  lightbarEntryTouchReleased =
    true;


  lightbarNoTouchSince =
    0;


  buttonTouchActive =
    true;


  display.fillScreen(
    COLOR_BLACK
  );


  drawGaugeStatic();


  previousNeedleIPR = -999;
  previousNeedleICP = -999;

  previousDigitalIPR = -999;
  previousDigitalICP = -999;


  displayedIPR =
    engineData.ipr;


  displayedICP =
    engineData.icp;


  updateGaugeDisplay();


  previousAlarmBorderScreen =
    SCREEN_LIGHTBAR;


  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


