// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(USB_BAUD);

  NanoSerial.begin(NANO_BAUD);

  display.begin();

  display.setRotation(1);

  touch.begin();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    lightbar[i].physical = false;

    lightbar[i].giga = false;

    lightbar[i].effective = false;

    lightbar[i].megaConfirmed = false;

    lightbar[i].startupHold = false;

    lightbar[i].overrideActive = false;

    lightbar[i].failed = false;

    lightbar[i].failureReason[0] = '\0';

    lightbar[i].nanoAckPending = false;

    lightbar[i].pendingStart = false;

    lightbar[i].commandSentAt = 0;

    lightbar[i].commandStartedAt = 0;

    lightbar[i].waitingForConfirmation = false;
  }


  engineData.ipr = 0;
  engineData.icp = 0;

  displayedIPR = 0;
  displayedICP = 0;


  drawGaugeScreen();


  NanoSerial.println(
    "GIGA_PING"
  );


  lastHeartbeatSent =
    millis();


  addSerialMessage(
    "G>N",
    "GIGA_PING"
  );
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  unsigned long now =
    millis();


  handleNanoSerial();

  sendHeartbeat();

  retryPendingCommands();

  handleTouch();

  updateEngineData();


  // ==========================================================
  // TRUCK DATA WATCHDOG
  // ==========================================================

  if (
    !simulateEngineData
  ) {

    if (
      lastTruckDataReceived == 0 ||
      now -
      lastTruckDataReceived >
      TRUCK_DATA_TIMEOUT
    ) {

      truckDataTimedOut = true;

    } else {

      truckDataTimedOut = false;
    }

  } else {

    truckDataTimedOut = false;
  }


  // ==========================================================
  // FLASH TIMER
  // ==========================================================

  if (
    now -
    lastFlashTime >=
    FLASH_INTERVAL
  ) {

    lastFlashTime =
      now;


    flashState =
      !flashState;


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      refreshLightbarButtons();
    }


    if (
      currentScreen ==
      SCREEN_SERIAL
    ) {

      drawSerialLinkStatus();
    }


    updateAlarmBorder();
  }


  // ==========================================================
  // GAUGES
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_GAUGES &&
    now -
    lastGaugeUpdate >=
    GAUGE_UPDATE_INTERVAL
  ) {

    lastGaugeUpdate =
      now;


    updateGaugeDisplay();
  }


  // ==========================================================
  // SERIAL MONITOR
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_SERIAL &&
    now -
    lastSerialScreenDraw >=
    SERIAL_SCREEN_INTERVAL
  ) {

    lastSerialScreenDraw =
      now;


    refreshSerialScreen();
  }


  updateAlarmBorder();
}


// ============================================================
// COMMUNICATION STATE
// ============================================================

bool isNanoLinkLost() {

  if (
    lastNanoResponse == 0
  ) {

    return true;
  }


  return (
    millis() -
    lastNanoResponse >
    NANO_TIMEOUT
  );
}


bool isMegaLinkLost() {

  if (
    isNanoLinkLost()
  ) {

    return true;
  }


  if (
    lastMegaResponse == 0
  ) {

    return true;
  }


  return (
    millis() -
    lastMegaResponse >
    MEGA_TIMEOUT
  );
}


// ============================================================
// ENGINE DATA
// ============================================================

void updateEngineData() {

  if (
    simulateEngineData
  ) {

    float t =
      millis() /
      1000.0;


    engineData.ipr =
      35.0 +
      sin(t * 0.7) * 15.0 +
      sin(t * 2.3) * 2.0;


    engineData.icp =
      1800.0 +
      sin(t * 0.45) * 850.0 +
      sin(t * 1.8) * 100.0;


    if (
      engineData.ipr < 0
    ) {

      engineData.ipr = 0;
    }


    if (
      engineData.ipr > 100
    ) {

      engineData.ipr = 100;
    }


    if (
      engineData.icp < 0
    ) {

      engineData.icp = 0;
    }


    if (
      engineData.icp > 4000
    ) {

      engineData.icp = 4000;
    }
  }
}


void markTruckDataReceived() {

  lastTruckDataReceived =
    millis();


  truckDataTimedOut =
    false;
}


