// ============================================================
// ALARM BORDER
// ============================================================

void updateAlarmBorder() {

  bool alarm =
    false;


  // ----------------------------------------------------------
  // GAUGE SCREEN
  //
  // ONLY:
  //   simulation
  //   truck data timeout
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    alarm =
      simulateEngineData ||
      truckDataTimedOut;
  }


  // ----------------------------------------------------------
  // LIGHTBAR / SERIAL
  //
  // ONLY:
  //   Nano communication lost
  //   Mega communication lost
  // ----------------------------------------------------------

  else if (
    currentScreen ==
    SCREEN_LIGHTBAR ||
    currentScreen ==
    SCREEN_SERIAL
  ) {

    alarm =
      nanoLinkLost ||
      megaLinkLost;
  }


  bool borderVisible =
    alarm &&
    flashState;


  bool screenChanged =
    previousAlarmBorderScreen !=
    currentScreen;


  if (
    !screenChanged &&
    borderVisible ==
    previousAlarmBorderVisible
  ) {

    return;
  }


  previousAlarmBorderScreen =
    currentScreen;


  previousAlarmBorderVisible =
    borderVisible;


  uint16_t borderColor =
    borderVisible ?
    COLOR_RED :
    COLOR_BLACK;


  display.drawRect(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    borderColor
  );


  display.drawRect(
    1,
    1,
    SCREEN_W - 2,
    SCREEN_H - 2,
    borderColor
  );


  display.drawRect(
    2,
    2,
    SCREEN_W - 4,
    SCREEN_H - 4,
    borderColor
  );
}
