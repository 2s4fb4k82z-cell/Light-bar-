// ============================================================
// GAUGE TICKS
// ============================================================

void drawGaugeTicks(
  int cx,
  int cy,
  float minimum,
  float maximum,
  int majorTicks
) {

  for (
    int i = 0;
    i <= majorTicks;
    i++
  ) {

    float ratio =
      (float)i /
      majorTicks;


    float angleDeg =
      135.0 +
      ratio *
      270.0;


    float angle =
      angleDeg *
      PI /
      180.0;


    int outerX =
      cx +
      cos(angle) *
      (GAUGE_RADIUS - 7);


    int outerY =
      cy +
      sin(angle) *
      (GAUGE_RADIUS - 7);


    int innerX =
      cx +
      cos(angle) *
      (GAUGE_RADIUS - 24);


    int innerY =
      cy +
      sin(angle) *
      (GAUGE_RADIUS - 24);


    display.drawLine(
      innerX,
      innerY,
      outerX,
      outerY,
      COLOR_OBS_GREEN
    );


    float value =
      minimum +
      ratio *
      (
        maximum -
        minimum
      );


    char text[12];


    snprintf(
      text,
      sizeof(text),
      "%d",
      (int)value
    );


    int textRadius =
      GAUGE_RADIUS - 45;


    int tx =
      cx +
      cos(angle) *
      textRadius;


    int ty =
      cy +
      sin(angle) *
      textRadius;


    int width =
      strlen(text) *
      6;


    display.setTextColor(
      COLOR_OBS_GREEN,
      COLOR_BLACK
    );


    display.setTextSize(1);


    display.setCursor(
      tx - width / 2,
      ty - 4
    );


    display.print(
      text
    );
  }
}


// ============================================================
// UPDATE GAUGE DISPLAY
// ============================================================

void updateGaugeDisplay() {

  displayedIPR +=
    (
      engineData.ipr -
      displayedIPR
    ) *
    GAUGE_SMOOTHING;


  displayedICP +=
    (
      engineData.icp -
      displayedICP
    ) *
    GAUGE_SMOOTHING;


  // ----------------------------------------------------------
  // IPR NEEDLE
  // ----------------------------------------------------------

  if (
    previousNeedleIPR < -100 ||
    fabs(
      displayedIPR -
      previousNeedleIPR
    ) >=
    IPR_DEADBAND
  ) {

    if (
      previousNeedleIPR >
      -100
    ) {

      drawGaugeNeedle(
        IPR_CENTER_X,
        GAUGE_CENTER_Y,
        previousNeedleIPR,
        0,
        100,
        COLOR_BLACK
      );
    }


    drawGaugeNeedle(
      IPR_CENTER_X,
      GAUGE_CENTER_Y,
      displayedIPR,
      0,
      100,
      COLOR_RED
    );


    previousNeedleIPR =
      displayedIPR;
  }


  // ----------------------------------------------------------
  // ICP NEEDLE
  // ----------------------------------------------------------

  if (
    previousNeedleICP < -100 ||
    fabs(
      displayedICP -
      previousNeedleICP
    ) >=
    ICP_DEADBAND
  ) {

    if (
      previousNeedleICP >
      -100
    ) {

      drawGaugeNeedle(
        ICP_CENTER_X,
        GAUGE_CENTER_Y,
        previousNeedleICP,
        0,
        4000,
        COLOR_BLACK
      );
    }


    drawGaugeNeedle(
      ICP_CENTER_X,
      GAUGE_CENTER_Y,
      displayedICP,
      0,
      4000,
      COLOR_RED
    );


    previousNeedleICP =
      displayedICP;
  }


  // ----------------------------------------------------------
  // DIGITAL VALUES
  // ----------------------------------------------------------

  int digitalIPR =
    (int)round(
      engineData.ipr
    );


  int digitalICP =
    (int)round(
      engineData.icp
    );


  if (
    digitalIPR !=
    previousDigitalIPR
  ) {

    drawDigitalIPR(
      digitalIPR
    );


    previousDigitalIPR =
      digitalIPR;
  }


  if (
    digitalICP !=
    previousDigitalICP
  ) {

    drawDigitalICP(
      digitalICP
    );


    previousDigitalICP =
      digitalICP;
  }
}


// ============================================================
// DRAW GAUGE NEEDLE
// ============================================================

void drawGaugeNeedle(
  int cx,
  int cy,
  float value,
  float minimum,
  float maximum,
  uint16_t color
) {

  if (
    value < minimum
  ) {

    value =
      minimum;
  }


  if (
    value > maximum
  ) {

    value =
      maximum;
  }


  float ratio =
    (
      value -
      minimum
    ) /
    (
      maximum -
      minimum
    );


  float angleDeg =
    135.0 +
    ratio *
    270.0;


  float angle =
    angleDeg *
    PI /
    180.0;


  int needleX =
    cx +
    cos(angle) *
    NEEDLE_LENGTH;


  int needleY =
    cy +
    sin(angle) *
    NEEDLE_LENGTH;


  display.drawLine(
    cx,
    cy,
    needleX,
    needleY,
    color
  );


  display.fillCircle(
    cx,
    cy,
    5,
    color
  );
}


