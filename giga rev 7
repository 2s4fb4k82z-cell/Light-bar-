// ============================================================
// REFRESH SERIAL MONITOR
// ============================================================

void refreshSerialScreen() {

  display.fillRect(
    8,
    52,
    784,
    418,
    COLOR_BLACK
  );


  int visible =
    serialHistoryCount;


  if (
    visible > 23
  ) {

    visible =
      23;
  }


  int first =
    serialHistoryHead -
    visible;


  while (
    first < 0
  ) {

    first +=
      SERIAL_HISTORY_SIZE;
  }


  int y =
    56;


  display.setTextSize(1);


  for (
    int i = 0;
    i < visible;
    i++
  ) {

    int index =
      (
        first +
        i
      ) %
      SERIAL_HISTORY_SIZE;


    unsigned long seconds =
      serialHistoryTime[
        index
      ] /
      1000;


    display.setTextColor(
      COLOR_GRAY,
      COLOR_BLACK
    );


    display.setCursor(
      12,
      y
    );


    char timeText[16];


    snprintf(
      timeText,
      sizeof(timeText),
      "%6lu",
      seconds
    );


    display.print(
      timeText
    );


    const char *message =
      serialHistory[index];


    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strncmp(
        message,
        "G>N",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_OBS_GREEN;
    }


    else if (
      strncmp(
        message,
        "N>G",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_BLUE;
    }


    else if (
      strncmp(
        message,
        "ERR",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_RED;
    }


    display.setTextColor(
      directionColor,
      COLOR_BLACK
    );


    display.setCursor(
      62,
      y
    );


    display.print(
      message
    );


    y +=
      17;
  }


  drawSerialLinkStatus();
}


