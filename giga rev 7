// ============================================================
// DRAW LIGHTBAR BUTTON
// ============================================================

void drawLightbarButton(
  int column,
  int row,
  const char *label,
  uint16_t color
) {

  int x =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int y =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  display.fillRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    color
  );


  display.drawRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    color
  );


  // ----------------------------------------------------------
  // TRAFFIC BREAKER
  // ----------------------------------------------------------

  if (
    strcmp(
      label,
      "TRAFFIC\nBREAKER"
    ) == 0
  ) {

    display.setTextSize(2);


    display.setCursor(
      x + 22,
      y + 50
    );


    display.print(
      "TRAFFIC"
    );


    display.setCursor(
      x + 22,
      y + 78
    );


    display.print(
      "BREAKER"
    );


    return;
  }


  // ----------------------------------------------------------
  // NORMAL LABEL
  // ----------------------------------------------------------

  display.setTextSize(2);


  int textWidth =
    strlen(label) *
    12;


  int tx =
    x +
    (
      BUTTON_W -
      textWidth
    ) /
    2;


  int ty =
    y +
    BUTTON_H /
    2 -
    8;


  display.setCursor(
    tx,
    ty
  );


  display.print(
    label
  );
}


// ============================================================
// BUTTON COLOR / STATE
// ============================================================

uint16_t getButtonColor(
  int command
) {

  LightbarState &s =
    lightbar[command];


  // ==========================================================
  // 1. PHYSICAL SWITCH
  //
  // Physical indication has highest visual priority.
  // ==========================================================

  if (
    s.physical
  ) {

    // Startup-held physical request:
    // FLASHING BLUE

    if (
      s.startupHold
    ) {

      return flashState ?
        COLOR_BLUE :
        COLOR_BLACK;
    }


    // Normal physical request:
    // SOLID BLUE

    return COLOR_BLUE;
  }


  // ==========================================================
  // 2. GIGA COMMAND PENDING
  //
  // FLASHING PURPLE
  // ==========================================================

  if (
    s.waitingForConfirmation
  ) {

    return flashState ?
      COLOR_PURPLE :
      COLOR_BLACK;
  }


  // ==========================================================
  // 3. GIGA COMMAND FAILED
  //
  // SOLID PURPLE
  // ==========================================================

  if (
    s.failed
  ) {

    return COLOR_PURPLE;
  }


  // ==========================================================
  // 4. CONFIRMED GIGA START
  //
  // SOLID GREEN
  // ==========================================================

  if (
    s.giga &&
    s.megaConfirmed
  ) {

    return COLOR_OBS_GREEN;
  }


  // ==========================================================
  // 5. INACTIVE
  // ==========================================================

  return COLOR_BLACK;
}


// ============================================================
// LIGHTBAR TOUCH
// ============================================================

void handleLightbarTouch(
  int x,
  int y
) {

  if (
    !lightbarTouchEnabled()
  ) {

    return;
  }


  int column =
    -1;


  int row =
    -1;


  // ----------------------------------------------------------
  // FIND COLUMN
  // ----------------------------------------------------------

  for (
    int c = 0;
    c < 5;
    c++
  ) {

    int bx =
      BUTTON_START_X +
      c *
      (
        BUTTON_W +
        BUTTON_GAP_X
      );


    if (
      x >= bx &&
      x <
      bx + BUTTON_W
    ) {

      column =
        c;


      break;
    }
  }


  // ----------------------------------------------------------
  // FIND ROW
  // ----------------------------------------------------------

  for (
    int r = 0;
    r < 2;
    r++
  ) {

    int by =
      BUTTON_START_Y +
      r *
      (
        BUTTON_H +
        BUTTON_GAP_Y
      );


    if (
      y >= by &&
      y <
      by + BUTTON_H
    ) {

      row =
        r;


      break;
    }
  }


  if (
    column < 0 ||
    row < 0
  ) {

    return;
  }


  // ==========================================================
  // ROW 1
  // ==========================================================

  if (
    row == 0
  ) {

    int command =
      -1;


    switch (
      column
    ) {

      case 0:

        command =
          CMD_TRAFFICBREAKERS;

        break;


      case 1:

        command =
          CMD_INNERS;

        break;


      case 2:

        command =
          CMD_INTERMEDIATES;

        break;


      case 3:

        command =
          CMD_OUTERS;

        break;


      case 4:

        command =
          CMD_LEDS;

        break;
    }


    if (
      command >= 0
    ) {

      sendGigaCommand(
        command,
        !lightbar[command].giga
      );
    }


    return;
  }


  // ==========================================================
  // ROW 2
  // ==========================================================

  switch (
    column
  ) {

    // --------------------------------------------------------
    // CLOSE -> GAUGE SCREEN
    // --------------------------------------------------------

    case 0:

      drawGaugeScreen();

      break;


    // --------------------------------------------------------
    // TA LEFT
    // --------------------------------------------------------

    case 1:

      sendGigaCommand(
        CMD_TLEFT,
        !lightbar[
          CMD_TLEFT
        ].giga
      );

      break;


    // --------------------------------------------------------
    // TA OUT
    // --------------------------------------------------------

    case 2:

      sendGigaCommand(
        CMD_TOUT,
        !lightbar[
          CMD_TOUT
        ].giga
      );

      break;


    // --------------------------------------------------------
    // TA RIGHT
    // --------------------------------------------------------

    case 3:

      sendGigaCommand(
        CMD_TRIGHT,
        !lightbar[
          CMD_TRIGHT
        ].giga
      );

      break;


    // --------------------------------------------------------
    // MONITOR
    // --------------------------------------------------------

    case 4:

      drawSerialScreen();

      break;
  }
}


// ============================================================
// SEND GIGA COMMAND
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  if (
    command < 0 ||
    command >=
    NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  unsigned long now =
    millis();


  // ==========================================================
  // BEGIN NEW TRANSACTION
  // ==========================================================

  s.pendingStart =
    start;


  s.nanoAckPending =
    true;


  s.waitingForConfirmation =
    true;


  s.commandStartedAt =
    now;


  s.commandSentAt =
    now;


  // Clear any previous terminal failure.

  s.failed =
    false;


  s.failureReason[0] =
    '\0';


  // Store desired GIGA state immediately.

  s.giga =
    start;


  // ==========================================================
  // IMMEDIATELY DISPLAY FLASHING PURPLE
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    refreshLightbarButtons();
  }


  // ==========================================================
  // TRANSMIT COMMAND
  // ==========================================================

  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    start ?
      "START" :
      "STOP",
    commandNames[command]
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );
}


// ============================================================
// RETRY PENDING GIGA COMMANDS
// ============================================================

void retryPendingCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &s =
      lightbar[i];


    // --------------------------------------------------------
    // NOTHING PENDING
    // --------------------------------------------------------

    if (
      !s.waitingForConfirmation
    ) {

      continue;
    }


    // ========================================================
    // 30-SECOND TOTAL TIMEOUT
    // ========================================================

    if (
      now -
      s.commandStartedAt >=
      COMMAND_TOTAL_TIMEOUT
    ) {

      s.waitingForConfirmation =
        false;


      s.nanoAckPending =
        false;


      s.failed =
        true;


      strncpy(
        s.failureReason,
        "CONFIRM_TIMEOUT",
        sizeof(
          s.failureReason
        ) - 1
      );


      s.failureReason[
        sizeof(
          s.failureReason
        ) - 1
      ] = '\0';


      // ------------------------------------------------------
      // SERIAL MONITOR ERROR
      // ------------------------------------------------------

      char errorMessage[80];


      snprintf(
        errorMessage,
        sizeof(errorMessage),
        "%s %s CONFIRM TIMEOUT",
        s.pendingStart ?
          "START" :
          "STOP",
        commandNames[i]
      );


      addSerialMessage(
        "ERR",
        errorMessage
      );


      // ------------------------------------------------------
      // SOLID PURPLE
      // ------------------------------------------------------

      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }


      continue;
    }


    // ========================================================
    // WAIT UNTIL NEXT 5-SECOND RETRY
    // ========================================================

    if (
      now -
      s.commandSentAt <
      COMMAND_RETRY_INTERVAL
    ) {

      continue;
    }


    // ========================================================
    // RESEND COMMAND
    // ========================================================

    s.commandSentAt =
      now;


    s.nanoAckPending =
      true;


    char message[64];


    snprintf(
      message,
      sizeof(message),
      "%s %s",
      s.pendingStart ?
        "START" :
        "STOP",
      commandNames[i]
    );


    NanoSerial.println(
      message
    );


    addSerialMessage(
      "G>N",
      message
    );
  }
}


// ============================================================
// HEARTBEAT
