    "SYNC_REQUEST"
  );
}


// ============================================================
// HANDLE NANO SERIAL
// ============================================================

void handleNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        addSerialMessage(
          "N>G",
          nanoRxBuffer
        );


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex =
          0;
      }

    } else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;

      } else {

        nanoRxIndex =
          0;


        addSerialMessage(
          "ERR",
          "Nano RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(
  char *line
) {

  // ==========================================================
  // ANY COMPLETE NANO MESSAGE PROVES NANO IS ALIVE
  // ==========================================================

  lastNanoResponse =
    millis();


  bool nanoWasLost =
    nanoLinkLost;


  nanoLinkLost =
    false;


  // ----------------------------------------------------------
  // GIGA PONG
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    if (
      nanoWasLost
    ) {

      requestSync();
    }


    updateAlarmBorder();


    return;
  }


  // ----------------------------------------------------------
  // NANO BOOT
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    requestSync();


    updateAlarmBorder();


    return;
  }


  // ----------------------------------------------------------
  // FORWARDED MEGA PONG
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "DIAG M>N PONG"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    megaLinkLost =
      false;


    updateAlarmBorder();


    return;
  }


  // ----------------------------------------------------------
  // MEGA LINK LOST
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    megaLinkLost =
      true;


    updateAlarmBorder();


    return;
  }


  // ----------------------------------------------------------
  // MEGA LINK RESTORED
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    megaLinkLost =
      false;


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // ACK
  //
  // Nano ACK does NOT stop purple flashing or retries.
  //
  // Only CONFIRMED ends a successful transaction.
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].nanoAckPending =
          false;
      }
    }


    return;
  }


  // ==========================================================
  // CONFIRMED
  // ==========================================================

  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "CONFIRMED %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool start =
          strcasecmp(
            action,
            "START"
          ) == 0;


        // ----------------------------------------------------
        // FINAL CONFIRMED STATE
        // ----------------------------------------------------

        lightbar[
          index
        ].megaConfirmed =
          start;


        lightbar[
          index
        ].giga =
          start;


        // ----------------------------------------------------
        // END TRANSACTION
        // ----------------------------------------------------

        lightbar[
          index
        ].waitingForConfirmation =
          false;


        lightbar[
          index
        ].nanoAckPending =
          false;


        lightbar[
          index
        ].failed =
          false;


        lightbar[
          index
        ].failureReason[0] =
          '\0';


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // FAILED
  //
  // IMPORTANT:
  //
  // This only means the individual Nano/Mega attempt failed.
  //
  // The GIGA continues retrying every 5 seconds until the
  // overall 30-second timer expires.
  // ==========================================================

  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    char action[12];
    char commandName[32];
    char reason[32];


    reason[0] =
      '\0';


    int fields =
      sscanf(
        line,
        "FAILED %11s %31s %31s",
        action,
        commandName,
        reason
      );


    if (
      fields >= 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        // Latest attempt is no longer awaiting initial ACK.

        lightbar[
          index
        ].nanoAckPending =
          false;


        // DO NOT:
        //
        //   clear waitingForConfirmation
        //   set failed = true
        //
        // GIGA retry system remains active.


        if (
          fields >= 3
        ) {

          strncpy(
            lightbar[
              index
            ].failureReason,
            reason,
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          );


          lightbar[
            index
          ].failureReason[
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          ] = '\0';
        }


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // STATE
  // ==========================================================

  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    char commandName[32];

    int p;
    int g;
    int e;
    int m;
    int h;


    if (
      sscanf(
        line,
        "STATE %31s P=%d G=%d E=%d M=%d H=%d",
        commandName,
        &p,
        &g,
        &e,
        &m,
        &h
      ) == 6
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].physical =
          p != 0;


        lightbar[
          index
        ].giga =
          g != 0;


        lightbar[
          index
        ].effective =
          e != 0;


        lightbar[
          index
        ].megaConfirmed =
          m != 0;


        lightbar[
          index
        ].startupHold =
          h != 0;


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // SYNC
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "SYNC_BEGIN"
    ) == 0
  ) {

    return;
  }


  if (
    strcmp(
      line,
      "SYNC_END"
    ) == 0
  ) {

    return;
  }


  // ----------------------------------------------------------
  // DIAGNOSTICS / HOLD
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "DIAG ",
      5
    ) == 0 ||
    strncmp(
      line,
      "HOLD ",
      5
    ) == 0
  ) {

    return;
  }
}


// ============================================================
// COMMAND LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// SERIAL HISTORY
// ============================================================

void addSerialMessage(
  const char *prefix,
  const char *message
) {

  int index =
    serialHistoryHead;


  snprintf(
    serialHistory[index],
    sizeof(
      serialHistory[index]
    ),
    "%s %s",
    prefix,
    message
  );


  serialHistoryTime[index] =
    millis();


  serialHistoryHead =
    (
      serialHistoryHead +
      1
    ) %
    SERIAL_HISTORY_SIZE;


  if (
    serialHistoryCount <
    SERIAL_HISTORY_SIZE
  ) {

    serialHistoryCount++;
  }


  Serial.print(
    prefix
  );


  Serial.print(
    " "
  );


  Serial.println(
    message
  );
}


