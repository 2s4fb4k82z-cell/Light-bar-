// TOUCH HANDLING
// ============================================================

void handleTouch() {

  uint8_t contacts =
    touch.getTouchPoints(
      touchPoints
    );


  // ----------------------------------------------------------
  // GAUGE SCREEN
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    handleSecretGesture(
      contacts,
      touchPoints
    );


    return;
  }


  // ----------------------------------------------------------
  // LIGHTBAR ENTRY RELEASE
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_LIGHTBAR &&
    !lightbarEntryTouchReleased
  ) {

    updateLightbarEntryRelease(
      contacts
    );


    return;
  }


  // ----------------------------------------------------------
  // NO TOUCH
  // ----------------------------------------------------------

  if (
    contacts == 0
  ) {

    buttonTouchActive =
      false;


    return;
  }


  // ----------------------------------------------------------
  // ONE ACTIVATION PER TOUCH
  // ----------------------------------------------------------

  if (
    buttonTouchActive
  ) {

    return;
  }


  buttonTouchActive =
    true;


  int x;
  int y;


  mapTouchPoint(
    touchPoints[0],
    x,
    y
  );


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    if (
      !lightbarTouchEnabled()
    ) {

      return;
    }


    handleLightbarTouch(
      x,
      y
    );
  }


  else if (
    currentScreen ==
    SCREEN_SERIAL
  ) {

    handleSerialTouch(
      x,
      y
    );
  }
}


// ============================================================
// SECRET TWO-FINGER GESTURE
// ============================================================

void handleSecretGesture(
  uint8_t contacts,
  GDTpoint_t *points
) {

  unsigned long now =
    millis();


  if (
    contacts >= 2
  ) {

    float averageRawX =
      (
        (float)points[0].x +
        (float)points[1].x
      ) /
      2.0;


    int separation =
      abs(
        (int)points[0].y -
        (int)points[1].y
      );


    secretLastValidTouch =
      now;


    if (
      secretGestureLocked
    ) {

      return;
    }


    // --------------------------------------------------------
    // START
    // --------------------------------------------------------

    if (
      !secretGestureTracking
    ) {

      if (
        averageRawX >=
        SECRET_START_RAW_X_MIN &&

        averageRawX <=
        SECRET_START_RAW_X_MAX &&

        separation >=
        SECRET_MIN_FINGER_SEPARATION
      ) {

        secretGestureTracking =
          true;


        secretGestureTriggered =
          false;


        secretStartRawX =
          averageRawX;


        secretLowestRawX =
          averageRawX;
      }


      return;
    }


    // --------------------------------------------------------
    // TRACK
    // --------------------------------------------------------

    if (
      averageRawX <
      secretLowestRawX
    ) {

      secretLowestRawX =
        averageRawX;
    }


    float downwardTravel =
      secretStartRawX -
      secretLowestRawX;


    // --------------------------------------------------------
    // TRIGGER
    // --------------------------------------------------------

    if (
      !secretGestureTriggered &&
      downwardTravel >=
      SECRET_SWIPE_DISTANCE
    ) {

      secretGestureTriggered =
        true;


      secretGestureLocked =
        true;


      drawLightbarScreen();


      return;
    }


    return;
  }


  // ----------------------------------------------------------
  // TEMPORARY TOUCH DROPOUT
  // ----------------------------------------------------------

  if (
    secretGestureTracking ||
    secretGestureLocked
  ) {

    if (
      now -
      secretLastValidTouch >
      TOUCH_RELEASE_GRACE
    ) {

      resetSecretGesture();
    }
  }
}


// ============================================================
// RESET SECRET GESTURE
// ============================================================

void resetSecretGesture() {

  secretGestureTracking =
    false;


  secretGestureTriggered =
    false;


  secretGestureLocked =
    false;


  secretStartRawX =
    0;


  secretLowestRawX =
    0;


  secretLastValidTouch =
    0;
}


// ============================================================
// LIGHTBAR ENTRY RELEASE DETECTOR
// ============================================================

void updateLightbarEntryRelease(
  uint8_t contacts
) {

  unsigned long now =
    millis();


  if (
    contacts > 0
  ) {

    lightbarNoTouchSince =
      0;


    return;
  }


  if (
    lightbarNoTouchSince == 0
  ) {

    lightbarNoTouchSince =
      now;


    return;
  }


  if (
    now -
    lightbarNoTouchSince >=
    LIGHTBAR_RELEASE_TIME
  ) {

    lightbarEntryTouchReleased =
      true;


    lightbarNoTouchSince =
      0;


    buttonTouchActive =
      false;
  }
}


// ============================================================
// LIGHTBAR TOUCH ENABLED
// ============================================================

bool lightbarTouchEnabled() {

  if (
    !lightbarEntryTouchReleased
  ) {

    return false;
  }


  if (
    millis() -
    lightbarScreenOpenedAt <
    LIGHTBAR_TOUCH_LOCKOUT
  ) {

    return false;
  }


  return true;
}


// ============================================================
// TOUCH MAPPING
// ============================================================

void mapTouchPoint(
  const GDTpoint_t &raw,
  int &x,
  int &y
) {

  x =
    raw.y;


  y =
    479 -
    raw.x;
}


