    COLOR_BLACK
  );


  display.setTextSize(2);


  display.setCursor(
    16,
    15
  );


  display.print(
    "SERIAL MONITOR"
  );


  drawSerialLinkStatus();


  display.drawRect(
    748,
    8,
    42,
    34,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setTextSize(3);


  display.setCursor(
    760,
    12
  );


  display.print(
    "X"
  );


  refreshSerialScreen();


  previousAlarmBorderScreen =
    SCREEN_LIGHTBAR;


  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


// ============================================================
// SERIAL LINK STATUS
// ============================================================

void drawSerialLinkStatus() {

  bool nanoLost =
    isNanoLinkLost();


  bool megaLost =
    isMegaLinkLost();


  display.fillRect(
    300,
    8,
    430,
    38,
    COLOR_BLACK
  );


  display.setTextSize(2);


  // ----------------------------------------------------------
  // NANO
  // ----------------------------------------------------------

  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setCursor(
    310,
    15
  );


  display.print(
    "NANO:"
  );


  if (
    nanoLost
  ) {

    display.setTextColor(
      COLOR_RED,
      COLOR_BLACK
    );


    display.print(
      "LOST"
    );

  } else {

    display.setTextColor(
      COLOR_OBS_GREEN,
      COLOR_BLACK
    );


    display.print(
      "OK"
    );
  }


  // ----------------------------------------------------------
  // MEGA
  // ----------------------------------------------------------

  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setCursor(
    500,
    15
  );


  display.print(
    "MEGA:"
  );


  if (
    megaLost
  ) {

    display.setTextColor(
      COLOR_RED,
      COLOR_BLACK
    );


    display.print(
      "LOST"
    );

  } else {

    display.setTextColor(
      COLOR_OBS_GREEN,
      COLOR_BLACK
    );


    display.print(
      "OK"
    );
  }
}


// ============================================================
// REFRESH SERIAL MONITOR
// ============================================================

void refreshSerialScreen() {

  display.fillRect(
    8,
    52,
    784,
    418,
    COLOR_BLACK
  );


  int visible =
    serialHistoryCount;


  if (
    visible > 23
  ) {

    visible = 23;
  }


  int first =
    serialHistoryHead -
    visible;


  while (
    first < 0
  ) {

    first +=
      SERIAL_HISTORY_SIZE;
  }


  int y = 56;


  display.setTextSize(1);


  for (
    int i = 0;
    i < visible;
    i++
  ) {

    int index =
      (
        first +
        i
      ) %
      SERIAL_HISTORY_SIZE;


    unsigned long seconds =
      serialHistoryTime[
        index
      ] /
      1000;


    display.setTextColor(
      COLOR_GRAY,
      COLOR_BLACK
    );


    display.setCursor(
      12,
      y
    );


    char timeText[16];


    snprintf(
      timeText,
      sizeof(timeText),
      "%6lu",
      seconds
    );


    display.print(
      timeText
    );


    const char *message =
      serialHistory[index];


    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strncmp(
        message,
        "G>N",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_OBS_GREEN;
    }


    else if (
      strncmp(
        message,
        "N>G",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_BLUE;
    }


    else if (
      strncmp(
        message,
        "ERR",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_RED;
    }


    display.setTextColor(
      directionColor,
      COLOR_BLACK
    );


    display.setCursor(
      62,
      y
    );


    display.print(
      message
    );


    y += 17;
  }


  drawSerialLinkStatus();
}


// ============================================================
// SERIAL TOUCH
// ============================================================

void handleSerialTouch(
  int x,
  int y
) {

  // X returns to LIGHTBAR, not gauges.

  if (
    x >= 735 &&
    y <= 55
  ) {

    drawLightbarScreen();
  }
}


// ============================================================
// ALARM BORDER
// ============================================================

void updateAlarmBorder() {

  bool alarm =
    false;


  // ----------------------------------------------------------
  // GAUGE:
  //
  // ONLY engine simulation or truck-data timeout.
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    alarm =
      simulateEngineData ||
      truckDataTimedOut;
  }


  // ----------------------------------------------------------
  // LIGHTBAR / SERIAL:
  //
  // ONLY Nano or Mega communications.
  // ----------------------------------------------------------

  else if (
    currentScreen ==
    SCREEN_LIGHTBAR ||
    currentScreen ==
    SCREEN_SERIAL
  ) {

    alarm =
      isNanoLinkLost() ||
      isMegaLinkLost();
  }


  bool borderVisible =
    alarm &&
    flashState;


  bool screenChanged =
    previousAlarmBorderScreen !=
    currentScreen;


  if (
    !screenChanged &&
    borderVisible ==
    previousAlarmBorderVisible
  ) {

    return;
  }


  previousAlarmBorderScreen =
    currentScreen;


  previousAlarmBorderVisible =
    borderVisible;


  uint16_t borderColor =
    borderVisible ?
      COLOR_RED :
      COLOR_BLACK;


  display.drawRect(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    borderColor
  );


  display.drawRect(
    1,
    1,
    SCREEN_W - 2,
    SCREEN_H - 2,
    borderColor
  );


  display.drawRect(
    2,
    2,
    SCREEN_W - 4,
    SCREEN_H - 4,
    borderColor
  );
}
