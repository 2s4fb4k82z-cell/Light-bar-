// ============================================================
// TOUCH HANDLING
// ============================================================

void handleTouch() {

  uint8_t contacts =
    touch.getTouchPoints(
      touchPoints
    );


  // ----------------------------------------------------------
  // GAUGE
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    handleSecretGesture(
      contacts,
      touchPoints
    );


    return;
  }


  // ----------------------------------------------------------
  // LIGHTBAR ENTRY RELEASE PROTECTION
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_LIGHTBAR &&
    !lightbarEntryTouchReleased
  ) {

    updateLightbarEntryRelease(
      contacts
    );


    return;
  }


  // ==========================================================
  // LIGHTBAR
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    if (
      !lightbarTouchEnabled()
    ) {

      return;
    }


    // --------------------------------------------------------
    // RELEASE
    // --------------------------------------------------------

    if (
      contacts == 0
    ) {

      if (
        lightbarPressActive
      ) {

        finishLightbarPress();
      }


      buttonTouchActive =
        false;


      return;
    }


    int x;
    int y;


    mapTouchPoint(
      touchPoints[0],
      x,
      y
    );


    // --------------------------------------------------------
    // START PRESS
    // --------------------------------------------------------

    if (
      !lightbarPressActive
    ) {

      handleLightbarPress(
        x,
        y
      );


      return;
    }


    // --------------------------------------------------------
    // CONTINUE / HOLD
    // --------------------------------------------------------

    updateLightbarPress(
      contacts,
      x,
      y
    );


    return;
  }


  // ==========================================================
  // SERIAL MONITOR
  // ==========================================================

  if (
    currentScreen ==
    SCREEN_SERIAL
  ) {

    if (
      contacts == 0
    ) {

      buttonTouchActive =
        false;


      return;
    }


    if (
      buttonTouchActive
    ) {

      return;
    }


    buttonTouchActive =
      true;


    int x;
    int y;


    mapTouchPoint(
      touchPoints[0],
      x,
      y
    );


    handleSerialTouch(
      x,
      y
    );
  }
}


// ============================================================
// START LIGHTBAR PRESS
// ============================================================

void handleLightbarPress(
  int x,
  int y
) {

  int column = -1;
  int row    = -1;


  for (
    int c = 0;
    c < 5;
    c++
  ) {

    int bx =
      BUTTON_START_X +
      c *
      (
        BUTTON_W +
        BUTTON_GAP_X
      );


    if (
      x >= bx &&
      x <
      bx + BUTTON_W
    ) {

      column = c;

      break;
    }
  }


  for (
    int r = 0;
    r < 2;
    r++
  ) {

    int by =
      BUTTON_START_Y +
      r *
      (
        BUTTON_H +
        BUTTON_GAP_Y
      );


    if (
      y >= by &&
      y <
      by + BUTTON_H
    ) {

      row = r;

      break;
    }
  }


  if (
    column < 0 ||
    row < 0
  ) {

    return;
  }


  lightbarPressActive =
    true;


  lightbarPressedColumn =
    column;


  lightbarPressedRow =
    row;


  lightbarPressedCommand =
    getLightbarCommandAt(
      column,
      row
    );


  lightbarPressStartedAt =
    millis();


  lightbarLongPressHandled =
    false;
}


// ============================================================
// UPDATE LIGHTBAR PRESS / DETECT HOLD
// ============================================================

void updateLightbarPress(
  uint8_t contacts,
  int x,
  int y
) {

  if (
    !lightbarPressActive
  ) {

    return;
  }


  // ----------------------------------------------------------
  // Finger moved outside original button.
  // Cancel this press.
  // ----------------------------------------------------------

  if (
    !pointInsideLightbarButton(
      x,
      y,
      lightbarPressedColumn,
      lightbarPressedRow
    )
  ) {

    lightbarPressActive =
      false;


    lightbarPressedColumn =
      -1;


    lightbarPressedRow =
      -1;


    lightbarPressedCommand =
      -1;


    return;
  }


  // ----------------------------------------------------------
  // Long hold only applies to actual command buttons.
  // ----------------------------------------------------------

  if (
    lightbarPressedCommand < 0
  ) {

    return;
  }


  if (
    lightbarLongPressHandled
  ) {

    return;
  }


  if (
    millis() -
    lightbarPressStartedAt <
    OVERRIDE_HOLD_TIME
  ) {

    return;
  }


  LightbarState &s =
    lightbar[
      lightbarPressedCommand
    ];


  // ----------------------------------------------------------
  // Physical switch must currently be ON.
  //
  // This covers:
  //   solid blue
  //   flashing blue
  //   red
  // ----------------------------------------------------------

  if (
    s.physical
  ) {

    lightbarLongPressHandled =
      true;


    executeLightbarLongPress(
      lightbarPressedCommand
    );
  }
}


// ============================================================
// FINISH LIGHTBAR PRESS
// ============================================================

void finishLightbarPress() {

  if (
    !lightbarPressActive
  ) {

    return;
  }


  int column =
    lightbarPressedColumn;


  int row =
    lightbarPressedRow;


  int command =
    lightbarPressedCommand;


  bool longHandled =
    lightbarLongPressHandled;


  lightbarPressActive =
    false;


  lightbarPressedColumn =
    -1;


  lightbarPressedRow =
    -1;


  lightbarPressedCommand =
    -1;


  lightbarLongPressHandled =
    false;


  // ----------------------------------------------------------
  // Long press already performed override.
  // Do NOT also execute short press.
  // ----------------------------------------------------------

  if (
    longHandled
  ) {

    return;
  }


  // ----------------------------------------------------------
  // If physical switch is active, a short tap intentionally
  // does nothing.
  //
  // Physical control is changed only with long press.
  // ----------------------------------------------------------

  if (
    command >= 0 &&
    lightbar[command].physical
  ) {

    return;
  }


  executeLightbarShortPress(
    column,
    row,
    command
  );
}


// ============================================================
// LIGHTBAR SHORT PRESS
// ============================================================

void executeLightbarShortPress(
  int column,
  int row,
  int command
) {

  // ==========================================================
  // ROW 1 NORMAL COMMANDS
  // ==========================================================

  if (
    row == 0
  ) {

    if (
      command >= 0
    ) {

      sendGigaCommand(
        command,
        !lightbar[
          command
        ].giga
      );
    }


    return;
  }


  // ==========================================================
  // ROW 2
  // ==========================================================

  switch (
    column
  ) {

    // CLOSE
    case 0:

      drawGaugeScreen();

      break;


    // TA LEFT
    case 1:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // TA OUT
    case 2:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // TA RIGHT
    case 3:

      if (
        command >= 0
      ) {

        sendGigaCommand(
          command,
          !lightbar[
            command
          ].giga
        );
      }

      break;


    // MONITOR
    case 4:

      drawSerialScreen();

      break;
  }
}


// ============================================================
// LIGHTBAR LONG PRESS
// ============================================================

void executeLightbarLongPress(
  int command
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  if (
    !s.physical
  ) {

    return;
  }


  // ----------------------------------------------------------
  // BLUE / FLASHING BLUE:
  // Apply physical override.
  // ----------------------------------------------------------

  if (
    !s.overrideActive
  ) {

    sendPhysicalOverride(
      command,
      true
    );


    return;
  }


  // ----------------------------------------------------------
  // RED:
  // Remove physical override.
  // ----------------------------------------------------------

  sendPhysicalOverride(
    command,
    false
  );
}


// ============================================================
// COMMAND ASSOCIATED WITH BUTTON
// ============================================================

int getLightbarCommandAt(
  int column,
  int row
) {

  if (
    row == 0
  ) {

    switch (
      column
    ) {

      case 0:
        return CMD_TRAFFICBREAKERS;

      case 1:
        return CMD_INNERS;

      case 2:
        return CMD_INTERMEDIATES;

      case 3:
        return CMD_OUTERS;

      case 4:
        return CMD_LEDS;
    }
  }


  if (
    row == 1
  ) {

    switch (
      column
    ) {

      case 1:
        return CMD_TLEFT;

      case 2:
        return CMD_TOUT;

      case 3:
        return CMD_TRIGHT;
    }
  }


  return -1;
}


// ============================================================
// POINT INSIDE BUTTON
// ============================================================

bool pointInsideLightbarButton(
  int x,
  int y,
  int column,
  int row
) {

  if (
    column < 0 ||
    column >= 5 ||
    row < 0 ||
    row >= 2
  ) {

    return false;
  }


  int bx =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int by =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  return (
    x >= bx &&
    x <
    bx + BUTTON_W &&
    y >= by &&
    y <
    by + BUTTON_H
  );
}


// ============================================================
// SEND PHYSICAL OVERRIDE
// ============================================================

void sendPhysicalOverride(
  int command,
  bool enable
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  char message[80];


  snprintf(
    message,
    sizeof(message),
    "OVERRIDE %s %s",
    commandNames[command],
    enable ?
      "ON" :
      "OFF"
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );


  /*
    IMPORTANT:

    We deliberately do NOT change overrideActive locally.

    Nano is authoritative.

    Button becomes RED only after Nano reports:

      STATE <COMMAND> ... O=1

    and returns from RED only after Nano reports:

      STATE <COMMAND> ... O=0

    This prevents the display from claiming an override exists
    when the Nano never actually received it.
  */
}


// ============================================================
// SECRET TWO-FINGER GESTURE
// ============================================================

void handleSecretGesture(
  uint8_t contacts,
  GDTpoint_t *points
) {

  unsigned long now =
    millis();


  if (
    contacts >= 2
  ) {

    float averageRawX =
      (
        (float)points[0].x +
        (float)points[1].x
      ) /
      2.0;


    int separation =
      abs(
        (int)points[0].y -
        (int)points[1].y
      );


    secretLastValidTouch =
      now;


    if (
      secretGestureLocked
    ) {

      return;
    }


    if (
      !secretGestureTracking
    ) {

      if (
        averageRawX >=
        SECRET_START_RAW_X_MIN &&

        averageRawX <=
        SECRET_START_RAW_X_MAX &&

        separation >=
        SECRET_MIN_FINGER_SEPARATION
      ) {

        secretGestureTracking =
          true;


        secretGestureTriggered =
          false;


        secretStartRawX =
          averageRawX;


        secretLowestRawX =
          averageRawX;
      }


      return;
    }


    if (
      averageRawX <
      secretLowestRawX
    ) {

      secretLowestRawX =
        averageRawX;
    }


    float downwardTravel =
      secretStartRawX -
      secretLowestRawX;


    if (
      !secretGestureTriggered &&
      downwardTravel >=
      SECRET_SWIPE_DISTANCE
    ) {

      secretGestureTriggered =
        true;


      secretGestureLocked =
        true;


      drawLightbarScreen();


      return;
    }


    return;
  }


  if (
    secretGestureTracking ||
    secretGestureLocked
  ) {

    if (
      now -
      secretLastValidTouch >
      TOUCH_RELEASE_GRACE
    ) {

      resetSecretGesture();
    }
  }
}


// ============================================================
// RESET SECRET GESTURE
// ============================================================

void resetSecretGesture() {

  secretGestureTracking =
    false;


  secretGestureTriggered =
    false;


  secretGestureLocked =
    false;


  secretStartRawX =
    0;


  secretLowestRawX =
    0;


  secretLastValidTouch =
    0;
}


// ============================================================
// LIGHTBAR ENTRY RELEASE DETECTOR
// ============================================================

void updateLightbarEntryRelease(
  uint8_t contacts
) {

  unsigned long now =
    millis();


  if (
    contacts > 0
  ) {

    lightbarNoTouchSince =
      0;


    return;
  }


  if (
    lightbarNoTouchSince == 0
  ) {

    lightbarNoTouchSince =
      now;


    return;
  }


  if (
    now -
    lightbarNoTouchSince >=
    LIGHTBAR_RELEASE_TIME
  ) {

    lightbarEntryTouchReleased =
      true;


    lightbarNoTouchSince =
      0;


    buttonTouchActive =
      false;


    lightbarPressActive =
      false;
  }
}


// ============================================================
// LIGHTBAR TOUCH ENABLED
// ============================================================

bool lightbarTouchEnabled() {

  if (
    !lightbarEntryTouchReleased
  ) {

    return false;
  }


  if (
    millis() -
    lightbarScreenOpenedAt <
    LIGHTBAR_TOUCH_LOCKOUT
  ) {

    return false;
  }


  return true;
}


// ============================================================
// TOUCH MAPPING
// ============================================================

void mapTouchPoint(
  const GDTpoint_t &raw,
  int &x,
  int &y
) {

  x =
    raw.y;


  y =
    479 -
    raw.x;
}


// ============================================================
// DRAW LIGHTBAR SCREEN
// ============================================================

void drawLightbarScreen() {

  currentScreen =
    SCREEN_LIGHTBAR;


  lightbarScreenOpenedAt =
    millis();


  lightbarEntryTouchReleased =
    false;


  lightbarNoTouchSince =
    0;


  buttonTouchActive =
    true;


  lightbarPressActive =
    false;


  lightbarPressedColumn =
    -1;


  lightbarPressedRow =
    -1;


  lightbarPressedCommand =
    -1;


  lightbarLongPressHandled =
    false;


  display.fillScreen(
    COLOR_BLACK
  );


  display.setTextColor(
    COLOR_OBS_GREEN,
    COLOR_BLACK
  );


  display.setTextSize(3);


  display.setCursor(
    20,
    22
  );


  display.print(
    "CODE 3 MX7000"
  );


  refreshLightbarButtons();


  previousAlarmBorderScreen =
    SCREEN_GAUGES;


  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


// ============================================================
// REFRESH LIGHTBAR BUTTONS
// ============================================================

void refreshLightbarButtons() {

  drawLightbarButton(
    0,
    0,
    "TRAFFIC\nBREAKER",
    getButtonColor(
      CMD_TRAFFICBREAKERS
    )
  );


  drawLightbarButton(
    1,
    0,
    "INNERS",
    getButtonColor(
      CMD_INNERS
    )
  );


  drawLightbarButton(
    2,
    0,
    "INTERMED.",
    getButtonColor(
      CMD_INTERMEDIATES
    )
  );


  drawLightbarButton(
    3,
    0,
    "OUTERS",
    getButtonColor(
      CMD_OUTERS
    )
  );


  drawLightbarButton(
    4,
    0,
    "LEDS",
    getButtonColor(
      CMD_LEDS
    )
  );


  drawLightbarButton(
    0,
    1,
    "CLOSE",
    COLOR_BUTTON_IDLE
  );


  drawLightbarButton(
    1,
    1,
    "TA LEFT",
    getButtonColor(
      CMD_TLEFT
    )
  );


  drawLightbarButton(
    2,
    1,
    "TA OUT",
    getButtonColor(
      CMD_TOUT
    )
  );


  drawLightbarButton(
    3,
    1,
    "TA RIGHT",
    getButtonColor(
      CMD_TRIGHT
    )
  );


  drawLightbarButton(
    4,
    1,
    "MONITOR",
    COLOR_BUTTON_IDLE
  );
}


// ============================================================
// DRAW LIGHTBAR BUTTON
// ============================================================

void drawLightbarButton(
  int column,
  int row,
  const char *label,
  uint16_t color
) {

  int x =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int y =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  display.fillRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    color
  );


  display.drawRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    color
  );


  if (
    strcmp(
      label,
      "TRAFFIC\nBREAKER"
    ) == 0
  ) {

    display.setTextSize(2);


    display.setCursor(
      x + 22,
      y + 50
    );


    display.print(
      "TRAFFIC"
    );


    display.setCursor(
      x + 22,
      y + 78
    );


    display.print(
      "BREAKER"
    );


    return;
  }


  display.setTextSize(2);


  int textWidth =
    strlen(label) *
    12;


  int tx =
    x +
    (
      BUTTON_W -
      textWidth
    ) /
    2;


  int ty =
    y +
    BUTTON_H /
    2 -
    8;


  display.setCursor(
    tx,
    ty
  );


  display.print(
    label
  );
}


// ============================================================
// BUTTON COLOR
// ============================================================

uint16_t getButtonColor(
  int command
) {

  LightbarState &s =
    lightbar[command];


  // ==========================================================
  // 1. PHYSICAL SWITCH ON + OVERRIDDEN
  //
  // RED has highest physical-state priority.
  // ==========================================================

  if (
    s.physical &&
    s.overrideActive
  ) {

    return COLOR_RED;
  }


  // ==========================================================
  // 2. PHYSICAL STARTUP HOLD
  // ==========================================================

  if (
    s.physical &&
    s.startupHold
  ) {

    return flashState ?
      COLOR_BLUE :
      COLOR_BLACK;
  }


  // ==========================================================
  // 3. NORMAL PHYSICAL CONTROL
  // ==========================================================

  if (
    s.physical
  ) {

    return COLOR_BLUE;
  }


  // ==========================================================
  // 4. PENDING GIGA START/STOP
  // ==========================================================

  if (
    s.waitingForConfirmation
  ) {

    return flashState ?
      COLOR_PURPLE :
      COLOR_BLACK;
  }


  // ==========================================================
  // 5. GIGA COMMAND GAVE UP
  // ==========================================================

  if (
    s.failed
  ) {

    return COLOR_PURPLE;
  }


  // ==========================================================
  // 6. CONFIRMED GIGA CONTROL
  // ==========================================================

  if (
    s.giga &&
    s.megaConfirmed
  ) {

    return COLOR_OBS_GREEN;
  }


  return COLOR_BLACK;
}


// ============================================================
// SEND NORMAL GIGA COMMAND
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  if (
    command < 0 ||
    command >=
    NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  unsigned long now =
    millis();


  s.pendingStart =
    start;


  s.nanoAckPending =
    true;


  s.waitingForConfirmation =
    true;


  s.commandStartedAt =
    now;


  s.commandSentAt =
    now;


  s.failed =
    false;


  s.failureReason[0] =
    '\0';


  s.giga =
    start;


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    refreshLightbarButtons();
  }


  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    start ?
      "START" :
      "STOP",
    commandNames[command]
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );
}


// ============================================================
// RETRY NORMAL GIGA COMMANDS
// ============================================================

void retryPendingCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &s =
      lightbar[i];


    if (
      !s.waitingForConfirmation
    ) {

      continue;
    }


    // --------------------------------------------------------
    // 30 SECOND TOTAL TIMEOUT
    // --------------------------------------------------------

    if (
      now -
      s.commandStartedAt >=
      COMMAND_TOTAL_TIMEOUT
    ) {

      s.waitingForConfirmation =
        false;


      s.nanoAckPending =
        false;


      s.failed =
        true;


      strncpy(
        s.failureReason,
        "CONFIRM_TIMEOUT",
        sizeof(
          s.failureReason
        ) - 1
      );


      s.failureReason[
        sizeof(
          s.failureReason
        ) - 1
      ] = '\0';


      char errorMessage[80];


      snprintf(
        errorMessage,
        sizeof(errorMessage),
        "%s %s CONFIRM TIMEOUT",
        s.pendingStart ?
          "START" :
          "STOP",
        commandNames[i]
      );


      addSerialMessage(
        "ERR",
        errorMessage
      );


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }


      continue;
    }


    // --------------------------------------------------------
    // 5 SECOND RETRY INTERVAL
    // --------------------------------------------------------

    if (
      now -
      s.commandSentAt <
      COMMAND_RETRY_INTERVAL
    ) {

      continue;
    }


    s.commandSentAt =
      now;


    s.nanoAckPending =
      true;


    char message[64];


    snprintf(
      message,
      sizeof(message),
      "%s %s",
      s.pendingStart ?
        "START" :
        "STOP",
      commandNames[i]
    );


    NanoSerial.println(
      message
    );


    addSerialMessage(
      "G>N",
      message
    );
  }
}


// ============================================================
// HEARTBEAT
// ============================================================

void sendHeartbeat() {

  unsigned long now =
    millis();


  if (
    now -
    lastHeartbeatSent <
    HEARTBEAT_INTERVAL
  ) {

    return;
  }


  lastHeartbeatSent =
    now;


  NanoSerial.println(
    "GIGA_PING"
  );


  addSerialMessage(
    "G>N",
    "GIGA_PING"
  );
}


// ============================================================
// REQUEST STATE SYNC
// ============================================================

void requestSync() {

  NanoSerial.println(
    "SYNC_REQUEST"
  );


  addSerialMessage(
    "G>N",
    "SYNC_REQUEST"
  );
}


// ============================================================
// HANDLE NANO SERIAL
// ============================================================

void handleNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        addSerialMessage(
          "N>G",
          nanoRxBuffer
        );


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex =
          0;
      }

    } else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;

      } else {

        nanoRxIndex =
          0;


        addSerialMessage(
          "ERR",
          "Nano RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(
  char *line
) {

  // ----------------------------------------------------------
  // Capture previous state BEFORE refreshing timestamp.
  // ----------------------------------------------------------

  bool nanoWasLost =
    isNanoLinkLost();


  // ----------------------------------------------------------
  // ANY complete Nano line proves Nano is currently alive.
  // ----------------------------------------------------------

  lastNanoResponse =
    millis();


  // ==========================================================
  // GIGA PONG
  // ==========================================================

  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    if (
      nanoWasLost
    ) {

      requestSync();
    }


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // NANO BOOT
  // ==========================================================

  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    // Mega verification from before a Nano reboot is stale.
    lastMegaResponse =
      0;


    requestSync();


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // VERIFIED FORWARDED MEGA PONG
  // ==========================================================

  if (
    strcmp(
      line,
      "DIAG M>N PONG"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // EXPLICIT MEGA LINK LOST
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    lastMegaResponse =
      0;


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // EXPLICIT MEGA LINK RESTORED
  // ==========================================================

  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    lastMegaResponse =
      millis();


    updateAlarmBorder();


    return;
  }


  // ==========================================================
  // NORMAL START/STOP ACK
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].nanoAckPending =
          false;
      }
    }


    return;
  }


  // ==========================================================
  // OVERRIDE ACK
  //
  // Example:
  // ACK OVERRIDE OUTERS ON
  //
  // STATE remains authoritative for actual O value.
  // ==========================================================

  if (
    strncmp(
      line,
      "ACK OVERRIDE ",
      13
    ) == 0
  ) {

    return;
  }


  // ==========================================================
  // OVERRIDE CONFIRMATION
  //
  // Example:
  // CONFIRMED OVERRIDE OUTERS ON
  //
  // We still prefer STATE O= as authoritative, but accepting
  // this makes the UI responsive immediately.
  // ==========================================================

  if (
    strncmp(
      line,
      "CONFIRMED OVERRIDE ",
      19
    ) == 0
  ) {

    char commandName[32];
    char stateText[8];


    if (
      sscanf(
        line,
        "CONFIRMED OVERRIDE %31s %7s",
        commandName,
        stateText
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool enabled =
          strcasecmp(
            stateText,
            "ON"
          ) == 0;


        // Override only visually exists while physical switch
        // itself is still reported ON.

        lightbar[
          index
        ].overrideActive =
          enabled &&
          lightbar[
            index
          ].physical;


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // NORMAL CONFIRMED START / STOP
  // ==========================================================

  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "CONFIRMED %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool start =
          strcasecmp(
            action,
            "START"
          ) == 0;


        lightbar[
          index
        ].megaConfirmed =
          start;


        lightbar[
          index
        ].giga =
          start;


        lightbar[
          index
        ].waitingForConfirmation =
          false;


        lightbar[
          index
        ].nanoAckPending =
          false;


        lightbar[
          index
        ].failed =
          false;


        lightbar[
          index
        ].failureReason[0] =
          '\0';


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // FAILED START / STOP
  //
  // Individual attempt failed.
  // GIGA continues retrying until 30-second total timeout.
  // ==========================================================

  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    char action[12];
    char commandName[32];
    char reason[32];


    reason[0] =
      '\0';


    int fields =
      sscanf(
        line,
        "FAILED %11s %31s %31s",
        action,
        commandName,
        reason
      );


    if (
      fields >= 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].nanoAckPending =
          false;


        if (
          fields >= 3
        ) {

          strncpy(
            lightbar[
              index
            ].failureReason,
            reason,
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          );


          lightbar[
            index
          ].failureReason[
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          ] = '\0';
        }


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ==========================================================
  // STATE WITH OVERRIDE FIELD
  //
  // New format:
  //
  // STATE OUTERS P=1 G=0 E=0 M=0 H=0 O=1
  // ==========================================================

  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    char commandName[32];

    int p = 0;
    int g = 0;
    int e = 0;
    int m = 0;
    int h = 0;
    int o = 0;


    int fields =
      sscanf(
        line,
        "STATE %31s P=%d G=%d E=%d M=%d H=%d O=%d",
        commandName,
        &p,
        &g,
        &e,
        &m,
        &h,
        &o
      );


    // --------------------------------------------------------
    // Backward compatibility:
    //
    // Old Nano:
    // STATE ... P= G= E= M= H=
    // --------------------------------------------------------

    if (
      fields < 6
    ) {

      return;
    }


    int index =
      commandIndexFromName(
        commandName
      );


    if (
      index >= 0
    ) {

      lightbar[
        index
      ].physical =
        p != 0;


      lightbar[
        index
      ].giga =
        g != 0;


      lightbar[
        index
      ].effective =
        e != 0;


      lightbar[
        index
      ].megaConfirmed =
        m != 0;


      lightbar[
        index
      ].startupHold =
        h != 0;


      // ------------------------------------------------------
      // If new O field exists, use it.
      //
      // If physical switch is OFF, override must visually
      // disappear regardless.
      // ------------------------------------------------------

      if (
        fields >= 7
      ) {

        lightbar[
          index
        ].overrideActive =
          (
            o != 0 &&
            p != 0
          );

      } else if (
        p == 0
      ) {

        lightbar[
          index
        ].overrideActive =
          false;
      }


      // ------------------------------------------------------
      // Physical OFF guarantees red disappears.
      // ------------------------------------------------------

      if (
        !lightbar[
          index
        ].physical
      ) {

        lightbar[
          index
        ].overrideActive =
          false;
      }


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }
    }


    return;
  }


  // ==========================================================
  // SYNC
  // ==========================================================

  if (
    strcmp(
      line,
      "SYNC_BEGIN"
    ) == 0
  ) {

    return;
  }


  if (
    strcmp(
      line,
      "SYNC_END"
    ) == 0
  ) {

    return;
  }


  // ==========================================================
  // DIAGNOSTIC / HOLD
  // ==========================================================

  if (
    strncmp(
      line,
      "DIAG ",
      5
    ) == 0 ||
    strncmp(
      line,
      "HOLD ",
      5
    ) == 0
  ) {

    return;
  }
}


// ============================================================
// COMMAND LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// SERIAL HISTORY
// ============================================================

void addSerialMessage(
  const char *prefix,
  const char *message
) {

  int index =
    serialHistoryHead;


  snprintf(
    serialHistory[index],
    sizeof(
      serialHistory[index]
    ),
    "%s %s",
    prefix,
    message
  );


  serialHistoryTime[index] =
    millis();


  serialHistoryHead =
    (
      serialHistoryHead +
      1
    ) %
    SERIAL_HISTORY_SIZE;


  if (
    serialHistoryCount <
    SERIAL_HISTORY_SIZE
  ) {

    serialHistoryCount++;
  }


  Serial.print(
    prefix
  );


  Serial.print(
    " "
  );


  Serial.println(
    message
  );
}


