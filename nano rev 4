// ============================================================================
// CODE 3 MX7000 CENTRAL CONTROLLER
// Arduino Nano ESP32
// ============================================================================
//
// Nano responsibilities:
//
//   - Read 10 physical ground-triggered switches
//   - Receive touchscreen commands from Arduino GIGA
//   - Arbitrate physical + GIGA requests
//   - Control Arduino Mega 2560
//   - Track Mega command acknowledgements
//   - Track Mega PING/PONG link health
//   - Forward detailed diagnostics to GIGA
//   - Hold physical switches that are ON at Nano boot for 120 seconds
//   - Preserve physical control if GIGA disappears
//   - Resynchronize Mega after Mega reboot/recovery/link restoration
//
// ---------------------------------------------------------------------------
// NANO <-> MEGA
//
// Nano D10 TX -> Mega D19 RX1
// Nano D11 RX <- Mega D18 TX1
//
// IMPORTANT:
// Mega TX is 5V and Nano ESP32 RX is 3.3V.
// Use a level shifter or voltage divider on:
//
// Mega D18 TX1 -> Nano D11 RX
//
// ---------------------------------------------------------------------------
// NANO <-> GIGA
//
// Nano D13 TX -> GIGA D0 RX
// Nano D12 RX <- GIGA D1 TX
// Common ground
//
// ============================================================================

#include <Arduino.h>


// ============================================================================
// SERIAL PORTS
// ============================================================================

HardwareSerial MegaSerial(1);
HardwareSerial GigaSerial(2);

const int MEGA_RX_PIN = D11;
const int MEGA_TX_PIN = D10;

const int GIGA_RX_PIN = D12;
const int GIGA_TX_PIN = D13;

const unsigned long USB_BAUD  = 115200;
const unsigned long MEGA_BAUD = 38400;
const unsigned long GIGA_BAUD = 38400;


// ============================================================================
// COMMANDS
// ============================================================================

const byte NUM_INPUTS = 10;

const byte CMD_OUTERS          = 0;
const byte CMD_INTERMEDIATES   = 1;
const byte CMD_INNERS          = 2;
const byte CMD_TRAFFICBREAKERS = 3;
const byte CMD_LEDS            = 4;

const byte CMD_TLEFT           = 5;
const byte CMD_TRIGHT          = 6;
const byte CMD_TOUT            = 7;

const byte CMD_LEFTSIGNAL      = 8;
const byte CMD_RIGHTSIGNAL     = 9;


const char* commandNames[NUM_INPUTS] = {
  "OUTERS",
  "INTERMEDIATES",
  "INNERS",
  "TRAFFICBREAKERS",
  "LEDS",
  "TLEFT",
  "TRIGHT",
  "TOUT",
  "LEFTSIGNAL",
  "RIGHTSIGNAL"
};


// ============================================================================
// PHYSICAL INPUTS
// ============================================================================
//
// Active LOW:
//
// HIGH = OFF
// LOW  = ON / grounded
//
// ============================================================================

const int inputPins[NUM_INPUTS] = {
  D2,   // OUTERS
  D3,   // INTERMEDIATES
  D4,   // INNERS
  D5,   // TRAFFICBREAKERS
  D6,   // LEDS
  D7,   // TLEFT
  D8,   // TRIGHT
  D9,   // TOUT
  A0,   // LEFTSIGNAL
  A1    // RIGHTSIGNAL
};


const unsigned long DEBOUNCE_TIME = 50UL;

bool rawPhysicalState[NUM_INPUTS];
bool currentPhysicalState[NUM_INPUTS];

unsigned long physicalChangeTime[NUM_INPUTS];


// ============================================================================
// REQUEST STATE
// ============================================================================

bool physicalRequest[NUM_INPUTS];
bool gigaRequest[NUM_INPUTS];


// ============================================================================
// 120 SECOND STARTUP PHYSICAL HOLD
// ============================================================================
//
// ONLY physical switches already ON when Nano boots are held.
//
// During hold:
//
// P=1
// H=1
// E may remain 0
// M may remain 0
//
// GIGA should FLASH BLUE.
//
// If switch is turned OFF:
//   Hold is permanently cancelled for that switch.
//
// If switch is turned back ON:
//   It is treated as deliberate activation and operates immediately.
//
// GIGA commands are NEVER held.
//
// ============================================================================

const unsigned long PHYSICAL_STARTUP_HOLD_TIME = 120000UL;

bool startupPhysicalHold[NUM_INPUTS];

unsigned long nanoBootTime = 0;


// Optional diagnostic countdown reporting

const unsigned long HOLD_DIAG_INTERVAL = 10000UL;

unsigned long lastHoldDiagTime = 0;


// ============================================================================
// TRAFFIC ADVISOR SOURCE PRIORITY
// ============================================================================
//
// Newest active source wins.
//
// ============================================================================

unsigned long taActivationCounter = 0;

unsigned long physicalTAOrder[NUM_INPUTS];
unsigned long gigaTAOrder[NUM_INPUTS];


// ============================================================================
// MEGA CONFIRMED STATE
// ============================================================================
//
// For non-TA commands:
//
// megaConfirmedState[]
//
// For TA:
//
// confirmedTAMode
//
// -1 = no TA mode confirmed
//
// ============================================================================

bool megaConfirmedState[NUM_INPUTS];

int confirmedTAMode = -1;


// ============================================================================
// MEGA COMMAND TRANSPORT
// ============================================================================

const unsigned long MEGA_COMMAND_TIMEOUT = 1500UL;

const byte MEGA_MAX_RETRIES = 2;


// Initial transmission + 2 retries = 3 attempts total.

struct MegaPendingCommand {

  bool active;

  bool targetState;

  byte retries;

  unsigned long sentAt;

  bool partOfResync;

};

MegaPendingCommand megaPending[NUM_INPUTS];


// ============================================================================
// COMMAND FAILURE LATCHES
// ============================================================================
//
// Prevent a failed command from being resent continuously forever.
//
// A failure latch clears when:
//
// - desired state changes
// - user requests command again
// - physical state changes
// - Mega link recovers
// - Mega reboots/recoveries trigger a resync
//
// ============================================================================

bool commandFailureLatched[NUM_INPUTS];

bool commandFailedTarget[NUM_INPUTS];


// TA needs one system-level failure state because only one TA mode can run.

bool taFailureLatched = false;

int taFailedDesiredMode = -2;


// ============================================================================
// GIGA COMMAND TRANSACTIONS
// ============================================================================
//
// Nano immediately sends:
//
// ACK START OUTERS
//
// meaning:
//
// "Nano received and accepted your request."
//
// After effective Mega state is reconciled:
//
// CONFIRMED START OUTERS
//
// On failure:
//
// FAILED START OUTERS MEGA_NO_ACK
//
// or:
//
// FAILED START OUTERS MEGA_LINK_LOST
//
// ============================================================================

bool gigaTransactionPending[NUM_INPUTS];

bool gigaTransactionWasStart[NUM_INPUTS];


// ============================================================================
// MEGA HEARTBEAT
// ============================================================================

const unsigned long MEGA_PING_INTERVAL = 5000UL;

const unsigned long MEGA_PONG_TIMEOUT = 15000UL;

unsigned long lastMegaPing = 0;

unsigned long lastMegaPong = 0;

bool megaConnected = false;

bool megaLossAnnounced = false;


// ============================================================================
// GIGA HEARTBEAT
// ============================================================================

const unsigned long GIGA_TIMEOUT = 60000UL;

unsigned long lastGigaHeartbeat = 0;

bool gigaConnected = false;

bool bootNoticeSentToGiga = false;


// ============================================================================
// FULL MEGA RESYNC
// ============================================================================
//
// After:
//
// MEGA_BOOT
// MEGA_RECOVERED
// restored PONG after link loss
//
// Nano explicitly sends the desired state for ALL TEN commands.
//
// This guarantees that Nano becomes authoritative again.
//
// ============================================================================

bool fullMegaResyncActive = false;

byte fullMegaResyncIndex = 0;


// ============================================================================
// NON-BLOCKING UART BUFFERS
// ============================================================================

const byte GIGA_RX_BUFFER_SIZE = 100;
const byte MEGA_RX_BUFFER_SIZE = 100;

char gigaRxBuffer[GIGA_RX_BUFFER_SIZE];
char megaRxBuffer[MEGA_RX_BUFFER_SIZE];

byte gigaRxIndex = 0;
byte megaRxIndex = 0;


// ============================================================================
// FORWARD DECLARATIONS
// ============================================================================

bool isTrafficAdvisorCommand(byte command);

int findCommandIndex(const char* command);

bool desiredDirectState(byte command);

int findDesiredTrafficAdvisor();

void checkPhysicalInputs();

void updateStartupHolds();

void reportStartupHoldCountdown();

void processPhysicalStart(byte command);

void processPhysicalStop(byte command);

void checkGigaSerial();

