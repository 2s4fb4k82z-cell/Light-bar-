// ============================================================================
// DIAGNOSTIC FORWARDING TO GIGA
// ============================================================================
//
// These messages let the GIGA serial monitor display Nano<->Mega activity
// even though it is not physically connected to that UART.
//
// Example:
//
// DIAG N>M START OUTERS
// DIAG M>N START OUTERS
// DIAG N>M RETRY 1 START OUTERS
// DIAG MEGA_NO_ACK START OUTERS
//
// ============================================================================

void sendDiag(const char* text) {

  Serial.print(
    "DIAG: "
  );

  Serial.println(
    text
  );


  if (!gigaConnected) {

    return;

  }


  GigaSerial.print(
    "DIAG "
  );

  GigaSerial.println(
    text
  );

}


// ============================================================================
// DIAGNOSTIC COMMAND
// ============================================================================

void sendDiagCommand(
  const char* direction,
  const char* action,
  byte command
) {

  char diag[120];

  snprintf(
    diag,
    sizeof(diag),
    "%s %s %s",
    direction,
    action,
    commandNames[command]
  );


  sendDiag(diag);

}


// ============================================================================
// SEND CURRENT MEGA LINK STATE TO GIGA
// ============================================================================

void sendMegaLinkStateToGiga() {

  if (!gigaConnected) {

    return;

  }


  if (megaConnected) {

    GigaSerial.println(
      "MEGA_LINK_RESTORED"
    );

  }

  else {

    GigaSerial.println(
      "MEGA_LINK_LOST"
    );

  }

}