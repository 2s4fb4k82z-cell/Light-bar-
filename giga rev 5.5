// ============================================================
// DRAW LIGHTBAR BUTTON
// ============================================================

void drawLightbarButton(
  int column,
  int row,
  const char *label,
  uint16_t color
) {

  int x =
    BUTTON_START_X +
    column *
    (
      BUTTON_W +
      BUTTON_GAP_X
    );


  int y =
    BUTTON_START_Y +
    row *
    (
      BUTTON_H +
      BUTTON_GAP_Y
    );


  display.fillRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    color
  );


  display.drawRoundRect(
    x,
    y,
    BUTTON_W,
    BUTTON_H,
    12,
    COLOR_WHITE
  );


  display.setTextColor(
    COLOR_WHITE,
    color
  );


  // ----------------------------------------------------------
  // TRAFFIC BREAKER
  // ----------------------------------------------------------

  if (
    strcmp(
      label,
      "TRAFFIC\nBREAKER"
    ) == 0
  ) {

    display.setTextSize(2);


    display.setCursor(
      x + 22,
      y + 50
    );

    display.print(
      "TRAFFIC"
    );


    display.setCursor(
      x + 22,
      y + 78
    );

    display.print(
      "BREAKER"
    );


    return;
  }


  // ----------------------------------------------------------
  // NORMAL LABEL
  // ----------------------------------------------------------

  display.setTextSize(2);


  int textWidth =
    strlen(label) *
    12;


  int tx =
    x +
    (
      BUTTON_W -
      textWidth
    ) /
    2;


  int ty =
    y +
    BUTTON_H /
    2 -
    8;


  display.setCursor(
    tx,
    ty
  );


  display.print(
    label
  );
}


// ============================================================
// BUTTON COLOR
// ============================================================

uint16_t getButtonColor(
  int command
) {

  LightbarState &s =
    lightbar[command];


  // ----------------------------------------------------------
  // PHYSICAL SOURCE
  // ----------------------------------------------------------

  if (
    s.physical
  ) {

    // Startup hold = flashing blue

    if (
      s.startupHold
    ) {

      if (
        flashState
      ) {

        return COLOR_BLUE;
      }


      return COLOR_BLACK;
    }


    return COLOR_BLUE;
  }


  // ----------------------------------------------------------
  // FAILED GIGA REQUEST
  // ----------------------------------------------------------

  if (
    s.giga &&
    s.failed
  ) {

    if (
      flashState
    ) {

      return COLOR_PURPLE;
    }


    return COLOR_BLACK;
  }


  // ----------------------------------------------------------
  // CONFIRMED GIGA REQUEST
  // ----------------------------------------------------------

  if (
    s.giga &&
    s.megaConfirmed
  ) {

    return COLOR_OBS_GREEN;
  }


  return COLOR_BLACK;
}


// ============================================================
// LIGHTBAR TOUCH
// ============================================================

void handleLightbarTouch(
  int x,
  int y
) {

  if (
    !lightbarTouchEnabled()
  ) {

    return;
  }


  int column = -1;
  int row = -1;


  // ----------------------------------------------------------
  // COLUMN
  // ----------------------------------------------------------

  for (
    int c = 0;
    c < 5;
    c++
  ) {

    int bx =
      BUTTON_START_X +
      c *
      (
        BUTTON_W +
        BUTTON_GAP_X
      );


    if (
      x >= bx &&
      x <
      bx + BUTTON_W
    ) {

      column = c;

      break;
    }
  }


  // ----------------------------------------------------------
  // ROW
  // ----------------------------------------------------------

  for (
    int r = 0;
    r < 2;
    r++
  ) {

    int by =
      BUTTON_START_Y +
      r *
      (
        BUTTON_H +
        BUTTON_GAP_Y
      );


    if (
      y >= by &&
      y <
      by + BUTTON_H
    ) {

      row = r;

      break;
    }
  }


  if (
    column < 0 ||
    row < 0
  ) {

    return;
  }


  // ==========================================================
  // ROW 1
  // ==========================================================

  if (
    row == 0
  ) {

    int command = -1;


    switch (
      column
    ) {

      case 0:

        command =
          CMD_TRAFFICBREAKERS;

        break;


      case 1:

        command =
          CMD_INNERS;

        break;


      case 2:

        command =
          CMD_INTERMEDIATES;

        break;


      case 3:

        command =
          CMD_OUTERS;

        break;


      case 4:

        command =
          CMD_LEDS;

        break;
    }


    if (
      command >= 0
    ) {

      sendGigaCommand(
        command,
        !lightbar[command].giga
      );
    }


    return;
  }


  // ==========================================================
  // ROW 2
  // ==========================================================

  switch (
    column
  ) {

    // CLOSE

    case 0:

      drawGaugeScreen();

      break;


    // TA LEFT

    case 1:

      sendGigaCommand(
        CMD_TLEFT,
        !lightbar[
          CMD_TLEFT
        ].giga
      );

      break;


    // TA OUT

    case 2:

      sendGigaCommand(
        CMD_TOUT,
        !lightbar[
          CMD_TOUT
        ].giga
      );

      break;


    // TA RIGHT

    case 3:

      sendGigaCommand(
        CMD_TRIGHT,
        !lightbar[
          CMD_TRIGHT
        ].giga
      );

      break;


    // MONITOR

    case 4:

      drawSerialScreen();

      break;
  }
}


// ============================================================
// SEND GIGA COMMAND
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  s.pendingStart =
    start;


  s.nanoAckPending =
    true;


  s.waitingForConfirmation =
    true;


  s.nanoRetries =
    0;


  s.commandSentAt =
    millis();


  s.failed =
    false;


  s.failureReason[0] =
    '\0';


  s.giga =
    start;


  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    start ?
      "START" :
      "STOP",
    commandNames[command]
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    refreshLightbarButtons();
  }
}


// ============================================================
// RETRY GIGA COMMAND
// ============================================================

void retryPendingCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &s =
      lightbar[i];


    if (
      !s.nanoAckPending
    ) {

      continue;
    }


    if (
      now -
      s.commandSentAt <
      NANO_ACK_TIMEOUT
    ) {

      continue;
    }


    if (
      s.nanoRetries <
      MAX_NANO_RETRIES
    ) {

      s.nanoRetries++;


      s.commandSentAt =
        now;


      char message[64];


      snprintf(
        message,
        sizeof(message),
        "%s %s",
        s.pendingStart ?
          "START" :
          "STOP",
        commandNames[i]
      );


      NanoSerial.println(
        message
      );


      addSerialMessage(
        "G>N",
        message
      );

    } else {

      s.nanoAckPending =
        false;


      s.waitingForConfirmation =
        false;


      s.failed =
        true;


      strncpy(
        s.failureReason,
        "NANO_NO_ACK",
        sizeof(
          s.failureReason
        ) - 1
      );


      s.failureReason[
        sizeof(
          s.failureReason
        ) - 1
      ] = '\0';


      addSerialMessage(
        "ERR",
        "Nano command ACK timeout"
      );


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }
    }
  }
}


// ============================================================
// HEARTBEAT
// ============================================================

void sendHeartbeat() {

  unsigned long now =
    millis();


  if (
    now -
    lastHeartbeatSent <
    HEARTBEAT_INTERVAL
  ) {

    return;
  }


  lastHeartbeatSent =
    now;


  NanoSerial.println(
    "GIGA_PING"
  );


  addSerialMessage(
    "G>N",
    "GIGA_PING"
  );
}


// ============================================================
// REQUEST SYNC
// ============================================================

void requestSync() {

  NanoSerial.println(
    "SYNC_REQUEST"
  );


  addSerialMessage(
    "G>N",
    "SYNC_REQUEST"
  );
}


// ============================================================
// HANDLE NANO SERIAL
// ============================================================

void handleNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        addSerialMessage(
          "N>G",
          nanoRxBuffer
        );


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex =
          0;
      }

    } else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;

      } else {

        nanoRxIndex =
          0;


        addSerialMessage(
          "ERR",
          "Nano RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(
  char *line
) {

  lastNanoResponse =
    millis();


  // ----------------------------------------------------------
  // GIGA PONG
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    bool wasLost =
      nanoLinkLost;


    nanoLinkLost =
      false;


    if (
      wasLost
    ) {

      requestSync();
    }


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      drawLightbarLinkStatus();
      updateAlarmBorder();
    }


    return;
  }


  // ----------------------------------------------------------
  // NANO BOOT
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    nanoLinkLost =
      false;


    requestSync();


    return;
  }


  // ----------------------------------------------------------
  // MEGA LINK LOST
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    megaLinkLost =
      true;


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      drawLightbarLinkStatus();
    }


    updateAlarmBorder();

    return;
  }


  // ----------------------------------------------------------
  // MEGA LINK RESTORED
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    megaLinkLost =
      false;


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      drawLightbarLinkStatus();
    }


    updateAlarmBorder();

    return;
  }


  // ----------------------------------------------------------
  // ACK
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].nanoAckPending =
          false;
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // CONFIRMED
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "CONFIRMED %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool start =
          strcasecmp(
            action,
            "START"
          ) == 0;


        lightbar[
          index
        ].megaConfirmed =
          start;


        lightbar[
          index
        ].waitingForConfirmation =
          false;


        lightbar[
          index
        ].nanoAckPending =
          false;


        lightbar[
          index
        ].failed =
          false;


        lightbar[
          index
        ].failureReason[0] =
          '\0';


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // FAILED
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    char action[12];
    char commandName[32];
    char reason[32];


    reason[0] =
      '\0';


    int fields =
      sscanf(
        line,
        "FAILED %11s %31s %31s",
        action,
        commandName,
        reason
      );


    if (
      fields >= 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].nanoAckPending =
          false;


        lightbar[
          index
        ].waitingForConfirmation =
          false;


        lightbar[
          index
        ].failed =
          true;


        if (
          fields >= 3
        ) {

          strncpy(
            lightbar[
              index
            ].failureReason,
            reason,
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          );


          lightbar[
            index
          ].failureReason[
            sizeof(
              lightbar[
                index
              ].failureReason
            ) - 1
          ] = '\0';
        }


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // STATE
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    char commandName[32];

    int p;
    int g;
    int e;
    int m;
    int h;


    if (
      sscanf(
        line,
        "STATE %31s P=%d G=%d E=%d M=%d H=%d",
        commandName,
        &p,
        &g,
        &e,
        &m,
        &h
      ) == 6
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[
          index
        ].physical =
          p != 0;


        lightbar[
          index
        ].giga =
          g != 0;


        lightbar[
          index
        ].effective =
          e != 0;


        lightbar[
          index
        ].megaConfirmed =
          m != 0;


        lightbar[
          index
        ].startupHold =
          h != 0;


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // SYNC
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "SYNC_BEGIN"
    ) == 0
  ) {

    return;
  }


  if (
    strcmp(
      line,
      "SYNC_END"
    ) == 0
  ) {

    return;
  }


  // ----------------------------------------------------------
  // DIAGNOSTIC / HOLD
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "DIAG ",
      5
    ) == 0 ||
    strncmp(
      line,
      "HOLD ",
      5
    ) == 0
  ) {

    return;
  }
}


// ============================================================
// COMMAND LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// SERIAL HISTORY
// ============================================================

void addSerialMessage(
  const char *prefix,
  const char *message
) {

  int index =
    serialHistoryHead;


  snprintf(
    serialHistory[index],
    sizeof(
      serialHistory[index]
    ),
    "%s %s",
    prefix,
    message
  );


  serialHistoryTime[index] =
    millis();


  serialHistoryHead =
    (
      serialHistoryHead +
      1
    ) %
    SERIAL_HISTORY_SIZE;


  if (
    serialHistoryCount <
    SERIAL_HISTORY_SIZE
  ) {

    serialHistoryCount++;
  }


  Serial.print(prefix);

  Serial.print(" ");

  Serial.println(message);
}


// ============================================================
// DRAW SERIAL MONITOR
// ============================================================

void drawSerialScreen() {

  currentScreen =
    SCREEN_SERIAL;


  buttonTouchActive =
    true;


  display.fillScreen(
    COLOR_BLACK
  );


  display.setTextColor(
    COLOR_WHITE,
    COLOR_BLACK
  );


  display.setTextSize(2);


  display.setCursor(
    16,
    12
  );


  display.print(
    "SERIAL MONITOR"
  );


  // ----------------------------------------------------------
  // CLOSE X
  // ----------------------------------------------------------

  display.drawRect(
    748,
    8,
    42,
    34,
    COLOR_WHITE
  );


  display.setTextSize(3);


  display.setCursor(
    760,
    12
  );


  display.print("X");


  refreshSerialScreen();


  previousAlarmBorderScreen =
    SCREEN_LIGHTBAR;

  previousAlarmBorderVisible =
    false;


  updateAlarmBorder();
}


// ============================================================
// REFRESH SERIAL MONITOR
// ============================================================

void refreshSerialScreen() {

  display.fillRect(
    8,
    52,
    784,
    418,
    COLOR_BLACK
  );


  int visible =
    serialHistoryCount;


  if (
    visible > 23
  ) {

    visible = 23;
  }


  int first =
    serialHistoryHead -
    visible;


  while (
    first < 0
  ) {

    first +=
      SERIAL_HISTORY_SIZE;
  }


  int y = 56;


  display.setTextSize(1);


  for (
    int i = 0;
    i < visible;
    i++
  ) {

    int index =
      (
        first +
        i
      ) %
      SERIAL_HISTORY_SIZE;


    unsigned long seconds =
      serialHistoryTime[
        index
      ] /
      1000;


    display.setTextColor(
      COLOR_GRAY,
      COLOR_BLACK
    );


    display.setCursor(
      12,
      y
    );


    char timeText[16];


    snprintf(
      timeText,
      sizeof(timeText),
      "%6lu",
      seconds
    );


    display.print(
      timeText
    );


    const char *message =
      serialHistory[index];


    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strncmp(
        message,
        "G>N",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_OBS_GREEN;
    }


    else if (
      strncmp(
        message,
        "N>G",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_BLUE;
    }


    else if (
      strncmp(
        message,
        "ERR",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_RED;
    }


    display.setTextColor(
      directionColor,
      COLOR_BLACK
    );


    display.setCursor(
      62,
      y
    );


    display.print(
      message
    );


    y += 17;
  }
}


// ============================================================
// SERIAL MONITOR TOUCH
// ============================================================

void handleSerialTouch(
  int x,
  int y
) {

  if (
    x >= 735 &&
    y <= 55
  ) {

    drawGaugeScreen();
  }
}


// ============================================================
// ALARM BORDER
// ============================================================

void updateAlarmBorder() {

  bool alarm = false;


  // ----------------------------------------------------------
  // GAUGE SCREEN
  //
  // ONLY engine-data conditions can trigger the border.
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    alarm =
      simulateEngineData ||
      truckDataTimedOut;
  }


  // ----------------------------------------------------------
  // LIGHTBAR / SERIAL
  //
  // ONLY Nano/Mega communication conditions can trigger it.
  // ----------------------------------------------------------

  else if (
    currentScreen ==
    SCREEN_LIGHTBAR ||
    currentScreen ==
    SCREEN_SERIAL
  ) {

    alarm =
      nanoLinkLost ||
      megaLinkLost;
  }


  // ----------------------------------------------------------
  // SHOULD RED CURRENTLY BE VISIBLE?
  // ----------------------------------------------------------

  bool borderVisible =
    alarm &&
    flashState;


  // ----------------------------------------------------------
  // DID SCREEN CHANGE?
  // ----------------------------------------------------------

  bool screenChanged =
    previousAlarmBorderScreen !=
    currentScreen;


  // ----------------------------------------------------------
  // NO DISPLAY CHANGE REQUIRED
  // ----------------------------------------------------------

  if (
    !screenChanged &&
    borderVisible ==
    previousAlarmBorderVisible
  ) {

    return;
  }


  previousAlarmBorderScreen =
    currentScreen;


  previousAlarmBorderVisible =
    borderVisible;


  // ----------------------------------------------------------
  // BORDER COLOR
  // ----------------------------------------------------------

  uint16_t borderColor =
    borderVisible ?
    COLOR_RED :
    COLOR_BLACK;


  // ----------------------------------------------------------
  // DRAW BORDER
  // ----------------------------------------------------------

  display.drawRect(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    borderColor
  );


  display.drawRect(
    1,
    1,
    SCREEN_W - 2,
    SCREEN_H - 2,
    borderColor
  );


  display.drawRect(
    2,
    2,
    SCREEN_W - 4,
    SCREEN_H - 4,
    borderColor
  );
}
