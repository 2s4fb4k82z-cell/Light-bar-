// ============================================================
// BUTTON COLOR
// ============================================================

uint16_t getButtonColor(
  int command
) {

  LightbarState &s =
    lightbar[command];


  // ----------------------------------------------------------
  // PHYSICAL SOURCE HAS VISUAL PRIORITY
  // ----------------------------------------------------------

  if (
    s.physical
  ) {

    if (
      s.startupHold
    ) {

      if (
        flashState
      ) {

        return COLOR_BLUE;
      }

      return COLOR_BLACK;
    }


    return COLOR_BLUE;
  }


  // ----------------------------------------------------------
  // FAILED GIGA REQUEST
  // ----------------------------------------------------------

  if (
    s.giga &&
    s.failed
  ) {

    if (
      flashState
    ) {

      return COLOR_PURPLE;
    }

    return COLOR_BLACK;
  }


  // ----------------------------------------------------------
  // GIGA REQUEST CONFIRMED
  // ----------------------------------------------------------

  if (
    s.giga &&
    s.megaConfirmed
  ) {

    return COLOR_GREEN;
  }


  return COLOR_BLACK;
}


// ============================================================
// LIGHTBAR TOUCH
// ============================================================

void handleLightbarTouch(
  int x,
  int y
) {

  int column = -1;
  int row = -1;


  for (
    int c = 0;
    c < 5;
    c++
  ) {

    int bx =
      BUTTON_START_X +
      c *
      (
        BUTTON_W +
        BUTTON_GAP_X
      );


    if (
      x >= bx &&
      x <
      bx + BUTTON_W
    ) {

      column = c;

      break;
    }
  }


  for (
    int r = 0;
    r < 2;
    r++
  ) {

    int by =
      BUTTON_START_Y +
      r *
      (
        BUTTON_H +
        BUTTON_GAP_Y
      );


    if (
      y >= by &&
      y <
      by + BUTTON_H
    ) {

      row = r;

      break;
    }
  }


  if (
    column < 0 ||
    row < 0
  ) {

    return;
  }


  // ----------------------------------------------------------
  // ROW 1
  // ----------------------------------------------------------

  if (
    row == 0
  ) {

    int command = -1;


    switch (
      column
    ) {

      case 0:

        command =
          CMD_TRAFFICBREAKERS;

        break;


      case 1:

        command =
          CMD_INNERS;

        break;


      case 2:

        command =
          CMD_INTERMEDIATES;

        break;


      case 3:

        command =
          CMD_OUTERS;

        break;


      case 4:

        command =
          CMD_LEDS;

        break;
    }


    if (
      command >= 0
    ) {

      sendGigaCommand(
        command,
        !lightbar[command].giga
      );
    }


    return;
  }


  // ----------------------------------------------------------
  // ROW 2
  // ----------------------------------------------------------

  switch (
    column
  ) {

    // CLOSE

    case 0:

      drawGaugeScreen();

      break;


    // TA LEFT

    case 1:

      sendGigaCommand(
        CMD_TLEFT,
        !lightbar[CMD_TLEFT].giga
      );

      break;


    // TA OUT

    case 2:

      sendGigaCommand(
        CMD_TOUT,
        !lightbar[CMD_TOUT].giga
      );

      break;


    // TA RIGHT

    case 3:

      sendGigaCommand(
        CMD_TRIGHT,
        !lightbar[CMD_TRIGHT].giga
      );

      break;


    // MONITOR

    case 4:

      drawSerialScreen();

      break;
  }
}


// ============================================================
// SEND GIGA COMMAND
// ============================================================

void sendGigaCommand(
  int command,
  bool start
) {

  if (
    command < 0 ||
    command >= NUM_COMMANDS
  ) {

    return;
  }


  LightbarState &s =
    lightbar[command];


  s.pendingStart =
    start;


  s.nanoAckPending =
    true;


  s.waitingForConfirmation =
    true;


  s.nanoRetries =
    0;


  s.commandSentAt =
    millis();


  s.failed =
    false;


  s.failureReason[0] =
    '\0';


  // Locally reflect requested GIGA source

  s.giga =
    start;


  char message[64];


  snprintf(
    message,
    sizeof(message),
    "%s %s",
    start ? "START" : "STOP",
    commandNames[command]
  );


  NanoSerial.println(
    message
  );


  addSerialMessage(
    "G>N",
    message
  );


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    refreshLightbarButtons();
  }
}


// ============================================================
// RETRY GIGA COMMAND
// ============================================================

void retryPendingCommands() {

  unsigned long now =
    millis();


  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    LightbarState &s =
      lightbar[i];


    if (
      !s.nanoAckPending
    ) {

      continue;
    }


    if (
      now -
      s.commandSentAt <
      NANO_ACK_TIMEOUT
    ) {

      continue;
    }


    if (
      s.nanoRetries <
      MAX_NANO_RETRIES
    ) {

      s.nanoRetries++;


      s.commandSentAt =
        now;


      char message[64];


      snprintf(
        message,
        sizeof(message),
        "%s %s",
        s.pendingStart ?
        "START" :
        "STOP",
        commandNames[i]
      );


      NanoSerial.println(
        message
      );


      addSerialMessage(
        "G>N",
        message
      );

    }

    else {

      s.nanoAckPending =
        false;


      s.waitingForConfirmation =
        false;


      s.failed =
        true;


      strncpy(
        s.failureReason,
        "NANO_NO_ACK",
        sizeof(
          s.failureReason
        ) - 1
      );


      s.failureReason[
        sizeof(
          s.failureReason
        ) - 1
      ] = '\0';


      addSerialMessage(
        "ERR",
        "Nano command ACK timeout"
      );


      if (
        currentScreen ==
        SCREEN_LIGHTBAR
      ) {

        refreshLightbarButtons();
      }
    }
  }
}


