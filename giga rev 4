// ============================================================
// REFRESH SERIAL MONITOR
// ============================================================

void refreshSerialScreen() {

  // Clear message area only

  display.fillRect(
    8,
    52,
    784,
    418,
    COLOR_BLACK
  );


  int visible =
    serialHistoryCount;


  if (
    visible > 23
  ) {

    visible = 23;
  }


  int first =
    serialHistoryHead -
    visible;


  while (
    first < 0
  ) {

    first +=
      SERIAL_HISTORY_SIZE;
  }


  int y =
    56;


  display.setTextSize(
    1
  );


  for (
    int i = 0;
    i < visible;
    i++
  ) {

    int index =
      (
        first +
        i
      ) %
      SERIAL_HISTORY_SIZE;


    unsigned long seconds =
      serialHistoryTime[index] /
      1000;


    // Timestamp

    display.setTextColor(
      COLOR_GRAY,
      COLOR_BLACK
    );


    display.setCursor(
      12,
      y
    );


    char timeText[16];


    snprintf(
      timeText,
      sizeof(timeText),
      "%6lu",
      seconds
    );


    display.print(
      timeText
    );


    // Direction

    const char *message =
      serialHistory[index];


    uint16_t directionColor =
      COLOR_WHITE;


    if (
      strncmp(
        message,
        "G>N",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_GREEN;
    }


    else if (
      strncmp(
        message,
        "N>G",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_BLUE;
    }


    else if (
      strncmp(
        message,
        "ERR",
        3
      ) == 0
    ) {

      directionColor =
        COLOR_RED;
    }


    display.setTextColor(
      directionColor,
      COLOR_BLACK
    );


    display.setCursor(
      62,
      y
    );


    display.print(
      message
    );


    y +=
      17;
  }
}


// ============================================================
// SERIAL MONITOR TOUCH
// ============================================================

void handleSerialTouch(
  int x,
  int y
) {

  if (
    x >= 735 &&
    y <= 55
  ) {

    drawGaugeScreen();
  }
}


// ============================================================
// ALARM BORDER
// ============================================================

void updateAlarmBorder() {

  bool alarm;


  // ----------------------------------------------------------
  // GAUGE SCREEN
  // ----------------------------------------------------------
  //
  // Gauge screen alarm has NOTHING to do with lightbar comms.
  //
  // It flashes only when:
  //
  // 1. Engine data is simulated
  //
  // OR
  //
  // 2. Real truck data has timed out
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    alarm =
      simulateEngineData ||
      truckDataTimedOut;
  }


  // ----------------------------------------------------------
  // LIGHTBAR / SERIAL
  // ----------------------------------------------------------

  else {

    alarm =
      nanoLinkLost ||
      megaLinkLost;
  }


  uint16_t borderColor =
    COLOR_BLACK;


  if (
    alarm &&
    flashState
  ) {

    borderColor =
      COLOR_RED;
  }


  // Multiple lines for visible border

  display.drawRect(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    borderColor
  );


  display.drawRect(
    1,
    1,
    SCREEN_W - 2,
    SCREEN_H - 2,
    borderColor
  );


  display.drawRect(
    2,
    2,
    SCREEN_W - 4,
    SCREEN_H - 4,
    borderColor
  );
}
