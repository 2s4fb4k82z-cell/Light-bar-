// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    USB_BAUD
  );


  NanoSerial.begin(
    NANO_BAUD
  );


  display.begin();

  display.setRotation(
    1
  );


  touch.begin();


  // ----------------------------------------------------------
  // INITIALIZE LIGHTBAR STATE
  // ----------------------------------------------------------

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    lightbar[i].physical = false;

    lightbar[i].giga = false;

    lightbar[i].effective = false;

    lightbar[i].megaConfirmed = false;

    lightbar[i].startupHold = false;

    lightbar[i].failed = false;

    lightbar[i].failureReason[0] = '\0';

    lightbar[i].nanoAckPending = false;

    lightbar[i].pendingStart = false;

    lightbar[i].nanoRetries = 0;

    lightbar[i].commandSentAt = 0;

    lightbar[i].waitingForConfirmation = false;
  }


  // ----------------------------------------------------------
  // INITIAL ENGINE DATA
  // ----------------------------------------------------------

  engineData.ipr = 0;
  engineData.icp = 0;

  displayedIPR = 0;
  displayedICP = 0;


  // ----------------------------------------------------------
  // DRAW INITIAL SCREEN
  // ----------------------------------------------------------

  drawGaugeScreen();


  // ----------------------------------------------------------
  // INITIAL COMMUNICATION
  // ----------------------------------------------------------

  NanoSerial.println(
    "GIGA_PING"
  );

  lastHeartbeatSent =
    millis();


  addSerialMessage(
    "G>N",
    "GIGA_PING"
  );
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  unsigned long now =
    millis();


  // ----------------------------------------------------------
  // NANO COMMUNICATION
  // ----------------------------------------------------------

  handleNanoSerial();

  sendHeartbeat();

  retryPendingCommands();


  // ----------------------------------------------------------
  // TOUCH
  // ----------------------------------------------------------

  handleTouch();


  // ----------------------------------------------------------
  // ENGINE DATA
  // ----------------------------------------------------------

  updateEngineData();


  // ----------------------------------------------------------
  // REAL TRUCK DATA WATCHDOG
  // ----------------------------------------------------------

  if (
    !simulateEngineData
  ) {

    if (
      now - lastTruckDataReceived >
      TRUCK_DATA_TIMEOUT
    ) {

      truckDataTimedOut = true;
    }

  }

  else {

    truckDataTimedOut = false;
  }


  // ----------------------------------------------------------
  // NANO LINK WATCHDOG
  // ----------------------------------------------------------

  if (
    lastNanoResponse > 0 &&
    now - lastNanoResponse >
    NANO_TIMEOUT
  ) {

    nanoLinkLost = true;
  }


  // ----------------------------------------------------------
  // FLASH STATE
  // ----------------------------------------------------------

  if (
    now - lastFlashTime >=
    FLASH_INTERVAL
  ) {

    lastFlashTime = now;

    flashState = !flashState;


    if (
      currentScreen ==
      SCREEN_LIGHTBAR
    ) {

      refreshLightbarButtons();
    }


    updateAlarmBorder();
  }


  // ----------------------------------------------------------
  // GAUGE UPDATE
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES &&
    now - lastGaugeUpdate >=
    GAUGE_UPDATE_INTERVAL
  ) {

    lastGaugeUpdate = now;

    updateGaugeDisplay();
  }


  // ----------------------------------------------------------
  // SERIAL MONITOR UPDATE
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_SERIAL &&
    now - lastSerialScreenDraw >=
    SERIAL_SCREEN_INTERVAL
  ) {

    lastSerialScreenDraw = now;

    refreshSerialScreen();
  }
}


// ============================================================
// ENGINE DATA
// ============================================================

void updateEngineData() {

  if (
    simulateEngineData
  ) {

    float t =
      millis() /
      1000.0;


    engineData.ipr =
      35.0 +
      sin(t * 0.7) * 15.0 +
      sin(t * 2.3) * 2.0;


    engineData.icp =
      1800.0 +
      sin(t * 0.45) * 850.0 +
      sin(t * 1.8) * 100.0;


    if (
      engineData.ipr < 0
    ) {

      engineData.ipr = 0;
    }


    if (
      engineData.ipr > 100
    ) {

      engineData.ipr = 100;
    }


    if (
      engineData.icp < 0
    ) {

      engineData.icp = 0;
    }


    if (
      engineData.icp > 4000
    ) {

      engineData.icp = 4000;
    }
  }


  /*
     FUTURE REAL TRUCK DATA:

     When valid diagnostic data arrives:

        engineData.ipr = ...
        engineData.icp = ...

        markTruckDataReceived();

     Keep the variable name "truckData" rather than "CAN data"
     because the 1996 Power Stroke diagnostic interface is not
     being assumed to be modern CAN.
  */
}


// ============================================================
// VALID TRUCK DATA RECEIVED
// ============================================================

void markTruckDataReceived() {

  lastTruckDataReceived =
    millis();

  truckDataTimedOut =
    false;
}


