// ============================================================
// TOUCH HANDLING
// ============================================================

void handleTouch() {

  uint8_t contacts =
    touch.getTouchPoints(
      touchPoints
    );


  // ----------------------------------------------------------
  // SECRET GAUGE GESTURE
  // ----------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_GAUGES
  ) {

    handleSecretGesture(
      contacts,
      touchPoints
    );

    return;
  }


  // ----------------------------------------------------------
  // NORMAL BUTTON TOUCH
  // ----------------------------------------------------------

  if (
    contacts == 0
  ) {

    buttonTouchActive =
      false;

    return;
  }


  // Only process one button activation per physical touch

  if (
    buttonTouchActive
  ) {

    return;
  }


  buttonTouchActive =
    true;


  int x;
  int y;


  mapTouchPoint(
    touchPoints[0],
    x,
    y
  );


  if (
    currentScreen ==
    SCREEN_LIGHTBAR
  ) {

    handleLightbarTouch(
      x,
      y
    );
  }


  else if (
    currentScreen ==
    SCREEN_SERIAL
  ) {

    handleSerialTouch(
      x,
      y
    );
  }
}


// ============================================================
// NEW SECRET TWO-FINGER GESTURE
// ============================================================

void handleSecretGesture(
  uint8_t contacts,
  GDTpoint_t *points
) {

  unsigned long now =
    millis();


  // ----------------------------------------------------------
  // TWO VALID CONTACTS
  // ----------------------------------------------------------

  if (
    contacts >= 2
  ) {

    float averageRawX =
      (
        (float)points[0].x +
        (float)points[1].x
      ) /
      2.0;


    int separation =
      abs(
        (int)points[0].y -
        (int)points[1].y
      );


    secretLastValidTouch =
      now;


    // --------------------------------------------------------
    // LOCKED UNTIL REAL RELEASE
    // --------------------------------------------------------

    if (
      secretGestureLocked
    ) {

      return;
    }


    // --------------------------------------------------------
    // BEGIN GESTURE
    // --------------------------------------------------------

    if (
      !secretGestureTracking
    ) {

      // Must begin broadly around gauge area

      if (
        averageRawX >=
        SECRET_START_RAW_X_MIN &&

        averageRawX <=
        SECRET_START_RAW_X_MAX &&

        separation >=
        SECRET_MIN_FINGER_SEPARATION
      ) {

        secretGestureTracking =
          true;


        secretGestureTriggered =
          false;


        secretStartRawX =
          averageRawX;


        secretLowestRawX =
          averageRawX;
      }


      return;
    }


    // --------------------------------------------------------
    // CONTINUE GESTURE
    // --------------------------------------------------------

    if (
      averageRawX <
      secretLowestRawX
    ) {

      secretLowestRawX =
        averageRawX;
    }


    // Physical downward = RAW X decreasing

    float downwardTravel =
      secretStartRawX -
      secretLowestRawX;


    if (
      !secretGestureTriggered &&
      downwardTravel >=
      SECRET_SWIPE_DISTANCE
    ) {

      secretGestureTriggered =
        true;

      secretGestureLocked =
        true;


      drawLightbarScreen();

      return;
    }


    return;
  }


  // ----------------------------------------------------------
  // ZERO OR ONE CONTACT
  // ----------------------------------------------------------
  //
  // DO NOT reset immediately.
  //
  // Testing showed the touch controller can momentarily report:
  //
  //      2 -> 0 -> 2
  //
  // or:
  //
  //      2 -> 1 -> 2
  //
  // within only a few milliseconds.
  // ----------------------------------------------------------

  if (
    secretGestureTracking ||
    secretGestureLocked
  ) {

    if (
      now -
      secretLastValidTouch >
      TOUCH_RELEASE_GRACE
    ) {

      resetSecretGesture();
    }
  }
}


// ============================================================
// RESET SECRET GESTURE
// ============================================================

void resetSecretGesture() {

  secretGestureTracking =
    false;

  secretGestureTriggered =
    false;

  secretGestureLocked =
    false;

  secretStartRawX =
    0;

  secretLowestRawX =
    0;

  secretLastValidTouch =
    0;
}


