// ============================================================
// HANDLE NANO SERIAL
// ============================================================

void handleNanoSerial() {

  while (
    NanoSerial.available()
  ) {

    char c =
      NanoSerial.read();


    if (
      c == '\r'
    ) {

      continue;
    }


    if (
      c == '\n'
    ) {

      if (
        nanoRxIndex > 0
      ) {

        nanoRxBuffer[
          nanoRxIndex
        ] = '\0';


        addSerialMessage(
          "N>G",
          nanoRxBuffer
        );


        processNanoLine(
          nanoRxBuffer
        );


        nanoRxIndex =
          0;
      }

    }

    else {

      if (
        nanoRxIndex <
        sizeof(
          nanoRxBuffer
        ) - 1
      ) {

        nanoRxBuffer[
          nanoRxIndex++
        ] = c;
      }

      else {

        nanoRxIndex =
          0;


        addSerialMessage(
          "ERR",
          "Nano RX overflow"
        );
      }
    }
  }
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(
  char *line
) {

  lastNanoResponse =
    millis();


  // ----------------------------------------------------------
  // PONG
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "GIGA_PONG"
    ) == 0
  ) {

    bool wasLost =
      nanoLinkLost;


    nanoLinkLost =
      false;


    if (
      wasLost
    ) {

      requestSync();
    }


    return;
  }


  // ----------------------------------------------------------
  // NANO BOOT
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "NANO_BOOT"
    ) == 0
  ) {

    nanoLinkLost =
      false;


    requestSync();


    return;
  }


  // ----------------------------------------------------------
  // MEGA LINK
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "MEGA_LINK_LOST"
    ) == 0
  ) {

    megaLinkLost =
      true;


    updateAlarmBorder();

    return;
  }


  if (
    strcmp(
      line,
      "MEGA_LINK_RESTORED"
    ) == 0
  ) {

    megaLinkLost =
      false;


    updateAlarmBorder();

    return;
  }


  // ----------------------------------------------------------
  // ACK
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "ACK ",
      4
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "ACK %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[index].nanoAckPending =
          false;
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // CONFIRMED
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "CONFIRMED ",
      10
    ) == 0
  ) {

    char action[12];
    char commandName[32];


    if (
      sscanf(
        line,
        "CONFIRMED %11s %31s",
        action,
        commandName
      ) == 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        bool start =
          strcasecmp(
            action,
            "START"
          ) == 0;


        lightbar[index].megaConfirmed =
          start;


        lightbar[index].waitingForConfirmation =
          false;


        lightbar[index].nanoAckPending =
          false;


        lightbar[index].failed =
          false;


        lightbar[index].failureReason[0] =
          '\0';


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // FAILED
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "FAILED ",
      7
    ) == 0
  ) {

    char action[12];
    char commandName[32];
    char reason[32];


    reason[0] =
      '\0';


    int fields =
      sscanf(
        line,
        "FAILED %11s %31s %31s",
        action,
        commandName,
        reason
      );


    if (
      fields >= 2
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[index].nanoAckPending =
          false;


        lightbar[index].waitingForConfirmation =
          false;


        lightbar[index].failed =
          true;


        if (
          fields >= 3
        ) {

          strncpy(
            lightbar[index].failureReason,
            reason,
            sizeof(
              lightbar[index].failureReason
            ) - 1
          );


          lightbar[index].failureReason[
            sizeof(
              lightbar[index].failureReason
            ) - 1
          ] = '\0';
        }


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // STATE
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "STATE ",
      6
    ) == 0
  ) {

    char commandName[32];

    int p;
    int g;
    int e;
    int m;
    int h;


    if (
      sscanf(
        line,
        "STATE %31s P=%d G=%d E=%d M=%d H=%d",
        commandName,
        &p,
        &g,
        &e,
        &m,
        &h
      ) == 6
    ) {

      int index =
        commandIndexFromName(
          commandName
        );


      if (
        index >= 0
      ) {

        lightbar[index].physical =
          p != 0;


        lightbar[index].giga =
          g != 0;


        lightbar[index].effective =
          e != 0;


        lightbar[index].megaConfirmed =
          m != 0;


        lightbar[index].startupHold =
          h != 0;


        if (
          currentScreen ==
          SCREEN_LIGHTBAR
        ) {

          refreshLightbarButtons();
        }
      }
    }


    return;
  }


  // ----------------------------------------------------------
  // SYNC
  // ----------------------------------------------------------

  if (
    strcmp(
      line,
      "SYNC_BEGIN"
    ) == 0
  ) {

    return;
  }


  if (
    strcmp(
      line,
      "SYNC_END"
    ) == 0
  ) {

    return;
  }


  // ----------------------------------------------------------
  // DIAG / HOLD
  // ----------------------------------------------------------

  if (
    strncmp(
      line,
      "DIAG ",
      5
    ) == 0 ||
    strncmp(
      line,
      "HOLD ",
      5
    ) == 0
  ) {

    return;
  }
}


// ============================================================
// COMMAND NAME LOOKUP
// ============================================================

int commandIndexFromName(
  const char *name
) {

  for (
    int i = 0;
    i < NUM_COMMANDS;
    i++
  ) {

    if (
      strcasecmp(
        name,
        commandNames[i]
      ) == 0
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// SERIAL MONITOR HISTORY
// ============================================================

void addSerialMessage(
  const char *prefix,
  const char *message
) {

  int index =
    serialHistoryHead;


  snprintf(
    serialHistory[index],
    sizeof(
      serialHistory[index]
    ),
    "%s %s",
    prefix,
    message
  );


  serialHistoryTime[index] =
    millis();


  serialHistoryHead =
    (
      serialHistoryHead +
      1
    ) %
    SERIAL_HISTORY_SIZE;


  if (
    serialHistoryCount <
    SERIAL_HISTORY_SIZE
  ) {

    serialHistoryCount++;
  }


  // Also show on USB Serial

  Serial.print(
    prefix
  );

  Serial.print(
    " "
  );

  Serial.println(
    message
  );
}


