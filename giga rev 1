// ============================================================
// LIGHTBAR COMMANDS
// ============================================================

constexpr uint8_t NUM_COMMANDS = 10;

enum CommandIndex : uint8_t {

  CMD_OUTERS = 0,
  CMD_INTERMEDIATES,
  CMD_INNERS,
  CMD_TRAFFICBREAKERS,
  CMD_LEDS,
  CMD_TLEFT,
  CMD_TRIGHT,
  CMD_TOUT,
  CMD_LEFTSIGNAL,
  CMD_RIGHTSIGNAL

};


const char* const COMMAND_NAMES[NUM_COMMANDS] = {

  "OUTERS",
  "INTERMEDIATES",
  "INNERS",
  "TRAFFICBREAKERS",
  "LEDS",
  "TLEFT",
  "TRIGHT",
  "TOUT",
  "LEFTSIGNAL",
  "RIGHTSIGNAL"

};


bool isTrafficAdvisor(uint8_t command) {

  return (

    command == CMD_TLEFT ||
    command == CMD_TRIGHT ||
    command == CMD_TOUT

  );

}


// ============================================================
// LIGHTBAR STATE
// ============================================================

struct LightbarState {

  // What the GIGA currently wants
  bool requested = false;

  // Physical switch state reported by Nano
  bool physicalRequest = false;

  // GIGA request stored by Nano
  bool gigaRequest = false;

  // Effective state commanded toward Mega
  bool effectiveState = false;

  // Waiting for START/STOP ACK
  bool awaitingAck = false;

  // Command has been acknowledged
  bool commandConfirmed = false;

  // Purple flashing warning
  bool ackFailed = false;

  // Last command/retry transmission time
  unsigned long commandSentTime = 0;

};


// ============================================================
// SERIAL MONITOR
// ============================================================

struct SerialLogEntry {

  unsigned long timestamp = 0;

  String direction;

  String message;

};


constexpr uint8_t SERIAL_LOG_CAPACITY = 48;

SerialLogEntry serialLog[SERIAL_LOG_CAPACITY];

uint8_t serialLogHead = 0;

uint8_t serialLogCount = 0;

bool serialLogChanged = true;


// ============================================================
// ADD SERIAL LOG ENTRY
// ============================================================

void addSerialLog(

  const char* direction,

  const String& message

) {

  serialLog[serialLogHead].timestamp =
    millis();

  serialLog[serialLogHead].direction =
    direction;

  serialLog[serialLogHead].message =
    message;


  serialLogHead =

    (serialLogHead + 1)

    %

    SERIAL_LOG_CAPACITY;


  if (
    serialLogCount < SERIAL_LOG_CAPACITY
  ) {

    serialLogCount++;

  }


  serialLogChanged = true;
}


// ============================================================
// GET SERIAL LOG ENTRY
// ============================================================

const SerialLogEntry& getNewestLog(

  uint8_t offsetFromNewest

) {

  static SerialLogEntry empty;


  if (

    serialLogCount == 0 ||

    offsetFromNewest >= serialLogCount

  ) {

    return empty;

  }


  int index =

    (int)serialLogHead

    -

    1

    -

    offsetFromNewest;


  while (
    index < 0
  ) {

    index += SERIAL_LOG_CAPACITY;

  }


  return serialLog[index];
}


// ============================================================
// ENGINE DATA
// ============================================================

struct EngineData {

  float iprDutyCycle = 0.0f;

  float icpPressure = 0.0f;

  bool dataValid = false;

  unsigned long lastUpdate = 0;

};


EngineData engineData;


// ============================================================
// ENGINE DATA SIMULATOR
//
// THIS WILL EVENTUALLY BE REPLACED WITH THE
// 1996 7.3 POWER STROKE J1850 DATA SOURCE.
// ============================================================

void updateEngineData() {

  float seconds =

    millis()

    /

    1000.0f;


  float ipr =

    35.0f

    +

    20.0f

    *

    sinf(
      seconds * 0.70f
    );


  float icp =

    1200.0f

    +

    900.0f

    *

    sinf(
      seconds * 0.45f
    );


  engineData.iprDutyCycle =

    constrain(
      ipr,
      0.0f,
      100.0f
    );


  engineData.icpPressure =

    constrain(
      icp,
      0.0f,
      4000.0f
    );


  engineData.dataValid =
    true;


  engineData.lastUpdate =
    millis();
}


// ============================================================
// NANO COMMUNICATION
// ============================================================

LightbarState lightbarStates[NUM_COMMANDS];

bool nanoConnected = false;

bool nanoSyncInProgress = false;

bool nanoStateChanged = true;

bool nanoConnectionChanged = true;


unsigned long lastNanoPing = 0;

unsigned long lastNanoPong = 0;


constexpr unsigned long HEARTBEAT_INTERVAL = 5000;

constexpr unsigned long NANO_TIMEOUT = 15000;

constexpr unsigned long ACK_TIMEOUT = 1500;

constexpr uint8_t MAX_RETRIES = 2;


uint8_t retryCount[NUM_COMMANDS] = {0};


String nanoRxLine;


// ============================================================
// FIND COMMAND INDEX
// ============================================================

int findCommandIndex(

  const String& name

) {

  for (

    uint8_t i = 0;

    i < NUM_COMMANDS;

    i++

  ) {

    if (

      name.equalsIgnoreCase(
        COMMAND_NAMES[i]
      )

    ) {

      return i;

    }
  }


  return -1;
}


// ============================================================
// SEND TO NANO AND LOG IT
// ============================================================

void sendNanoLine(

  const String& line

) {

  Serial1.println(
    line
  );


  addSerialLog(

    "G>N",

    line

  );
}


// ============================================================
// SEND GIGA HEARTBEAT
// ============================================================

void sendNanoPing() {

  sendNanoLine(
    "GIGA_PING"
  );
}


// ============================================================
// REQUEST FULL SYNC
// ============================================================

void requestNanoSync() {

  if (
    !nanoConnected
  ) {

    return;

  }


  nanoSyncInProgress =
    true;


  sendNanoLine(
    "SYNC_REQUEST"
  );


  nanoStateChanged =
    true;
}


// ============================================================
// PROCESS ACK
// ============================================================

void processNanoAck(

  const String& line

) {

  // Examples:
  //
  // ACK START OUTERS
  // ACK STOP OUTERS


  int first =

    line.indexOf(
      ' '
    );


  int second =

    line.indexOf(

      ' ',

      first + 1

    );


  if (

    first < 0 ||

    second < 0

  ) {

    return;

  }


  String action =

    line.substring(

      first + 1,

      second

    );


  String name =

    line.substring(
      second + 1
    );


  name.trim();


  int command =

    findCommandIndex(
      name
    );


  if (
    command < 0
  ) {

    return;

  }


  bool ackIsStart =

    action.equalsIgnoreCase(
      "START"
    );


  bool ackIsStop =

    action.equalsIgnoreCase(
      "STOP"
    );


  if (

    !ackIsStart &&

    !ackIsStop

  ) {

    return;

  }


  // Ignore stale ACK from older command.

  if (

    lightbarStates[command].requested

    !=

    ackIsStart

  ) {

    return;

  }


  LightbarState& s =

    lightbarStates[command];


  s.awaitingAck =
    false;


  s.commandConfirmed =
    true;


  s.ackFailed =
    false;


  retryCount[command] =
    0;


  nanoStateChanged =
    true;
}


// ============================================================
// PROCESS STATE
// ============================================================

void processNanoState(

  const String& line

) {

  // Example:
  //
  // STATE OUTERS P=1 G=0 E=1


  String body =

    line.substring(
      6
    );


  int nameEnd =

    body.indexOf(
      ' '
    );


  if (
    nameEnd < 0
  ) {

    return;

  }


  String name =

    body.substring(

      0,

      nameEnd

    );


  int command =

    findCommandIndex(
      name
    );


  if (
    command < 0
  ) {

    return;

  }


  int pIndex =

    body.indexOf(
      "P="
    );


  int gIndex =

    body.indexOf(
      "G="
    );


  int eIndex =

    body.indexOf(
      "E="
    );


  if (

    pIndex < 0 ||

    gIndex < 0 ||

    eIndex < 0

  ) {

    return;

  }


  bool p =

    body.charAt(
      pIndex + 2
    )

    ==

    '1';


  bool g =

    body.charAt(
      gIndex + 2
    )

    ==

    '1';


  bool e =

    body.charAt(
      eIndex + 2
    )

    ==

    '1';


  LightbarState& s =

    lightbarStates[command];


  s.physicalRequest =
    p;


  s.gigaRequest =
    g;


  s.effectiveState =
    e;


  // Nano state is authoritative.

  s.requested =
    g;


  // A valid STATE proves Nano processed the state.
  // Clear ACK failure warning.

  s.awaitingAck =
    false;


  s.commandConfirmed =
    true;


  s.ackFailed =
    false;


  retryCount[command] =
    0;


  nanoStateChanged =
    true;
}


// ============================================================
// PROCESS NANO MESSAGE
// ============================================================

void processNanoLine(

  String line

) {

  if (
    line == "GIGA_PONG"
  ) {

    bool wasDisconnected =

      !nanoConnected;


    nanoConnected =
      true;


    lastNanoPong =
      millis();


    if (
      wasDisconnected
    ) {

      nanoConnectionChanged =
        true;


      requestNanoSync();
    }


    return;
  }


  if (
    line == "SYNC_BEGIN"
  ) {

    nanoSyncInProgress =
      true;


    nanoStateChanged =
      true;


    return;
  }


  if (
    line == "SYNC_END"
  ) {

    nanoSyncInProgress =
      false;


    nanoStateChanged =
      true;


    return;
  }


  if (
    line.startsWith(
      "ACK "
    )
  ) {

    processNanoAck(
      line
    );


    return;
  }


  if (
    line.startsWith(
      "STATE "
    )
  ) {

    processNanoState(
      line
    );


    return;
  }
}


// ============================================================
// REQUEST LIGHTBAR COMMAND
// ============================================================

void requestLightbarCommand(

  uint8_t command,

  bool desired

) {

  if (
    command >= NUM_COMMANDS
  ) {

    return;

  }


  if (

    !nanoConnected ||

    nanoSyncInProgress

  ) {

    return;

  }


  // ==========================================================
  // TRAFFIC ADVISOR
  //
  // GIGA only keeps one of its own TA modes requested.
  // ==========================================================

  if (

    desired &&

    isTrafficAdvisor(
      command
    )

  ) {

    for (

      uint8_t ta = CMD_TLEFT;

      ta <= CMD_TOUT;

      ta++

    ) {

      if (
        ta == command
      ) {

        continue;

      }


      if (

        lightbarStates[ta].requested ||

        lightbarStates[ta].gigaRequest

      ) {

        LightbarState& oldTA =

          lightbarStates[ta];


        oldTA.requested =
          false;


        oldTA.awaitingAck =
          true;


        oldTA.commandConfirmed =
          false;


        oldTA.ackFailed =
          false;


        oldTA.commandSentTime =
          millis();


        retryCount[ta] =
          0;


        String stopLine =
          "STOP ";


        stopLine +=
          COMMAND_NAMES[ta];


        sendNanoLine(
          stopLine
        );
      }
    }
  }


  // ==========================================================
  // REQUEST NEW STATE
  // ==========================================================

  LightbarState& s =

    lightbarStates[command];


  s.requested =
    desired;


  s.awaitingAck =
    true;


  s.commandConfirmed =
    false;


  s.ackFailed =
    false;


  s.commandSentTime =
    millis();


  retryCount[command] =
    0;


  String line =

    desired

    ?

    "START "

    :

    "STOP ";


  line +=
    COMMAND_NAMES[command];


  sendNanoLine(
    line
  );


  nanoStateChanged =
    true;
}


// ============================================================
// RETRY UNACKNOWLEDGED COMMANDS
// ============================================================

void retryNanoCommands() {

  if (
    !nanoConnected
  ) {

    return;

  }


  unsigned long now =
    millis();


  for (

    uint8_t command = 0;

    command < NUM_COMMANDS;

    command++

  ) {

    LightbarState& s =

      lightbarStates[command];


    if (
      !s.awaitingAck
    ) {

      continue;

    }


    if (

      now - s.commandSentTime

      <

      ACK_TIMEOUT

    ) {

      continue;

    }


    // --------------------------------------------------------
    // RETRIES EXHAUSTED
    // --------------------------------------------------------

    if (

      retryCount[command]

      >=

      MAX_RETRIES

    ) {

      s.awaitingAck =
        false;


      s.commandConfirmed =
        false;


      s.ackFailed =
        true;


      nanoStateChanged =
        true;


      continue;
    }


    // --------------------------------------------------------
    // RETRY
    // --------------------------------------------------------

    retryCount[command]++;


    s.commandSentTime =
      now;


    String line =

      s.requested

      ?

      "START "

      :

      "STOP ";


    line +=
      COMMAND_NAMES[command];


    sendNanoLine(
      line
    );
  }
}


// ============================================================
// UPDATE NANO UART
// ============================================================

void updateNanoCommunication() {

  unsigned long now =
    millis();


  // ----------------------------------------------------------
  // HEARTBEAT
  // ----------------------------------------------------------

  if (

    now - lastNanoPing

    >=

    HEARTBEAT_INTERVAL

  ) {

    lastNanoPing =
      now;


    sendNanoPing();
  }


  // ----------------------------------------------------------
  // RECEIVE
  // ----------------------------------------------------------

  while (
    Serial1.available()
  ) {

    char c =

      (char)Serial1.read();


    if (
      c == '\r'
    ) {

      continue;

    }


    if (
      c == '\n'
    ) {

      nanoRxLine.trim();


      if (
        nanoRxLine.length() > 0
      ) {

        // Log exactly what Nano sent.

        addSerialLog(

          "N>G",

          nanoRxLine

        );


        processNanoLine(
          nanoRxLine
        );
      }


      nanoRxLine =
        "";


      continue;
    }


    if (
      nanoRxLine.length() < 119
    ) {

      nanoRxLine +=
        c;

    }

    else {

      // Protect against malformed runaway message.

      nanoRxLine =
        "";
    }
  }


  // ----------------------------------------------------------
  // CONNECTION TIMEOUT
  // ----------------------------------------------------------

  if (

    nanoConnected &&

    now - lastNanoPong >= NANO_TIMEOUT

  ) {

    nanoConnected =
      false;


    nanoSyncInProgress =
      false;


    nanoConnectionChanged =
      true;


    nanoStateChanged =
      true;


    // IMPORTANT:
    //
    // Do not send STOP commands here.
    //
    // Nano has its own 60-second watchdog for
    // GIGA-generated requests.
  }


  retryNanoCommands();
}


