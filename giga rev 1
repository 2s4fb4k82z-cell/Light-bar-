// ============================================================
// DRAW LIGHTBAR BUTTON
// ============================================================

void drawLightbarButton(

  uint8_t command

) {

  if (
    command >= NUM_COMMANDS
  ) {

    return;

  }


  const TouchButton& b =

    buttons[command];


  const LightbarState& s =

    lightbarStates[command];


  // ==========================================================
  // COLOR RULES
  //
  // PURPLE FLASH = failed Nano ACK
  // BLUE         = physical Nano switch active
  // GREEN        = GIGA request active + confirmed
  // DARK         = inactive
  //
  // Physical BLUE has priority over GREEN.
  // ==========================================================

  uint16_t fill =
    COLOR_DARK;


  if (
    s.ackFailed
  ) {

    fill =

      ackFlashVisible

      ?

      COLOR_PURPLE

      :

      COLOR_DARK;

  }

  else if (
    !nanoConnected
  ) {

    fill =
      COLOR_DARK;

  }

  else if (

    s.physicalRequest &&

    s.effectiveState

  ) {

    fill =
      COLOR_BLUE;

  }

  else if (

    s.gigaRequest &&

    s.effectiveState

  ) {

    fill =
      COLOR_GREEN;
  }


  display.fillRoundRect(

    b.x,

    b.y,

    b.w,

    b.h,

    10,

    fill

  );


  display.drawRoundRect(

    b.x,

    b.y,

    b.w,

    b.h,

    10,

    COLOR_GRAY

  );


  display.setTextColor(
    COLOR_WHITE
  );


  display.setTextSize(
    2
  );


  int16_t textX =
    b.x + 16;


  // TRAFFICBREAKERS is long.

  if (
    command == CMD_TRAFFICBREAKERS
  ) {

    display.setTextSize(
      1
    );
  }


  display.setCursor(

    textX,

    b.y + 27

  );


  display.print(
    COMMAND_NAMES[command]
  );
}


// ============================================================
// DRAW LIGHTBAR SCREEN
// ============================================================

void drawLightbarScreen() {

  display.fillScreen(
    COLOR_BLACK
  );


  display.setTextColor(
    COLOR_WHITE
  );


  display.setTextSize(
    2
  );


  display.setCursor(
    300,
    16
  );


  display.print(
    "LIGHTBAR"
  );


  for (

    uint8_t i = 0;

    i < NUM_COMMANDS;

    i++

  ) {

    drawLightbarButton(
      i
    );
  }
}


// ============================================================
// FIND LIGHTBAR BUTTON
// ============================================================

int commandAt(

  int16_t x,

  int16_t y

) {

  for (

    uint8_t i = 0;

    i < NUM_COMMANDS;

    i++

  ) {

    const TouchButton& b =

      buttons[i];


    if (

      x >= b.x &&

      x < b.x + b.w &&

      y >= b.y &&

      y < b.y + b.h

    ) {

      return i;

    }
  }


  return -1;
}


