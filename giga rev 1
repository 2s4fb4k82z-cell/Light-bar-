// ============================================================
// GAUGE VARIABLES
// ============================================================

float displayedIPR =
  0.0f;


float displayedICP =
  0.0f;


constexpr float DEG_TO_RAD_F =
  0.01745329251994329577f;


// ============================================================
// VALUE TO GAUGE ANGLE
// ============================================================

float valueToAngle(

  float value,

  float minValue,

  float maxValue

) {

  value =

    constrain(

      value,

      minValue,

      maxValue

    );


  return

    135.0f

    +

    (

      (
        value - minValue
      )

      /

      (
        maxValue - minValue
      )

    )

    *

    270.0f;
}


// ============================================================
// DRAW GAUGE
// ============================================================

void drawGauge(

  int cx,

  int cy,

  int radius,

  float value,

  float minValue,

  float maxValue,

  float majorStep,

  const char* title,

  const char* units

) {

  display.drawCircle(

    cx,

    cy,

    radius,

    COLOR_GRAY

  );


  display.drawCircle(

    cx,

    cy,

    radius - 1,

    COLOR_GRAY

  );


  // ----------------------------------------------------------
  // TICKS
  // ----------------------------------------------------------

  for (

    float tick = minValue;

    tick <= maxValue + 0.01f;

    tick += majorStep

  ) {

    float angle =

      valueToAngle(

        tick,

        minValue,

        maxValue

      )

      *

      DEG_TO_RAD_F;


    int x1 =

      cx

      +

      cosf(angle)

      *

      (radius - 10);


    int y1 =

      cy

      +

      sinf(angle)

      *

      (radius - 10);


    int x2 =

      cx

      +

      cosf(angle)

      *

      (radius - 25);


    int y2 =

      cy

      +

      sinf(angle)

      *

      (radius - 25);


    display.drawLine(

      x1,

      y1,

      x2,

      y2,

      COLOR_WHITE

    );


    int tx =

      cx

      +

      cosf(angle)

      *

      (radius - 48);


    int ty =

      cy

      +

      sinf(angle)

      *

      (radius - 48);


    display.setTextColor(
      COLOR_GRAY
    );


    display.setTextSize(
      1
    );


    display.setCursor(

      tx - 10,

      ty - 4

    );


    display.print(
      (int)tick
    );
  }


  // ----------------------------------------------------------
  // TITLE
  // ----------------------------------------------------------

  display.setTextColor(
    COLOR_WHITE
  );


  display.setTextSize(
    3
  );


  display.setCursor(

    cx - 28,

    cy + 65

  );


  display.print(
    title
  );


  // ----------------------------------------------------------
  // UNITS
  // ----------------------------------------------------------

  display.setTextSize(
    1
  );


  display.setCursor(

    cx - 14,

    cy + 95

  );


  display.print(
    units
  );


  // ----------------------------------------------------------
  // NEEDLE
  // ----------------------------------------------------------

  float needleAngle =

    valueToAngle(

      value,

      minValue,

      maxValue

    )

    *

    DEG_TO_RAD_F;


  int nx =

    cx

    +

    cosf(
      needleAngle
    )

    *

    (radius - 45);


  int ny =

    cy

    +

    sinf(
      needleAngle
    )

    *

    (radius - 45);


  display.drawLine(

    cx,

    cy,

    nx,

    ny,

    COLOR_RED

  );


  display.drawLine(

    cx + 1,

    cy,

    nx + 1,

    ny,

    COLOR_RED

  );


  display.fillCircle(

    cx,

    cy,

    8,

    COLOR_WHITE

  );
}


