    true;
}


// ============================================================
// UPDATE SERIAL MONITOR
// ============================================================

void updateSerialMonitorDisplay() {

  if (

    currentScreen

    !=

    SCREEN_SERIAL_MONITOR

  ) {

    return;

  }


  display.fillRect(

    10,

    45,

    780,

    425,

    COLOR_BLACK

  );


  display.setTextSize(
    1
  );


  constexpr uint8_t MAX_VISIBLE_LINES =
    23;


  constexpr int FIRST_Y =
    48;


  constexpr int LINE_HEIGHT =
    18;


  uint8_t visible =

    min<uint8_t>(

      serialLogCount,

      MAX_VISIBLE_LINES

    );


  // Oldest visible first.
  // Newest appears at bottom.

  for (

    uint8_t row = 0;

    row < visible;

    row++

  ) {

    uint8_t offsetFromNewest =

      visible

      -

      1

      -

      row;


    const SerialLogEntry& entry =

      getNewestLog(
        offsetFromNewest
      );


    int y =

      FIRST_Y

      +

      row * LINE_HEIGHT;


    // --------------------------------------------------------
    // TIMESTAMP
    // --------------------------------------------------------

    char timeBuffer[16];


    snprintf(

      timeBuffer,

      sizeof(timeBuffer),

      "%010lu",

      entry.timestamp

    );


    display.setTextColor(
      COLOR_GRAY
    );


    display.setCursor(
      18,
      y
    );


    display.print(
      timeBuffer
    );


    // --------------------------------------------------------
    // DIRECTION
    // --------------------------------------------------------

    if (
      entry.direction == "G>N"
    ) {

      display.setTextColor(
        COLOR_GREEN
      );

    }

    else {

      display.setTextColor(
        COLOR_BLUE
      );
    }


    display.setCursor(
      105,
      y
    );


    display.print(
      entry.direction
    );


    // --------------------------------------------------------
    // MESSAGE
    // --------------------------------------------------------

    display.setTextColor(
      COLOR_WHITE
    );


    display.setCursor(
      150,
      y
    );


    String message =
      entry.message;


    if (
      message.length() > 100
    ) {

      message =

        message.substring(
          0,
          100
        );
    }


    display.print(
      message
    );
  }
}


// ============================================================
// COMMUNICATION LOSS BORDER
// ============================================================

bool commFlashVisible =
  false;


bool lastNanoConnectedDisplay =
  false;


unsigned long lastCommFlash =
  0;


constexpr unsigned long
COMM_FLASH_INTERVAL = 500;


// ============================================================
// DRAW RED BORDER
// ============================================================

void drawCommunicationBorder(

  bool visible

) {

  uint16_t color =

    visible

    ?

    COLOR_RED

    :

    COLOR_BLACK;


  constexpr int thickness =
    6;


  // TOP

  display.fillRect(

    0,

    0,

    800,

    thickness,

    color

  );


  // BOTTOM

  display.fillRect(

    0,

    480 - thickness,

    800,

    thickness,

    color

  );


  // LEFT

  display.fillRect(

    0,

    0,

    thickness,

    480,

    color

  );


  // RIGHT

  display.fillRect(

    800 - thickness,

    0,

    thickness,

    480,

    color

  );
}


// ============================================================
// UPDATE COMMUNICATION WARNING
// ============================================================

void updateCommunicationWarning() {

  unsigned long now =
    millis();


  if (

    nanoConnected

    !=

    lastNanoConnectedDisplay

  ) {

    lastNanoConnectedDisplay =
      nanoConnected;


    lastCommFlash =
      now;


    if (
      nanoConnected
    ) {

      commFlashVisible =
        false;


      drawCommunicationBorder(
        false
      );

    }

    else {

      commFlashVisible =
        true;


      drawCommunicationBorder(
        true
      );
    }
  }


  if (

    !nanoConnected &&

    now - lastCommFlash

    >=

    COMM_FLASH_INTERVAL

  ) {

    lastCommFlash =
      now;


    commFlashVisible =

      !commFlashVisible;


    drawCommunicationBorder(

      commFlashVisible

    );
  }
}


// ============================================================
// UPDATE ACK FLASHING
// ============================================================

void updateAckWarnings() {

  if (

    currentScreen

    !=

    SCREEN_LIGHTBAR

  ) {

    return;

  }


  unsigned long now =
    millis();


  if (

    now - lastAckFlash

    <

    ACK_FLASH_INTERVAL

  ) {

    return;

  }


  lastAckFlash =
    now;


  ackFlashVisible =

    !ackFlashVisible;


  for (

    uint8_t command = 0;

    command < NUM_COMMANDS;

    command++

  ) {

    if (
      lightbarStates[command].ackFailed
    ) {

      drawLightbarButton(
        command
      );
    }
  }
}


// ============================================================
// TOUCH
// ============================================================

Arduino_GigaDisplayTouch touch;


// ============================================================
// TOUCH STATE
// ============================================================

bool touchWasActive =
  false;


bool tapReady =
  false;


int16_t tapX =
  0;


int16_t tapY =
  0;


bool twoFingerTracking =
  false;


bool twoFingerTriggered =
  false;


bool gaugeLightbarCandidate =
  false;


bool serialMonitorCandidate =
  false;


bool gaugeLightbarSwipeReady =
  false;


bool serialMonitorSwipeReady =
  false;


int16_t firstStartX =
  0;


int16_t firstStartY =
  0;


int16_t secondStartX =
  0;


int16_t secondStartY =
  0;


unsigned long lastGestureTime =
  0;


// ============================================================
// GESTURE SETTINGS
// ============================================================

// Left 30%

constexpr int LEFT_ZONE_MAX =
  240;


// Right 30%

constexpr int RIGHT_ZONE_MIN =
  560;


// Top 30%

constexpr int TOP_ZONE_MAX =
  144;


// Bottom 30%

constexpr int BOTTOM_ZONE_MIN =
  336;


// Required swipe distance

constexpr int MIN_GESTURE_DISTANCE =
  100;


// Gesture cooldown

constexpr unsigned long GESTURE_COOLDOWN =
  700;


// ============================================================
// TOUCH COORDINATE MAPPING
// ============================================================

void mapTouchToLandscape(

  int rawX,

  int rawY,

  int16_t& x,

  int16_t& y

) {

  // ==========================================================
  // PROVISIONAL MAPPING
  //
  // This is the main thing we'll verify once the physical
  // GIGA Display Shield is available.
  //
  // If touch is rotated/mirrored, change this function rather
  // than changing all of the UI coordinates.
  // ==========================================================

  x =
    rawY;


  y =

    479

    -

    rawX;
}


// ============================================================
// UPDATE TOUCH
// ============================================================

void updateTouch() {

  GDTpoint_t raw[5];


  uint8_t contacts =

    touch.getTouchPoints(
      raw
    );


  // ==========================================================
  // NO TOUCH
  // ==========================================================

  if (
    contacts == 0
  ) {

    twoFingerTracking =
      false;


    twoFingerTriggered =
      false;


    gaugeLightbarCandidate =
      false;


    serialMonitorCandidate =
      false;


    touchWasActive =
      false;


    return;
  }


  // ==========================================================
  // MAP TOUCHES
  // ==========================================================

  int16_t x[5];

  int16_t y[5];


  uint8_t usableContacts =

    min<uint8_t>(
      contacts,
      5
    );


  for (

    uint8_t i = 0;

    i < usableContacts;

    i++

  ) {

    mapTouchToLandscape(

      raw[i].x,

      raw[i].y,

      x[i],

      y[i]

    );
  }


  // ==========================================================
  // TWO-FINGER GESTURES
  // ==========================================================

  if (
    usableContacts >= 2
  ) {

    touchWasActive =
      true;


    uint8_t leftIndex = 0;

    uint8_t rightIndex = 0;

    uint8_t topIndex = 0;

    uint8_t bottomIndex = 0;


    for (

      uint8_t i = 1;

      i < usableContacts;

      i++

    ) {

      if (
        x[i] < x[leftIndex]
      ) {

        leftIndex = i;

      }


      if (
        x[i] > x[rightIndex]
      ) {

        rightIndex = i;

      }


      if (
        y[i] < y[topIndex]
      ) {

        topIndex = i;

      }


      if (
        y[i] > y[bottomIndex]
      ) {

        bottomIndex = i;

      }
    }


    // ========================================================
    // BEGIN GESTURE
    // ========================================================

    if (
      !twoFingerTracking
    ) {

      if (

        millis() - lastGestureTime

        <

        GESTURE_COOLDOWN

      ) {

        return;

      }


      // ------------------------------------------------------
      // LEFT + RIGHT -> DOWN
      // ------------------------------------------------------

      gaugeLightbarCandidate =

        x[leftIndex]
          <=
        LEFT_ZONE_MAX

        &&

        x[rightIndex]
          >=
        RIGHT_ZONE_MIN;


      // ------------------------------------------------------
      // TOP + BOTTOM -> LEFT
      // ------------------------------------------------------

      serialMonitorCandidate =

        y[topIndex]
          <=
        TOP_ZONE_MAX

        &&

        y[bottomIndex]
          >=
        BOTTOM_ZONE_MIN;


      if (

        !gaugeLightbarCandidate &&

        !serialMonitorCandidate

      ) {

        return;

      }


      twoFingerTracking =
        true;


      twoFingerTriggered =
        false;


      // ------------------------------------------------------
      // SERIAL GESTURE GETS PRIORITY IF BOTH ZONES QUALIFY
      // ------------------------------------------------------

      if (
        serialMonitorCandidate
      ) {

        firstStartX =
          x[topIndex];


        firstStartY =
          y[topIndex];


        secondStartX =
          x[bottomIndex];


        secondStartY =
          y[bottomIndex];

      }

      else {

        firstStartX =
          x[leftIndex];


        firstStartY =
          y[leftIndex];


        secondStartX =
          x[rightIndex];


        secondStartY =
          y[rightIndex];
      }


      return;
    }


    if (
      twoFingerTriggered
    ) {

      return;

    }


    // ========================================================
    // SERIAL MONITOR GESTURE
    //
    // TOP + BOTTOM
    // BOTH SWIPE LEFT
    // ========================================================

    if (
      serialMonitorCandidate
    ) {

      int16_t topMoveLeft =

        firstStartX

        -

        x[topIndex];


      int16_t bottomMoveLeft =

        secondStartX

        -

        x[bottomIndex];


      if (

        topMoveLeft
          >=
        MIN_GESTURE_DISTANCE

        &&

        bottomMoveLeft
          >=
        MIN_GESTURE_DISTANCE

      ) {

        twoFingerTriggered =
          true;


        serialMonitorSwipeReady =
          true;


        lastGestureTime =
          millis();


        return;
      }
    }


    // ========================================================
    // GAUGE <-> LIGHTBAR GESTURE
    //
    // LEFT + RIGHT
    // BOTH SWIPE DOWN
    // ========================================================

    if (
      gaugeLightbarCandidate
    ) {

      int16_t leftMoveDown =

        y[leftIndex]

        -

        firstStartY;


      int16_t rightMoveDown =

        y[rightIndex]

        -

        secondStartY;


      if (

        leftMoveDown
          >=
        MIN_GESTURE_DISTANCE

        &&

        rightMoveDown
          >=
        MIN_GESTURE_DISTANCE

      ) {

        twoFingerTriggered =
          true;


        gaugeLightbarSwipeReady =
          true;


        lastGestureTime =
          millis();
      }
    }


    return;
  }


  // Don't turn second half of a two-finger gesture
  // into an accidental button press.

  if (
    twoFingerTracking
  ) {

    return;

  }


  // ==========================================================
  // SINGLE FINGER TAP
  // ==========================================================

  if (
    !touchWasActive
  ) {

    touchWasActive =
      true;


    tapX =
      x[0];


    tapY =
      y[0];


    tapReady =
      true;
  }
}


// ============================================================
// REDRAW CURRENT SCREEN
// ============================================================

void redrawCurrentScreen() {

  switch (
    currentScreen
  ) {

    case SCREEN_GAUGES:

      drawGaugeScreen();

      updateGaugeDisplay();

      break;


    case SCREEN_LIGHTBAR:

      drawLightbarScreen();

      break;


    case SCREEN_SERIAL_MONITOR:

      drawSerialMonitorScreen();

      updateSerialMonitorDisplay();

      break;
  }
}


// ============================================================
// TIMERS
// ============================================================

unsigned long lastEngineUpdate =
  0;


unsigned long lastGaugeDraw =
  0;


unsigned long lastSerialDraw =
  0;


constexpr unsigned long ENGINE_INTERVAL =
  50;


constexpr unsigned long GAUGE_DRAW_INTERVAL =
  100;


constexpr unsigned long SERIAL_DRAW_INTERVAL =
  100;


// ============================================================
// SETUP
// ============================================================

void setup() {

  // ----------------------------------------------------------
  // USB DEBUG
  // ----------------------------------------------------------

  Serial.begin(
    115200
  );


  delay(
    300
  );


  Serial.println();

  Serial.println(
    "GIGA Controller Single-File Base"
  );


  // ----------------------------------------------------------
  // NANO UART
  // ----------------------------------------------------------

  Serial1.begin(
    38400
  );


  nanoRxLine.reserve(
    120
  );


  // Cause immediate heartbeat.

  lastNanoPing =

    millis()

    -

    HEARTBEAT_INTERVAL;


  // ----------------------------------------------------------
  // DISPLAY
  // ----------------------------------------------------------

  display.begin();


  display.setRotation(
    1
  );


  // ----------------------------------------------------------
  // COLORS
  // ----------------------------------------------------------

  COLOR_BLACK =

    display.color565(
      0,
      0,
      0
    );


  COLOR_WHITE =

    display.color565(
      245,
      245,
      245
    );


  COLOR_DARK =

    display.color565(
      35,
      35,
      40
    );


  COLOR_GRAY =

    display.color565(
      120,
      120,
      125
    );


  COLOR_GREEN =

    display.color565(
      0,
      180,
      55
    );


  COLOR_RED =

    display.color565(
      230,
      0,
      20
    );


  COLOR_BLUE =

    display.color565(
      20,
      95,
      235
    );


  COLOR_PURPLE =

    display.color565(
      170,
      0,
      230
    );


  setupButtons();


  // ----------------------------------------------------------
  // TOUCH
  // ----------------------------------------------------------

  if (
    !touch.begin()
  ) {

    Serial.println(
      "WARNING: GIGA Display touch initialization failed."
    );
  }


  // ----------------------------------------------------------
  // INITIAL ENGINE DATA
  // ----------------------------------------------------------

  updateEngineData();


  // ----------------------------------------------------------
  // START ON GAUGE SCREEN
  // ----------------------------------------------------------

  currentScreen =
    SCREEN_GAUGES;


  previousNormalScreen =
    SCREEN_GAUGES;


  redrawCurrentScreen();
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  unsigned long now =
    millis();


  // ==========================================================
  // NANO COMMUNICATION
  // ==========================================================

  updateNanoCommunication();


  // ==========================================================
  // COMMUNICATION WARNING
  // ==========================================================

  updateCommunicationWarning();


  // ==========================================================
  // PURPLE ACK WARNING
  // ==========================================================

  updateAckWarnings();


  // ==========================================================
  // ENGINE DATA
  // ==========================================================

  if (

    now - lastEngineUpdate

    >=

    ENGINE_INTERVAL

  ) {

    lastEngineUpdate =
      now;


    updateEngineData();
  }


  // ==========================================================
  // TOUCH
  // ==========================================================

  updateTouch();


  // ==========================================================
  // SERIAL MONITOR GESTURE
  //
  // Two fingers:
  //
  // one TOP
  // one BOTTOM
  //
  // both swipe LEFT >= 100 pixels
  //
  // Same gesture exits serial monitor.
  // ==========================================================

  if (
    serialMonitorSwipeReady
  ) {

    serialMonitorSwipeReady =
      false;


    if (

      currentScreen

      ==

      SCREEN_SERIAL_MONITOR

    ) {

      currentScreen =
        previousNormalScreen;

    }

    else {

      previousNormalScreen =
        currentScreen;


      currentScreen =
        SCREEN_SERIAL_MONITOR;
    }


    redrawCurrentScreen();
  }


  // ==========================================================
  // GAUGE <-> LIGHTBAR GESTURE
  //
  // Two fingers:
  //
  // one LEFT
  // one RIGHT
  //
  // both swipe DOWN >= 100 pixels
  //
  // Disabled while serial monitor is displayed.
  // ==========================================================

  if (

    currentScreen
      !=
    SCREEN_SERIAL_MONITOR

    &&

    gaugeLightbarSwipeReady

  ) {

    gaugeLightbarSwipeReady =
      false;


    if (

      currentScreen

      ==

      SCREEN_GAUGES

    ) {

      currentScreen =
        SCREEN_LIGHTBAR;

    }

    else {

      currentScreen =
        SCREEN_GAUGES;
    }


    previousNormalScreen =
      currentScreen;


    redrawCurrentScreen();
  }


  // ==========================================================
  // LIGHTBAR BUTTON TAP
  // ==========================================================

  if (
    tapReady
  ) {

    tapReady =
      false;


    if (

      currentScreen

      ==

      SCREEN_LIGHTBAR

    ) {

      int command =

        commandAt(
          tapX,
          tapY
        );


      if (

        command >= 0

        &&

        nanoConnected

        &&

        !nanoSyncInProgress

      ) {

        bool desired =

          !lightbarStates[
            command
          ].requested;


        requestLightbarCommand(

          (uint8_t)command,

          desired

        );


        drawLightbarButton(
          (uint8_t)command
        );
      }
    }
  }


  // ==========================================================
  // LIGHTBAR STATE CHANGES
  // ==========================================================

  if (

    currentScreen

    ==

    SCREEN_LIGHTBAR

    &&

    (
      nanoStateChanged
      ||
      nanoConnectionChanged
    )

  ) {

    nanoStateChanged =
      false;


    nanoConnectionChanged =
      false;


    drawLightbarScreen();
  }


  // ==========================================================
  // GAUGE REFRESH
  // ==========================================================

  if (

    currentScreen

    ==

    SCREEN_GAUGES

    &&

    now - lastGaugeDraw

    >=

    GAUGE_DRAW_INTERVAL

  ) {

    lastGaugeDraw =
      now;


    updateGaugeDisplay();
  }


  // ==========================================================
  // SERIAL MONITOR REFRESH
  // ==========================================================

  if (

    currentScreen

    ==

    SCREEN_SERIAL_MONITOR

    &&

    now - lastSerialDraw

    >=

    SERIAL_DRAW_INTERVAL

  ) {

    lastSerialDraw =
      now;


    if (
      serialLogChanged
    ) {

      serialLogChanged =
        false;


      updateSerialMonitorDisplay();
    }
  }
}